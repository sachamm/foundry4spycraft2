{
  "name": "spycraft2",
  "private": true,
  "type": "module",
  "description": "Spycraft 2.0 game system for Foundry VTT",
  "scripts": {
    "build": "node tools/build-packs.mjs",
    "test": "npm run validate && node tools/check-engine-fixtures.mjs && node --test \"tools/test-*.mjs\"",
    "test:packs": "node --test tools/check-built-packs.mjs",
    "test:layout": "playwright test --config tools/playwright.config.mjs",
    "validate": "node tools/validate-data.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.mjs\"",
    "format:check": "prettier --check \"**/*.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.58.2",
    "classic-level": "^1.4.1",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
