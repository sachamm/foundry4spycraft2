{
  "name": "spycraft2",
  "private": true,
  "type": "module",
  "description": "Spycraft 2.0 game system for Foundry VTT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build-packs.mjs",
    "bundle": "node tools/bundle.mjs",
    "test": "npm run validate && node tools/check-engine-fixtures.mjs && node --test \"tools/test-*.mjs\"",
    "test:packs": "node --test tools/check-built-packs.mjs tools/check-sample-scenes-pack.mjs tools/check-npc-library-pack.mjs tools/check-sample-agents-pack.mjs tools/check-glass-wake-pack.mjs",
    "test:layout": "playwright test --config tools/playwright.config.mjs",
    "validate": "node tools/validate-data.mjs",
    "lint": "eslint . --max-warnings 28 && npm run lint:css",
    "lint:css": "stylelint \"styles/*.css\" --max-warnings 32",
    "format": "prettier --write \"**/*.{mjs,css}\"",
    "format:check": "prettier --check \"**/*.{mjs,css}\"",
    "check:schemas": "node tools/check-schemas.mjs",
    "strings": "node tools/extract-strings.mjs",
    "check:copy": "node tools/check-copied-text.mjs",
    "release:check": "node tools/check-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "classic-level": "1.4.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "handlebars": "4.7.8",
    "prettier": "3.10.1",
    "stylelint": "16.26.1"
  }
}
