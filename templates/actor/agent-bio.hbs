<section class="tab bio {{tab.cssClass}}" data-tab="bio" data-group="primary">
  <div class="details-grid edit-only">
    <label>{{localize "SPYCRAFT.Template.ActorAgentBio.Affiliation"}} <select name="system.affiliationType"><option value="faction" {{#if (sc2eq system.affiliationType "faction")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ActorAgentBio.Faction"}}</option><option value="freelance" {{#if (sc2eq system.affiliationType "freelance")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ActorAgentBio.Freelance"}}</option></select></label>
    {{#each system.details as |v k|}}{{#unless (sc2eq k "level")}}
      <label>{{k}} <input type="text" name="system.details.{{k}}" value="{{v}}" /></label>
    {{/unless}}{{/each}}
  </div>
  <details class="bio-setup edit-only" data-key="bioSetup"><summary>{{localize "SPYCRAFT.Template.ActorAgentBio.AgeStartingResourcesAndImportTools"}}</summary>
  <p>{{localize "SPYCRAFT.Template.ActorAgentBio.AgeCategory"}} {{system.aging.category}}{{localize "SPYCRAFT.Template.ActorAgentBio.AgeModifiersApplyAutomaticallyToThe"}}</p>
  {{#unless system.resourcesInitialized}}<div><button type="button" data-action="initializeResources">{{localize "SPYCRAFT.Template.ActorAgentBio.ApplyStartingResourcesNewCharacter"}}</button><button type="button" data-action="keepResources">{{localize "SPYCRAFT.Template.ActorAgentBio.KeepCurrentResources"}}</button></div>{{/unless}}
  <p>{{localize "SPYCRAFT.Template.ActorAgentBio.AtTheStartOfPlayFaction"}}</p>
  <p>{{localize "SPYCRAFT.Template.ActorAgentBio.HeightWeightGenderEyesHairBackground"}}</p>
  {{#if editable}}<details><summary>{{localize "SPYCRAFT.Template.ActorAgentBio.ExistingCharacterRules"}}</summary><button type="button" data-action="reviewRules">{{localize "SPYCRAFT.Template.ActorAgentBio.ReviewCatalogUpdates"}}</button><button type="button" data-action="restoreRules">{{localize "SPYCRAFT.Template.ActorAgentBio.ReviewPreviousRefreshRollback"}}</button><p>{{localize "SPYCRAFT.Template.ActorAgentBio.ReviewCreationScoresAgingAndHistorical"}}</p></details>
  {{/if}}
  </details>
  <p class="play-only bio-description">{{#each system.details as |v k|}}{{#if v}}<span><b>{{k}}:</b> {{v}}</span> {{/if}}{{/each}}</p>
  {{#if editable}}
    <prose-mirror name="system.biography" value="{{system.biography}}">{{{enrichedBiography}}}</prose-mirror>
  {{else}}{{{enrichedBiography}}}{{/if}}
</section>
