<section class="tab bio {{tab.cssClass}}" data-tab="bio" data-group="primary">
  <div class="details-grid">
    {{#each system.details as |v k|}}{{#unless (sc2eq k "level")}}
      <label>{{k}} <input type="text" name="system.details.{{k}}" value="{{v}}" /></label>
    {{/unless}}{{/each}}
  </div>
  {{#if editable}}
    <prose-mirror name="system.biography" value="{{system.biography}}">{{{enrichedBiography}}}</prose-mirror>
  {{else}}{{{enrichedBiography}}}{{/if}}
</section>
