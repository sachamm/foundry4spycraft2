<section class="tab classes {{tab.cssClass}}" data-tab="classes" data-group="primary">
  <div class="edit-only">
  <h3>{{localize "SPYCRAFT.Progression"}}
    <span class="controls">
      <a data-action="addLevel"><i class="fa-solid fa-plus"></i> {{localize "SPYCRAFT.Class.AddLevel"}}</a>
      {{#if progression.length}}<a data-action="removeLevel"><i class="fa-solid fa-minus"></i> {{localize "SPYCRAFT.Class.RemoveLevel"}}</a>{{/if}}
    </span>
  </h3>
  <table class="progression">
    <thead><tr><th>{{localize "SPYCRAFT.Level"}}</th><th>{{localize "SPYCRAFT.Class.Label"}}</th><th>{{localize "SPYCRAFT.Class.Level"}}</th><th>{{localize "SPYCRAFT.VitalityRoll"}}</th><th>{{localize "SPYCRAFT.SkillPoints"}}</th></tr></thead>
    <tbody>
    {{#each progression}}
      <tr>
        <td>{{level}}</td><td>{{className}}</td><td>{{classLevel}}</td>
        <td>{{#if first}}<span class="muted">{{vitalityDie}} ({{localize "SPYCRAFT.Max"}})</span>{{else}}<b>{{#if vitality}}{{vitality}}{{else}}—{{/if}}</b> <span class="muted">d{{vitalityDie}}</span>
          {{#if @root.canRecordVitality}}{{#unless vitality}}<a data-action="rollVitality" data-index="{{index}}" data-tooltip="Roll this career level’s vitality once"><i class="fa-solid fa-dice"></i></a>{{/unless}} <a data-action="reviewVitality" data-index="{{index}}" data-tooltip="Record an external raw result or review this recorded value"><i class="fa-solid fa-pen"></i></a>{{/if}}{{/if}}</td>
        <td class="{{#if (sc2lt skillPoints.remaining 0)}}bad{{/if}}">{{skillPoints.spent}} / {{skillPoints.available}} <label title="INT modifier when this level's skill points were earned; later attribute changes do not change these points.">INT <input type="number" name="progression.{{index}}.intelligenceModifier" value="{{skillPoints.intelligenceModifier}}" class="w-2" /></label></td>
      </tr>
    {{else}}
      <tr><td colspan="5" class="muted">{{localize "SPYCRAFT.Class.NoLevels"}}</td></tr>
    {{/each}}
    </tbody>
  </table>
  </div>

  {{#if coreAbilities.length}}
  <h3>{{localize "SPYCRAFT.CoreAbilities"}}</h3>
  <ul class="plain">{{#each coreAbilities}}<li><b>{{name}}</b> <span class="muted">({{className}})</span> — {{description}}</li>{{/each}}</ul>
  {{/if}}

  {{#if professor}}<p><a data-action="shareTemporaryFeats" data-ability="professor">Professor: share Basic Skill feats for this session</a></p>{{/if}}
  {{#if trailblazer}}<p><a data-action="shareTemporaryFeats" data-ability="trailblazer">Trailblazer: share Terrain feats for this session</a></p>{{/if}}
  {{#if isGM}}{{#if usagePeriodReview.needsReview}}<p class="bad"><a data-action="reviewUsagePeriod">Review interrupted {{usagePeriodReview.period}} start</a></p>{{/if}}{{/if}}
  {{#if isGM}}<details class="reference-panel" data-key="gcTools"><summary>GC session and resource tools</summary><p><a data-action="manageGCDice">GC action dice</a> · <a data-action="awardActionDice">Award roleplay action dice</a> · <a data-action="settleMissionXP">Settle mission XP</a> · <a data-action="recoverResourceTransaction">Recover interrupted resource transaction</a> · <a data-action="resetUsagePeriod" data-period="scene">Start scene</a> · <a data-action="resetUsagePeriod" data-period="session">Start session</a> · <a data-action="resetUsagePeriod" data-period="mission">Start mission</a> · <a data-action="resetUsagePeriod" data-period="round">Start round outside combat</a></p></details>{{/if}}
  {{#if brightIdeaLegacy}}<p class="bad">Past combined Bright Idea uses need source allocation. {{#if isGM}}{{#if brightIdeaLegacyMalformed}}<a data-action="reviewLimitedUseCounter" data-resource="brightIdea">Review combined count before allocation</a>{{else}}<a data-action="migrateBrightIdeaUses">Review past uses</a>{{/if}}{{else}}Ask the GC to review on Classes.{{/if}}</p>{{/if}}
  {{#if limitedUses.length}}
  <h3>Limited-use abilities</h3>
  <p>Scene, session and mission uses reset when the GC starts that period. Starting a session also replaces remaining ordinary action dice with the current starting pool. Initialize the GC pool separately for the players present and mission Caliber. Round uses follow the active combat round.</p>

  <ul class="plain">{{#each limitedUses}}<li><b>{{name}}</b>: {{remaining}} / {{limit}} per {{period}}{{#if cost}}; {{cost}} action die{{/if}}{{#if counterReview}} · <span class="bad">Saved use count needs GC review</span> {{#if @root.isGM}}<a data-action="reviewLimitedUseCounter" data-resource="{{id}}">Review saved count</a>{{else}}Ask the GC to review this counter{{/if}}{{/if}}
    {{#if (sc2eq workflow "freeManeuver")}}Use the One Hand on the Wheel checkbox on a Maneuver skill check{{else}}{{#if (sc2eq workflow "wellFundedCash")}}<a data-action="useWellFunded">Receive cash at home</a>{{else}}{{#if (sc2eq workflow "toolShedKit")}}<a data-action="useToolShed">Find a Grade III kit at home</a>{{else}}{{#if (sc2eq workflow "personalStashGear")}}Use the Request / Gear check dialog on Gear{{else}}{{#if (sc2eq workflow "improvisedSearch")}}Use the improvised weapon search on Gear{{else}}{{#if (sc2eq workflow "adrenalineJunkie")}}{{#if @root.isGM}}<a data-action="recordAdrenalineWoundLoss">Record final wound-loss event</a>{{else}}The GC records the actual wound loss{{/if}}{{else}}{{#if (sc2eq workflow "masterPlan")}}<a data-action="activateMasterPlan">Gain scene bonus dice (free action)</a>{{else}}{{#if (sc2eq workflow "mentalLeap")}}<a data-action="activateMentalLeap">Activate temporary attribute bonus</a>{{else}}{{#if (sc2eq workflow "summonAssistants")}}<a data-action="summonClassAssistants" data-resource="{{id}}">Summon non-combat assistants</a>{{else}}{{#if (sc2eq workflow "sessionBasicFeat")}}<a data-action="useEverydayGenius">Gain a temporary Basic Skill feat (full action)</a>{{else}}{{#if (sc2eq workflow "selfAdvancedFeats")}}<a data-action="useKnowItAll">Choose two temporary Advanced Skill feats</a>{{else}}{{#if (sc2eq workflow "selfTerrainFeat")}}<a data-action="useAnyTimeAnyPlace">Gain a temporary Terrain feat</a>{{else}}{{#if (sc2eq workflow "intelTemporaryFeat")}}<a data-action="useIntelTemporaryFeats" data-resource="{{id}}">Choose temporary feats during Intel</a>{{else}}{{#if (sc2eq workflow "noFear")}}<a data-action="activateNoFear">Activate stress resistance</a>{{else}}{{#if (sc2eq workflow "finalDeduction")}}<a data-action="useFinalDeduction">Record full study round</a>{{else}}{{#if (sc2eq workflow "globalSearch")}}<a data-action="useGlobalSearch">Record completed search</a>{{else}}{{#if (sc2eq workflow "littleDetails")}}<a data-action="useLittleDetails">Declare free action</a>{{else}}{{#if (sc2eq workflow "manual")}} · <a data-action="useLimitedAbility" data-resource="{{id}}" data-name="{{name}}">Use</a>{{else}} · {{#if (sc2eq workflow "reroll")}}Use the roll's reroll control{{else}}{{#if (sc2eq workflow "oneInAMillion")}}<a data-action="useOneInAMillion">Declare attack / Fortitude save</a>; skills use their roll dialog{{else}}{{#if (sc2eq workflow "improvisation")}}<a data-action="improviseCommonItem">Improvise a Common Item</a>{{else}}{{#if (sc2eq workflow "masterThief")}}<a data-action="useMasterThief">Replace an opposed skill roll</a>{{else}}{{#if (sc2eq workflow "hintResponse")}}{{#if @root.isGM}}<a data-action="recordHintResponse" data-resource="{{id}}">Record hint response</a>{{else}}The GC records the hint response{{/if}}{{else}}{{#if (sc2eq workflow "requestBenefit")}}<a data-action="rollGearAcquisition" data-resource="{{id}}">Use Request dialog</a>{{else}}{{#if (sc2eq workflow "manualAdjustment")}}Use the failed roll’s Manual Adjustment control{{else}}{{#if (sc2eq workflow "millionDollarSkill")}}Choose in the ranged attack dialog{{else}}{{#if (sc2eq workflow "eagleEye")}}<a data-action="useEagleEye">Spend and roll for scene range</a>{{else}}{{#if (sc2eq workflow "selfTemporaryFeat")}}<a data-action="useRenaissanceMan">Gain a temporary Basic Skill feat</a>{{else}}{{#if (sc2eq workflow "cunningPlan")}}Use a roll dialog or the roll’s Cunning Plan control{{else}}{{#if (sc2eq workflow "fortunesOfWar")}}Use the Fortunes of War control on Main{{else}}{{#if (sc2eq workflow "breakthrough")}}Choose in the Skill or Knowledge dialog{{else}}{{#if (sc2eq workflow "brightIdea")}}Choose in the Skill or Knowledge dialog{{else}}{{#if (sc2eq workflow "tenSecondSolution")}}Choose in the Skill or Knowledge dialog{{else}}Choose before rolling a skill{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}
  </li>{{/each}}</ul>
  {{/if}}
  {{#if system.assistantGroupStatuses.length}}<details><summary>Summoned assistant groups</summary><ul class="plain">{{#each system.assistantGroupStatuses}}<li><b>{{name}}</b>: {{count}} Tier {{tier}} {{template}} in {{city}} — {{state}}.{{#if kitGrade}} Required-kit checks assume one appropriate grade I kit.{{/if}} {{#if active}}<a data-action="withdrawClassAssistants" data-group-id="{{id}}">Record a member’s withdrawal condition</a>{{/if}}</li>{{/each}}</ul></details>{{/if}}
  {{#each classes}}
  <div class="class-block" data-item-id="{{item.id}}">
    <h3><a data-action="itemEdit">{{item.name}}</a> {{levels}}
      <span class="controls"><a data-action="itemChat"><i class="fa-solid fa-comment"></i></a></span></h3>
    <div class="edit-only class-choices">
    {{#each specialistFields}}<div class="choices"><b>Weapon Specialist (Soldier {{level}})</b>
      {{#unless first}}<label>Gain <select name="specialistChoice.{{../item.id}}.{{level}}.mode">{{selectOptions ../specialistModes selected=mode}}</select></label>{{/unless}}
      {{#if needsProficiency}}<label>Possessed weapon proficiency <select name="specialistChoice.{{../item.id}}.{{level}}.proficiency">{{selectOptions ../specialistProficiencies selected=proficiency blank="—"}}</select></label>{{/if}}
      {{#if first}}<p>Choose one proficiency here and one ability below. Every chosen ability applies to all selected proficiencies.</p>{{/if}}
    </div>{{/each}}
    {{#each skillChoiceFields}}<label>{{name}}{{#if ordinal}} #{{ordinal}}{{/if}} (class level {{level}})
      <select name="classSkillChoice.{{../item.id}}.{{key}}">{{selectOptions options selected=value blank="—"}}</select>
      {{#if versatility}}<span class="muted">Choose a cross-class skill. This makes it a class skill only for this class, from this acquisition onward.</span>{{else}}<span class="muted">Error range –2 (minimum 1); taking 10 uses normal time. By Any Means grants an Advocate class skill.</span>{{/if}}
    </label>{{/each}}
    {{#each inheritedChoices}}<div class="choices"><b>{{name}}</b>
      {{#if menu}}<label>Inherited option <select name="inheritedChoice.{{../item.id}}.{{key}}.option">{{selectOptions options selected=option blank="—"}}</select></label>{{/if}}
      {{#if skillChoice}}<label>Inherited skill <select name="inheritedChoice.{{../item.id}}.{{key}}.skill">{{selectOptions skillOptions selected=skill blank="—"}}</select></label>{{/if}}
    </div>{{/each}}
    {{#if isVirtuoso}}<div class="choices">
      <label>Key skill <select name="classField.{{item.id}}.keySkill">{{selectOptions skillOptions selected=item.system.keySkill blank="—"}}</select></label>
      <label>Key focus (if applicable) <input type="text" name="classField.{{item.id}}.keyFocus" value="{{item.system.keyFocus}}" /></label>
      <label>Related Profession focus <input type="text" name="classField.{{item.id}}.professionFocus" value="{{item.system.professionFocus}}" /></label>
      <label>Ph.D. skill (class level 6+) <select name="classField.{{item.id}}.phdSkill">{{selectOptions phdOptions selected=item.system.phdSkill blank="—"}}</select></label>
      <p>Field of Expertise benefits only the selected key focus and related Profession focus. Enter the relevant focus when resolving a check.</p>
    </div>{{/if}}
    {{#each phdFields}}<label>Ph.D. (class level {{level}}) <select name="classField.{{../item.id}}.{{key}}">{{selectOptions ../phdOptions selected=value blank="—"}}</select></label>{{/each}}
    {{#if phdFields.length}}<p>Each chosen skill has a maximum rank of career level +8. Relevant Knowledge checks gain half its ranks as a synergy bonus; apply that bonus only when the topic relates to the skill.</p>{{/if}}
    {{#if choices.length}}
    <div class="choices">
      {{#each choices}}
        <label>{{localize "SPYCRAFT.Level"}} {{level}} — {{list}}
          <select name="choice.{{../item.id}}.{{idx}}">{{selectOptions options selected=value blank="—"}}</select>
          {{#if description}}<span class="muted">{{description}}</span>{{/if}}
        </label>
      {{/each}}
    </div>
    {{/if}}
    </div>
    <ol class="abilities-list">
      {{#each abilities}}<li><b>{{level}}. {{name}}</b> — {{text}}</li>{{/each}}
    </ol>
  </div>
  {{/each}}
</section>
