<section class="tab classes {{tab.cssClass}}" data-tab="classes" data-group="primary">
  <div class="edit-only">
  <h3>{{localize "SPYCRAFT.Progression"}}
    <span class="controls">
      <a data-action="addLevel"><i class="fa-solid fa-plus"></i> {{localize "SPYCRAFT.Class.AddLevel"}}</a>
      {{#if progression.length}}<a data-action="removeLevel"><i class="fa-solid fa-minus"></i> {{localize "SPYCRAFT.Class.RemoveLevel"}}</a>{{/if}}
    </span>
  </h3>
  <table class="progression">
    <thead><tr><th>{{localize "SPYCRAFT.Level"}}</th><th>{{localize "SPYCRAFT.Class.Label"}}</th><th>{{localize "SPYCRAFT.Class.Level"}}</th><th>{{localize "SPYCRAFT.VitalityRoll"}}</th><th>{{localize "SPYCRAFT.SkillPoints"}}</th></tr></thead>
    <tbody>
    {{#each progression}}
      <tr>
        <td>{{level}}</td><td>{{className}}</td><td>{{classLevel}}</td>
        <td>{{#if first}}<span class="muted">{{vitalityDie}} ({{localize "SPYCRAFT.Max"}})</span>{{else}}<b>{{#if vitality}}{{vitality}}{{else}}—{{/if}}</b> <span class="muted">d{{vitalityDie}}</span>
          {{#if @root.canRecordVitality}}{{#unless vitality}}<a data-action="rollVitality" data-index="{{index}}" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentClasses.RollThisCareerLevelSVitality'}}"><i class="fa-solid fa-dice"></i></a>{{/unless}} <a data-action="reviewVitality" data-index="{{index}}" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentClasses.RecordAnExternalRawResultOr'}}"><i class="fa-solid fa-pen"></i></a>{{/if}}{{/if}}</td>
        <td class="{{#if (sc2lt skillPoints.remaining 0)}}bad{{/if}}">{{skillPoints.spent}} / {{skillPoints.available}} <label title="{{localize 'SPYCRAFT.Template.ActorAgentClasses.INTModifierWhenThisLevelS'}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.INT"}} <input type="number" name="progression.{{index}}.intelligenceModifier" value="{{skillPoints.intelligenceModifier}}" class="w-2" /></label></td>
      </tr>
    {{else}}
      <tr><td colspan="5" class="muted">{{localize "SPYCRAFT.Class.NoLevels"}}</td></tr>
    {{/each}}
    </tbody>
  </table>
  </div>

  {{#if coreAbilities.length}}
  <h3>{{localize "SPYCRAFT.CoreAbilities"}}</h3>
  <ul class="plain">{{#each coreAbilities}}<li><b>{{name}}</b> <span class="muted">({{className}})</span> — {{description}}</li>{{/each}}</ul>
  {{/if}}

  {{#if professor}}<p><a data-action="shareTemporaryFeats" data-ability="professor">{{localize "SPYCRAFT.Template.ActorAgentClasses.ProfessorShareBasicSkillFeatsFor"}}</a></p>{{/if}}
  {{#if trailblazer}}<p><a data-action="shareTemporaryFeats" data-ability="trailblazer">{{localize "SPYCRAFT.Template.ActorAgentClasses.TrailblazerShareTerrainFeatsForThis"}}</a></p>{{/if}}
  {{#if isGM}}{{#if usagePeriodReview.needsReview}}<p class="bad"><a data-action="reviewUsagePeriod">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReviewInterrupted"}} {{usagePeriodReview.period}} {{localize "SPYCRAFT.Template.ActorAgentClasses.Start"}}</a></p>{{/if}}{{/if}}
  {{#if isGM}}<details class="reference-panel" data-key="gcTools"><summary>{{localize "SPYCRAFT.Template.ActorAgentClasses.GCSessionAndResourceTools"}}</summary><p><a data-action="manageGCDice">{{localize "SPYCRAFT.Template.ActorAgentClasses.GCActionDice"}}</a> · <a data-action="awardActionDice">{{localize "SPYCRAFT.Template.ActorAgentClasses.AwardRoleplayActionDice"}}</a> · <a data-action="settleMissionXP">{{localize "SPYCRAFT.Template.ActorAgentClasses.SettleMissionXP"}}</a> · <a data-action="recoverResourceTransaction">{{localize "SPYCRAFT.Template.ActorAgentClasses.RecoverInterruptedResourceTransaction"}}</a> · <a data-action="resetUsagePeriod" data-period="scene">{{localize "SPYCRAFT.Template.ActorAgentClasses.StartScene"}}</a> · <a data-action="resetUsagePeriod" data-period="session">{{localize "SPYCRAFT.Template.ActorAgentClasses.StartSession"}}</a> · <a data-action="resetUsagePeriod" data-period="mission">{{localize "SPYCRAFT.Template.ActorAgentClasses.StartMission"}}</a> · <a data-action="resetUsagePeriod" data-period="round">{{localize "SPYCRAFT.Template.ActorAgentClasses.StartRoundOutsideCombat"}}</a></p></details>{{/if}}
  {{#if brightIdeaLegacy}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentClasses.PastCombinedBrightIdeaUsesNeed"}} {{#if isGM}}{{#if brightIdeaLegacyMalformed}}<a data-action="reviewLimitedUseCounter" data-resource="brightIdea">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReviewCombinedCountBeforeAllocation"}}</a>{{else}}<a data-action="migrateBrightIdeaUses">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReviewPastUses"}}</a>{{/if}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentClasses.AskTheGCToReviewOn"}}{{/if}}</p>{{/if}}
  {{#if limitedUses.length}}
  <h3>{{localize "SPYCRAFT.Template.ActorAgentClasses.LimitedUseAbilities"}}</h3>
  <p>{{localize "SPYCRAFT.Template.ActorAgentClasses.SceneSessionAndMissionUsesReset"}}</p>

  <ul class="plain">{{#each limitedUses}}<li><b>{{name}}</b>: {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentClasses.Per"}} {{period}}{{#if cost}}; {{cost}} {{localize "SPYCRAFT.Template.ActorAgentClasses.ActionDie"}}{{/if}}{{#if counterReview}} · <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentClasses.SavedUseCountNeedsGCReview"}}</span> {{#if @root.isGM}}<a data-action="reviewLimitedUseCounter" data-resource="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReviewSavedCount"}}</a>{{else}}{{localize "SPYCRAFT.Template.ActorAgentClasses.AskTheGCToReviewThis"}}{{/if}}{{/if}}
    {{#if (sc2eq workflow "freeManeuver")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.UseTheOneHandOnThe"}}{{else}}{{#if (sc2eq workflow "wellFundedCash")}}<a data-action="useWellFunded">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReceiveCashAtHome"}}</a>{{else}}{{#if (sc2eq workflow "toolShedKit")}}<a data-action="useToolShed">{{localize "SPYCRAFT.Template.ActorAgentClasses.FindAGradeIIIKitAt"}}</a>{{else}}{{#if (sc2eq workflow "personalStashGear")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.UseTheRequestGearCheckDialog"}}{{else}}{{#if (sc2eq workflow "improvisedSearch")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.UseTheImprovisedWeaponSearchOn"}}{{else}}{{#if (sc2eq workflow "adrenalineJunkie")}}{{#if @root.isGM}}<a data-action="recordAdrenalineWoundLoss">{{localize "SPYCRAFT.Template.ActorAgentClasses.RecordFinalWoundLossEvent"}}</a>{{else}}{{localize "SPYCRAFT.Template.ActorAgentClasses.TheGCRecordsTheActualWound"}}{{/if}}{{else}}{{#if (sc2eq workflow "masterPlan")}}<a data-action="activateMasterPlan">{{localize "SPYCRAFT.Template.ActorAgentClasses.GainSceneBonusDiceFreeAction"}}</a>{{else}}{{#if (sc2eq workflow "mentalLeap")}}<a data-action="activateMentalLeap">{{localize "SPYCRAFT.Template.ActorAgentClasses.ActivateTemporaryAttributeBonus"}}</a>{{else}}{{#if (sc2eq workflow "summonAssistants")}}<a data-action="summonClassAssistants" data-resource="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.SummonNonCombatAssistants"}}</a>{{else}}{{#if (sc2eq workflow "sessionBasicFeat")}}<a data-action="useEverydayGenius">{{localize "SPYCRAFT.Template.ActorAgentClasses.GainATemporaryBasicSkillFeat"}}</a>{{else}}{{#if (sc2eq workflow "selfAdvancedFeats")}}<a data-action="useKnowItAll">{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseTwoTemporaryAdvancedSkillFeats"}}</a>{{else}}{{#if (sc2eq workflow "selfTerrainFeat")}}<a data-action="useAnyTimeAnyPlace">{{localize "SPYCRAFT.Template.ActorAgentClasses.GainATemporaryTerrainFeat"}}</a>{{else}}{{#if (sc2eq workflow "intelTemporaryFeat")}}<a data-action="useIntelTemporaryFeats" data-resource="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseTemporaryFeatsDuringIntel"}}</a>{{else}}{{#if (sc2eq workflow "noFear")}}<a data-action="activateNoFear">{{localize "SPYCRAFT.Template.ActorAgentClasses.ActivateStressResistance"}}</a>{{else}}{{#if (sc2eq workflow "finalDeduction")}}<a data-action="useFinalDeduction">{{localize "SPYCRAFT.Template.ActorAgentClasses.RecordFullStudyRound"}}</a>{{else}}{{#if (sc2eq workflow "globalSearch")}}<a data-action="useGlobalSearch">{{localize "SPYCRAFT.Template.ActorAgentClasses.RecordCompletedSearch"}}</a>{{else}}{{#if (sc2eq workflow "littleDetails")}}<a data-action="useLittleDetails">{{localize "SPYCRAFT.Template.ActorAgentClasses.DeclareFreeAction"}}</a>{{else}}{{#if (sc2eq workflow "manual")}} · <a data-action="useLimitedAbility" data-resource="{{id}}" data-name="{{name}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.Use"}}</a>{{else}} · {{#if (sc2eq workflow "reroll")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.UseTheRollSRerollControl"}}{{else}}{{#if (sc2eq workflow "oneInAMillion")}}<a data-action="useOneInAMillion">{{localize "SPYCRAFT.Template.ActorAgentClasses.DeclareAttackFortitudeSave"}}</a>{{localize "SPYCRAFT.Template.ActorAgentClasses.SkillsUseTheirRollDialog"}}{{else}}{{#if (sc2eq workflow "improvisation")}}<a data-action="improviseCommonItem">{{localize "SPYCRAFT.Template.ActorAgentClasses.ImproviseACommonItem"}}</a>{{else}}{{#if (sc2eq workflow "masterThief")}}<a data-action="useMasterThief">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReplaceAnOpposedSkillRoll"}}</a>{{else}}{{#if (sc2eq workflow "hintResponse")}}{{#if @root.isGM}}<a data-action="recordHintResponse" data-resource="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.RecordHintResponse"}}</a>{{else}}{{localize "SPYCRAFT.Template.ActorAgentClasses.TheGCRecordsTheHintResponse"}}{{/if}}{{else}}{{#if (sc2eq workflow "requestBenefit")}}<a data-action="rollGearAcquisition" data-resource="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.UseRequestDialog"}}</a>{{else}}{{#if (sc2eq workflow "manualAdjustment")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.UseTheFailedRollSManual"}}{{else}}{{#if (sc2eq workflow "millionDollarSkill")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseInTheRangedAttackDialog"}}{{else}}{{#if (sc2eq workflow "eagleEye")}}<a data-action="useEagleEye">{{localize "SPYCRAFT.Template.ActorAgentClasses.SpendAndRollForSceneRange"}}</a>{{else}}{{#if (sc2eq workflow "selfTemporaryFeat")}}<a data-action="useRenaissanceMan">{{localize "SPYCRAFT.Template.ActorAgentClasses.GainATemporaryBasicSkillFeat2"}}</a>{{else}}{{#if (sc2eq workflow "cunningPlan")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.UseARollDialogOrThe"}}{{else}}{{#if (sc2eq workflow "fortunesOfWar")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.UseTheFortunesOfWarControl"}}{{else}}{{#if (sc2eq workflow "breakthrough")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseInTheSkillOrKnowledge"}}{{else}}{{#if (sc2eq workflow "brightIdea")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseInTheSkillOrKnowledge"}}{{else}}{{#if (sc2eq workflow "tenSecondSolution")}}{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseInTheSkillOrKnowledge"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseBeforeRollingASkill"}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}
  </li>{{/each}}</ul>
  {{/if}}
  {{#if system.assistantGroupStatuses.length}}<details><summary>{{localize "SPYCRAFT.Template.ActorAgentClasses.SummonedAssistantGroups"}}</summary><ul class="plain">{{#each system.assistantGroupStatuses}}<li><b>{{name}}</b>: {{count}} {{localize "SPYCRAFT.Template.ActorAgentClasses.Tier"}} {{tier}} {{template}} {{localize "SPYCRAFT.Template.ActorAgentClasses.In"}} {{city}} — {{state}}.{{#if kitGrade}} {{localize "SPYCRAFT.Template.ActorAgentClasses.RequiredKitChecksAssumeOneAppropriate"}}{{/if}} {{#if active}}<a data-action="withdrawClassAssistants" data-group-id="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.RecordAMemberSWithdrawalCondition"}}</a>{{/if}}</li>{{/each}}</ul></details>{{/if}}
  {{#each classes}}
  <div class="class-block" data-item-id="{{item.id}}">
    <h3><a data-action="itemEdit">{{item.name}}</a> {{levels}}
      <span class="controls"><a data-action="itemChat"><i class="fa-solid fa-comment"></i></a></span></h3>
    <div class="edit-only class-choices">
    {{#each specialistFields}}<div class="choices"><b>{{localize "SPYCRAFT.Template.ActorAgentClasses.WeaponSpecialistSoldier"}} {{level}})</b>
      {{#unless first}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.Gain"}} <select name="specialistChoice.{{../item.id}}.{{level}}.mode">{{selectOptions ../specialistModes selected=mode}}</select></label>{{/unless}}
      {{#if needsProficiency}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.PossessedWeaponProficiency"}} <select name="specialistChoice.{{../item.id}}.{{level}}.proficiency">{{selectOptions ../specialistProficiencies selected=proficiency blank="—"}}</select></label>{{/if}}
      {{#if first}}<p>{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseOneProficiencyHereAndOne"}}</p>{{/if}}
    </div>{{/each}}
    {{#each skillChoiceFields}}<label>{{name}}{{#if ordinal}} #{{ordinal}}{{/if}} {{localize "SPYCRAFT.Template.ActorAgentClasses.ClassLevel"}} {{level}})
      <select name="classSkillChoice.{{../item.id}}.{{key}}">{{selectOptions options selected=value blank="—"}}</select>
      {{#if versatility}}<span class="muted">{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseACrossClassSkillThis"}}</span>{{else}}<span class="muted">{{localize "SPYCRAFT.Template.ActorAgentClasses.ErrorRange2Minimum1Taking"}}</span>{{/if}}
    </label>{{/each}}
    {{#each inheritedChoices}}<div class="choices"><b>{{name}}</b>
      {{#if menu}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.InheritedOption"}} <select name="inheritedChoice.{{../item.id}}.{{key}}.option">{{selectOptions options selected=option blank="—"}}</select></label>{{/if}}
      {{#if skillChoice}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.InheritedSkill"}} <select name="inheritedChoice.{{../item.id}}.{{key}}.skill">{{selectOptions skillOptions selected=skill blank="—"}}</select></label>{{/if}}
    </div>{{/each}}
    {{#if isVirtuoso}}<div class="choices">
      <label>{{localize "SPYCRAFT.Template.ActorAgentClasses.KeySkill"}} <select name="classField.{{item.id}}.keySkill">{{selectOptions skillOptions selected=item.system.keySkill blank="—"}}</select></label>
      <label>{{localize "SPYCRAFT.Template.ActorAgentClasses.KeyFocusIfApplicable"}} <input type="text" name="classField.{{item.id}}.keyFocus" value="{{item.system.keyFocus}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ActorAgentClasses.RelatedProfessionFocus"}} <input type="text" name="classField.{{item.id}}.professionFocus" value="{{item.system.professionFocus}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ActorAgentClasses.PhDSkillClassLevel6"}} <select name="classField.{{item.id}}.phdSkill">{{selectOptions phdOptions selected=item.system.phdSkill blank="—"}}</select></label>
      <p>{{localize "SPYCRAFT.Template.ActorAgentClasses.FieldOfExpertiseBenefitsOnlyThe"}}</p>
    </div>{{/if}}
    {{#each phdFields}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.PhDClassLevel"}} {{level}}) <select name="classField.{{../item.id}}.{{key}}">{{selectOptions ../phdOptions selected=value blank="—"}}</select></label>{{/each}}
    {{#if phdFields.length}}<p>{{localize "SPYCRAFT.Template.ActorAgentClasses.EachChosenSkillHasAMaximum"}}</p>{{/if}}
    {{#if choices.length}}
    <div class="choices">
      {{#each choices}}
        <label>{{localize "SPYCRAFT.Level"}} {{level}} — {{list}}
          <select name="choice.{{../item.id}}.{{idx}}">{{selectOptions options selected=value blank="—"}}</select>
          {{#if description}}<span class="muted">{{description}}</span>{{/if}}
        </label>
      {{/each}}
    </div>
    {{/if}}
    </div>
    <ol class="abilities-list">
      {{#each abilities}}<li><b>{{level}}. {{name}}</b> — {{text}}</li>{{/each}}
    </ol>
  </div>
  {{/each}}
</section>
