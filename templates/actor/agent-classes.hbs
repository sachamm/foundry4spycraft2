<div class="pane classes" data-pane="classes">
  <div class="edit-only">
  <h3>{{localize "SPYCRAFT.Progression"}}
    {{#if isGM}}
      <button type="button" class="sc2-action" data-action="reviewAdvancement">{{localize "SPYCRAFT.Review.Advancement"}}</button>
      {{#if hasExpertClasses}}
        <button type="button" class="sc2-action" data-action="reviewExpertEntry">{{localize "SPYCRAFT.Review.ExpertEntry"}}</button>
      {{/if}}
    {{/if}}
    <span class="controls">
      <button type="button" class="sc2-action" data-action="addLevel"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "SPYCRAFT.Class.AddLevel"}}</button>
      {{#if progression.length}}<button type="button" class="sc2-action" data-action="removeLevel"><i class="fa-solid fa-minus" aria-hidden="true"></i> {{localize "SPYCRAFT.Class.RemoveLevel"}}</button>{{/if}}
    </span>
  </h3>
  {{#if system.campaignEffects.featPurchase}}{{#unless system.companionOf.ownerUuid}}<p><button type="button" class="sc2-action" data-action="purchaseFeatChoice">{{localize "SPYCRAFT.Template.ActorAgentClasses.PurchaseFeatChoice"}}</button></p>{{/unless}}{{/if}}
  <table class="progression">
    <thead><tr><th>{{localize "SPYCRAFT.Level"}}</th><th>{{localize "SPYCRAFT.Class.Label"}}</th><th>{{localize "SPYCRAFT.Class.Level"}}</th><th>{{localize "SPYCRAFT.VitalityRoll"}}</th><th>{{localize "SPYCRAFT.SkillPoints"}}</th></tr></thead>
    <tbody>
    {{#each progression}}
      <tr>
        <td>{{level}}</td><td>{{className}}</td><td>{{classLevel}}</td>
        <td>{{#if first}}<span class="muted">{{vitalityDie}} ({{localize "SPYCRAFT.Max"}})</span>{{else}}<b>{{#if vitality}}{{vitality}}{{else}}—{{/if}}</b> <span class="muted">d{{vitalityDie}}</span>
          {{#if fixedVitality}}<span class="muted">{{fixedVitalityLabel}}</span>{{/if}}{{#unless fixedVitality}}{{#if @root.canRecordVitality}}{{#unless vitality}}{{#unless needsVitalityReview}}<button type="button" class="sc2-action" data-action="rollVitality" data-index="{{index}}" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentClasses.RollThisCareerLevelSVitality'}}" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentClasses.RollThisCareerLevelSVitality'}}"><i class="fa-solid fa-dice" aria-hidden="true"></i></button>{{/unless}}{{/unless}} <button type="button" class="sc2-action" data-action="reviewVitality" data-index="{{index}}" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentClasses.RecordAnExternalRawResultOr'}}" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentClasses.RecordAnExternalRawResultOr'}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{/if}}{{/unless}}{{/if}}</td>
        <td class="{{#if (sc2lt skillPoints.remaining 0)}}bad{{/if}}">{{skillPoints.spent}} / {{skillPoints.available}} <label data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentClasses.INTModifierWhenThisLevelS'}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.INT"}} <input type="number" name="progression.{{index}}.intelligenceModifier" value="{{skillPoints.intelligenceModifier}}" class="w-2" /></label></td>
      </tr>
    {{else}}
      <tr><td colspan="5" class="muted">{{localize "SPYCRAFT.Class.NoLevels"}}</td></tr>
    {{/each}}
    </tbody>
  </table>
  </div>

  {{#if coreAbilities.length}}
  <h3>{{localize "SPYCRAFT.CoreAbilities"}}</h3>
  <ul class="plain">{{#each coreAbilities}}<li><b>{{name}}</b> <span class="muted">({{className}})</span> — {{description}}</li>{{/each}}</ul>
  {{/if}}

  {{#if professor}}<p><button type="button" class="sc2-action" data-action="shareTemporaryFeats" data-ability="professor">{{localize "SPYCRAFT.Template.ActorAgentClasses.ProfessorShareBasicSkillFeatsFor"}}</button></p>{{/if}}
  {{#if trailblazer}}<p><button type="button" class="sc2-action" data-action="shareTemporaryFeats" data-ability="trailblazer">{{localize "SPYCRAFT.Template.ActorAgentClasses.TrailblazerShareTerrainFeatsForThis"}}</button></p>{{/if}}
  {{#if isGM}}{{#if usagePeriodReview.needsReview}}<p class="bad"><button type="button" class="sc2-action" data-action="reviewUsagePeriod">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReviewInterrupted"}} {{usagePeriodReview.period}} {{localize "SPYCRAFT.Template.ActorAgentClasses.Start"}}</button></p>{{/if}}{{/if}}
  {{#if isGM}}<details class="reference-panel" data-key="gcTools"><summary>{{localize "SPYCRAFT.Template.ActorAgentClasses.GCSessionAndResourceTools"}}</summary><p><button type="button" class="sc2-action" data-action="manageGCDice">{{localize "SPYCRAFT.Template.ActorAgentClasses.GCActionDice"}}</button> <button type="button" class="sc2-action" data-action="awardActionDice">{{localize "SPYCRAFT.Template.ActorAgentClasses.AwardRoleplayActionDice"}}</button> <button type="button" class="sc2-action" data-action="settleMissionXP">{{localize "SPYCRAFT.Template.ActorAgentClasses.SettleMissionXP"}}</button> <button type="button" class="sc2-action" data-action="recoverResourceTransaction">{{localize "SPYCRAFT.Template.ActorAgentClasses.RecoverInterruptedResourceTransaction"}}</button> <button type="button" class="sc2-action" data-action="resetUsagePeriod" data-period="scene">{{localize "SPYCRAFT.Template.ActorAgentClasses.StartScene"}}</button> <button type="button" class="sc2-action" data-action="resetUsagePeriod" data-period="session">{{localize "SPYCRAFT.Template.ActorAgentClasses.StartSession"}}</button> <button type="button" class="sc2-action" data-action="resetUsagePeriod" data-period="mission">{{localize "SPYCRAFT.Template.ActorAgentClasses.StartMission"}}</button> <button type="button" class="sc2-action" data-action="resetUsagePeriod" data-period="round">{{localize "SPYCRAFT.Template.ActorAgentClasses.StartRoundOutsideCombat"}}</button></p></details>{{/if}}
  {{#if brightIdeaLegacy}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentClasses.PastCombinedBrightIdeaUsesNeed"}} {{#if isGM}}{{#if brightIdeaLegacyMalformed}}<button type="button" class="sc2-action" data-action="reviewLimitedUseCounter" data-resource="brightIdea">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReviewCombinedCountBeforeAllocation"}}</button>{{else}}<button type="button" class="sc2-action" data-action="migrateBrightIdeaUses">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReviewPastUses"}}</button>{{/if}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentClasses.AskTheGCToReviewOn"}}{{/if}}</p>{{/if}}
  {{#if limitedUses.length}}
  <h3>{{localize "SPYCRAFT.Template.ActorAgentClasses.LimitedUseAbilities"}}</h3>
  <p>{{localize "SPYCRAFT.Template.ActorAgentClasses.SceneSessionAndMissionUsesReset"}}</p>

  <ul class="plain">{{#each limitedUses}}<li><b>{{name}}</b>: {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentClasses.Per"}} {{period}}{{#if cost}}; {{cost}} {{localize "SPYCRAFT.Template.ActorAgentClasses.ActionDie"}}{{/if}}{{#if counterReview}} · <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentClasses.SavedUseCountNeedsGCReview"}}</span> {{#if @root.isGM}}<button type="button" class="sc2-action" data-action="reviewLimitedUseCounter" data-resource="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.ReviewSavedCount"}}</button>{{else}}{{localize "SPYCRAFT.Template.ActorAgentClasses.AskTheGCToReviewThis"}}{{/if}}{{/if}}
    {{#with control}}{{#if separator}} · {{/if}}{{#if gcOnly}}{{#if @root.isGM}}<button type="button" class="sc2-action" data-action="{{action}}"{{#if resource}} data-resource="{{../id}}"{{/if}}{{#if named}} data-name="{{../name}}"{{/if}}>{{localize label}}</button>{{else}}{{localize playerText}}{{/if}}{{else}}{{#if action}}{{#if spaced}} {{/if}}<button type="button" class="sc2-action" data-action="{{action}}"{{#if resource}} data-resource="{{../id}}"{{/if}}{{#if named}} data-name="{{../name}}"{{/if}}>{{localize label}}</button>{{/if}}{{#if text}}{{localize text}}{{/if}}{{/if}}{{/with}}
  </li>{{/each}}</ul>
  {{/if}}
  {{#if system.assistantGroupStatuses.length}}<details><summary>{{localize "SPYCRAFT.Template.ActorAgentClasses.SummonedAssistantGroups"}}</summary><ul class="plain">{{#each system.assistantGroupStatuses}}<li><b>{{name}}</b>: {{count}} {{localize "SPYCRAFT.Template.ActorAgentClasses.Tier"}} {{tier}} {{template}} {{localize "SPYCRAFT.Template.ActorAgentClasses.In"}} {{city}} — {{state}}.{{#if kitGrade}} {{localize "SPYCRAFT.Template.ActorAgentClasses.RequiredKitChecksAssumeOneAppropriate"}}{{/if}} {{#if active}}<button type="button" class="sc2-action" data-action="withdrawClassAssistants" data-group-id="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentClasses.RecordAMemberSWithdrawalCondition"}}</button>{{/if}}</li>{{/each}}</ul></details>{{/if}}
  {{#each classes}}
  <div class="class-block" data-item-id="{{item.id}}">
    {{#if qualificationNote}}<p class="bad">{{qualificationNote}}</p>{{/if}}
    <h3><button type="button" class="sc2-action" data-action="itemEdit">{{item.name}}</button> {{levels}}
      {{#if @root.editable}}<button type="button" class="edit-only" data-action="addLevelInClass" data-sc2-display="text">{{localize "SPYCRAFT.Template.ActorAgentClasses.AddLevelInClass"}}</button>{{/if}}
      <span class="controls" data-sc2-display="icon"><button type="button" class="sc2-action" data-action="itemChat" aria-label="{{localize 'SPYCRAFT.Action.ShareNamed' name=item.name}}" data-tooltip="{{localize 'SPYCRAFT.Action.ShareNamed' name=item.name}}"><i class="fa-solid fa-comment" aria-hidden="true"></i><span>{{localize "SPYCRAFT.Action.Share"}}</span></button></span></h3>
    <div class="edit-only class-choices">
    {{#each specialistFields}}<div class="choices"><b>{{localize "SPYCRAFT.Template.ActorAgentClasses.WeaponSpecialistSoldier"}} {{level}})</b>
      {{#unless first}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.Gain"}} <select name="specialistChoice.{{../item.id}}.{{level}}.mode">{{selectOptions ../specialistModes selected=mode}}</select></label>{{/unless}}
      {{#if needsProficiency}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.PossessedWeaponProficiency"}} <select name="specialistChoice.{{../item.id}}.{{level}}.proficiency">{{selectOptions ../specialistProficiencies selected=proficiency blank="—"}}</select></label>{{/if}}
      {{#if first}}<p>{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseOneProficiencyHereAndOne"}}</p>{{/if}}
    </div>{{/each}}
    {{#each skillChoiceFields}}<label>{{name}}{{#if ordinal}} #{{ordinal}}{{/if}} {{localize "SPYCRAFT.Template.ActorAgentClasses.ClassLevel"}} {{level}})
      <select name="classSkillChoice.{{../item.id}}.{{key}}">{{selectOptions options selected=value blank="—"}}</select>
      {{#if versatility}}<span class="muted">{{localize "SPYCRAFT.Template.ActorAgentClasses.ChooseACrossClassSkillThis"}}</span>{{else}}<span class="muted">{{localize "SPYCRAFT.Template.ActorAgentClasses.ErrorRange2Minimum1Taking"}}</span>{{/if}}
    </label>{{/each}}
    {{#each inheritedChoices}}<div class="choices"><b>{{name}}</b>
      {{#if menu}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.InheritedOption"}} <select name="inheritedChoice.{{../item.id}}.{{key}}.option">{{selectOptions options selected=option blank="—"}}</select></label>{{/if}}
      {{#if skillChoice}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.InheritedSkill"}} <select name="inheritedChoice.{{../item.id}}.{{key}}.skill">{{selectOptions skillOptions selected=skill blank="—"}}</select></label>{{/if}}
    </div>{{/each}}
    {{#if isVirtuoso}}<div class="choices">
      <label>{{localize "SPYCRAFT.Template.ActorAgentClasses.KeySkill"}} <select name="classField.{{item.id}}.keySkill">{{selectOptions skillOptions selected=item.system.keySkill blank="—"}}</select></label>
      <label>{{localize "SPYCRAFT.Template.ActorAgentClasses.KeyFocusIfApplicable"}} <input type="text" name="classField.{{item.id}}.keyFocus" value="{{item.system.keyFocus}}"
        placeholder="{{localize 'SPYCRAFT.BioExample.keyFocus'}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ActorAgentClasses.RelatedProfessionFocus"}} <input type="text" name="classField.{{item.id}}.professionFocus"
        value="{{item.system.professionFocus}}" placeholder="{{localize 'SPYCRAFT.BioExample.professionFocus'}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ActorAgentClasses.PhDSkillClassLevel6"}} <select name="classField.{{item.id}}.phdSkill">{{selectOptions phdOptions selected=item.system.phdSkill blank="—"}}</select></label>
      <p>{{localize "SPYCRAFT.Template.ActorAgentClasses.FieldOfExpertiseBenefitsOnlyThe"}}</p>
    </div>{{/if}}
    {{#each phdFields}}<label>{{localize "SPYCRAFT.Template.ActorAgentClasses.PhDClassLevel"}} {{level}}) <select name="classField.{{../item.id}}.{{key}}">{{selectOptions ../phdOptions selected=value blank="—"}}</select></label>{{/each}}
    {{#if phdFields.length}}<p>{{localize "SPYCRAFT.Template.ActorAgentClasses.EachChosenSkillHasAMaximum"}}</p>{{/if}}
    {{#if choices.length}}
    <div class="choices">
      {{#each choices}}
        <label>{{localize "SPYCRAFT.Level"}} {{level}} — {{list}}
          <select name="choice.{{../item.id}}.{{idx}}">{{selectOptions options selected=value blank="—"}}</select>
          {{#if description}}<span class="muted">{{description}}</span>{{/if}}
        </label>
      {{/each}}
    </div>
    {{/if}}
    </div>
    <ol class="abilities-list">
      {{#each abilities}}<li><b>{{level}}. {{name}}</b> — {{text}}</li>{{/each}}
    </ol>
  </div>
  {{/each}}
</div>
