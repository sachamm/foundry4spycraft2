<div class="pane feats" data-pane="feats">
  <div class="edit-only">
  <h3>{{localize "SPYCRAFT.Feat.Slots"}}
    <span class="controls">
      <button type="button" class="sc2-action" data-action="browse" data-type="feat"><i class="fa-solid fa-book-open"></i> {{localize "SPYCRAFT.Feat.Browse"}}</button>
      <button type="button" class="sc2-action" data-action="syncGrants" aria-label="{{localize 'SPYCRAFT.Action.RefreshGrantedFeats'}}" data-tooltip="{{localize 'SPYCRAFT.Action.RefreshGrantedFeats'}}"><i class="fa-solid fa-rotate" aria-hidden="true"></i><span>{{localize "SPYCRAFT.Action.RefreshGrants"}}</span></button>
    </span></h3>
  <div class="feat-slots">
    <span class="slot {{#if (sc2lt system.feats.any.remaining 0)}}bad{{/if}}"><b>{{localize "SPYCRAFT.Feat.Any"}}</b> {{system.feats.any.spent}} / {{system.feats.any.slots}}</span>
    {{#each featTrees}}<span class="slot"><b>{{label}}</b> {{#if slots}}{{spent}} / {{slots}}{{else}}{{owned}}{{/if}}</span>{{/each}}
  </div>
  {{#each system.feats.replacementGrants}}<p>{{name}} {{localize "SPYCRAFT.Template.ActorAgentFeats.WasAlsoGrantedByAClass"}} {{count}} {{localize "SPYCRAFT.Template.ActorAgentFeats.ReplacementFeatChoiceSIn"}} {{tree}} (p.171).</p>{{/each}}
  </div>
  {{#if featFreeActions.length}}<ul class="plain">{{#each featFreeActions}}<li>{{name}} <b class="sc2-uses">{{remaining}}/{{limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentFeats.Per"}} {{period}}{{#if counterReview}} · <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.SavedUseCountNeedsGCReview"}}</span>{{else}}{{#if roundAction}}{{#if remaining}} <button type="button" class="sc2-action" data-action="useFeatFreeAction" data-resource="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentFeats.UseRoundAction"}}</button>{{/if}}{{/if}}{{/if}}</li>{{/each}}</ul>{{/if}}
  {{#if jinxUse}}<p>{{localize "SPYCRAFT.Template.ActorAgentFeats.Jinx"}} <b class="sc2-uses">{{jinxUse.remaining}}/{{jinxUse.limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentFeats.PerSessionSelectItWhenPaying"}}{{#if jinxUse.counterReview}} <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.SavedUseCountNeedsGCReview"}}</span>{{/if}}{{#if isGM}} <button type="button" class="gc-review sc2-action" data-sc2-display="icon" data-action="reviewLimitedUseCounter" data-resource="jinx">{{localize "SPYCRAFT.Template.ActorAgentFeats.ReviewSavedCount"}}</button>{{/if}}</p>{{/if}}
  {{#if markUse}}<p>{{localize "SPYCRAFT.Template.ActorAgentFeats.Mark"}} <b class="sc2-uses">{{markUse.remaining}}/{{markUse.limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentFeats.PerSession"}} {{#if markUse.counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.SavedUseCountNeedsGCReview"}}</span>{{/if}}</p>{{/if}}
  {{#if silverVictories.length}}<details><summary>{{localize "SPYCRAFT.Template.ActorAgentFeats.SilverTongueSeductionVictories"}}</summary><ul class="plain">{{#each silverVictories}}<li>{{#if needsReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.VictoryHistoryNeedsGCReview"}}</span>{{else}}{{conflictId}} — {{targetName}}: {{event.amount}} {{localize "SPYCRAFT.Template.ActorAgentFeats.TemporaryWisdomDamage"}} {{status}}.{{#if ../isGM}}{{#if pending}} <button type="button" class="sc2-action" data-action="resumeSilverTongueVictory" data-victory="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentFeats.ResumeSettlement"}}</button>{{/if}}{{#if correctable}} <button type="button" class="sc2-action" data-action="correctSilverTongueVictory" data-victory="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentFeats.CorrectErroneousVictory"}}</button>{{/if}}{{/if}}{{/if}}</li>{{/each}}</ul></details>{{/if}}
  {{#if markObservations.length}}<details><summary>{{localize "SPYCRAFT.Template.ActorAgentFeats.MarkObservations"}}</summary><ul class="plain">{{#each markObservations}}<li>{{target}}: {{#if needsReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.HistoryNeedsGCReview"}}</span>{{else}}{{#each skills}}{{name}}{{#if ../disclosed}} {{signed bonus}}{{#if context}} ({{context}}){{/if}}{{/if}}{{#unless @last}}; {{/unless}}{{/each}}{{#if pending}} {{localize "SPYCRAFT.Template.ActorAgentFeats.GCDisclosurePending"}}{{/if}}{{/if}}{{#if ../isGM}}{{#if pending}} <button type="button" class="sc2-action" data-action="discloseMark" data-observation="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentFeats.DiscloseBonuses"}}</button>{{/if}} <button type="button" class="sc2-action" data-action="correctMark" data-observation="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentFeats.CorrectHistory"}}</button>{{/if}}</li>{{/each}}</ul></details>{{/if}}
  <ul class="item-list feats-list">
    {{#each feats}}
      <li data-item-id="{{item.id}}" class="{{#unless status.ok}}unqualified{{/unless}} {{#if item.system.granted}}granted{{/if}}">
        <button type="button" data-action="itemEdit" class="name sc2-action">{{item.name}}{{#if (sc2lt 1 item.system.ranks)}} ×{{item.system.ranks}}{{/if}}</button>
        {{#if (sc2eq item.system.featKind "temporary")}}<span class="tag">{{localize "SPYCRAFT.Template.ActorAgentFeats.Temporary"}}{{#if item.system.temporaryGrant}} {{localize "SPYCRAFT.Template.ActorAgentFeats.UntilTheEndOfThis"}} {{item.system.temporaryGrant.period}}{{/if}}</span>{{/if}}
        {{#if status.ok}}{{#if (sc2eq item.name "Everyday Genius")}}<button type="button" class="sc2-action" data-action="useEverydayGenius">{{localize "SPYCRAFT.Template.ActorAgentFeats.GainATemporaryBasicSkillFeat"}}</button>{{/if}}{{/if}}
        {{#if status.ok}}{{#if (sc2eq item.name "Quick Draw")}}<button type="button" class="sc2-action" data-action="useFeatFreeAction" data-resource="quickDraw">{{localize "SPYCRAFT.Template.ActorAgentFeats.FreeWeaponActionTwiceRound"}}</button>{{/if}}{{#if (sc2eq item.name "Surge of Speed")}}<button type="button" class="sc2-action" data-action="useFeatFreeAction" data-resource="surgeOfSpeed">{{localize "SPYCRAFT.Template.ActorAgentFeats.FreeNonAttackHalfAction"}}</button>{{/if}}{{/if}}
        {{#if status.ok}}{{#if (sc2eq item.name "Silver Tongue")}}{{#if @root.isGM}}<button type="button" class="sc2-action" data-action="settleSilverTongueVictory">{{localize "SPYCRAFT.Template.ActorAgentFeats.GCSettleSeductionVictory"}}</button>{{/if}}{{/if}}{{/if}}
        {{#if status.ok}}{{#if (sc2eq item.name "Mark")}}<button type="button" class="sc2-action" data-action="useMark">{{localize "SPYCRAFT.Template.ActorAgentFeats.ObserveThreeSkillsFreeAction"}}</button>{{/if}}{{/if}}
        <span class="tree">{{treeLabel}}</span>
        {{#if item.system.granted}}<span class="tag">{{localize "SPYCRAFT.Feat.Granted"}}: {{item.system.grantSource}}</span>{{/if}}
        {{#unless status.ok}}<span class="bad" data-tooltip="{{prereqText}}"><i class="fa-solid fa-triangle-exclamation"></i> {{#each status.unmet}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</span>{{/unless}}
        <span class="controls" data-sc2-display="icon"><button type="button" class="sc2-action" data-action="itemChat" aria-label="{{localize 'SPYCRAFT.Action.ShareNamed' name=item.name}}" data-tooltip="{{localize 'SPYCRAFT.Action.ShareNamed' name=item.name}}"><i class="fa-solid fa-comment" aria-hidden="true"></i><span>{{localize "SPYCRAFT.Action.Share"}}</span></button> <button type="button" class="edit-only sc2-action" data-action="itemDelete" aria-label="{{localize 'SPYCRAFT.Action.RemoveNamed' name=item.name}}" data-tooltip="{{localize 'SPYCRAFT.Action.RemoveNamed' name=item.name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i><span>{{localize "SPYCRAFT.Action.Remove"}}</span></button></span>
      </li>
    {{else}}<li class="muted">{{localize "SPYCRAFT.Feat.None"}}</li>{{/each}}
  </ul>
</div>
