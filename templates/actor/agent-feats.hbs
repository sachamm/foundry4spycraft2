<section class="tab feats {{tab.cssClass}}" data-tab="feats" data-group="primary">
  <div class="edit-only">
  <h3>{{localize "SPYCRAFT.Feat.Slots"}}
    <span class="controls">
      <a data-action="browse" data-type="feat"><i class="fa-solid fa-book-open"></i> {{localize "SPYCRAFT.Feat.Browse"}}</a>
      <a data-action="syncGrants" data-tooltip="SPYCRAFT.Feat.SyncGrantsHint"><i class="fa-solid fa-rotate"></i></a>
    </span></h3>
  <div class="feat-slots">
    <span class="slot {{#if (sc2lt system.feats.any.remaining 0)}}bad{{/if}}"><b>{{localize "SPYCRAFT.Feat.Any"}}</b> {{system.feats.any.spent}} / {{system.feats.any.slots}}</span>
    {{#each featTrees}}<span class="slot"><b>{{label}}</b> {{#if slots}}{{spent}} / {{slots}}{{else}}{{owned}}{{/if}}</span>{{/each}}
  </div>
  {{#each system.feats.replacementGrants}}<p>{{name}} {{localize "SPYCRAFT.Template.ActorAgentFeats.WasAlsoGrantedByAClass"}} {{count}} {{localize "SPYCRAFT.Template.ActorAgentFeats.ReplacementFeatChoiceSIn"}} {{tree}} (p.171).</p>{{/each}}
  </div>
  {{#if featFreeActions.length}}<ul class="plain">{{#each featFreeActions}}<li>{{name}}: {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentFeats.Per"}} {{period}}{{#if counterReview}} · <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.SavedUseCountNeedsGCReview"}}</span>{{/if}}</li>{{/each}}</ul>{{/if}}
  {{#if jinxUse}}<p>{{localize "SPYCRAFT.Template.ActorAgentFeats.Jinx"}} {{jinxUse.remaining}} / {{jinxUse.limit}} {{localize "SPYCRAFT.Template.ActorAgentFeats.PerSessionSelectItWhenPaying"}}{{#if jinxUse.counterReview}} <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.SavedUseCountNeedsGCReview"}}</span>{{/if}}{{#if isGM}} <a data-action="reviewLimitedUseCounter" data-resource="jinx">{{localize "SPYCRAFT.Template.ActorAgentFeats.ReviewSavedCount"}}</a>{{/if}}</p>{{/if}}
  {{#if markUse}}<p>{{localize "SPYCRAFT.Template.ActorAgentFeats.Mark"}} {{markUse.remaining}} / {{markUse.limit}} {{localize "SPYCRAFT.Template.ActorAgentFeats.PerSession"}} {{#if markUse.counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.SavedUseCountNeedsGCReview"}}</span>{{/if}}</p>{{/if}}
  {{#if silverVictories.length}}<details><summary>{{localize "SPYCRAFT.Template.ActorAgentFeats.SilverTongueSeductionVictories"}}</summary><ul class="plain">{{#each silverVictories}}<li>{{#if needsReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.VictoryHistoryNeedsGCReview"}}</span>{{else}}{{conflictId}} — {{targetName}}: {{event.amount}} {{localize "SPYCRAFT.Template.ActorAgentFeats.TemporaryWisdomDamage"}} {{status}}.{{#if ../isGM}}{{#if pending}} <a data-action="resumeSilverTongueVictory" data-victory="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentFeats.ResumeSettlement"}}</a>{{/if}}{{#if correctable}} <a data-action="correctSilverTongueVictory" data-victory="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentFeats.CorrectErroneousVictory"}}</a>{{/if}}{{/if}}{{/if}}</li>{{/each}}</ul></details>{{/if}}
  {{#if markObservations.length}}<details><summary>{{localize "SPYCRAFT.Template.ActorAgentFeats.MarkObservations"}}</summary><ul class="plain">{{#each markObservations}}<li>{{target}}: {{#if needsReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentFeats.HistoryNeedsGCReview"}}</span>{{else}}{{#each skills}}{{name}}{{#if ../disclosed}} {{signed bonus}}{{#if context}} ({{context}}){{/if}}{{/if}}{{#unless @last}}; {{/unless}}{{/each}}{{#if pending}} {{localize "SPYCRAFT.Template.ActorAgentFeats.GCDisclosurePending"}}{{/if}}{{/if}}{{#if ../isGM}}{{#if pending}} <a data-action="discloseMark" data-observation="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentFeats.DiscloseBonuses"}}</a>{{/if}} <a data-action="correctMark" data-observation="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentFeats.CorrectHistory"}}</a>{{/if}}</li>{{/each}}</ul></details>{{/if}}
  <ul class="item-list feats-list">
    {{#each feats}}
      <li data-item-id="{{item.id}}" class="{{#unless status.ok}}unqualified{{/unless}} {{#if item.system.granted}}granted{{/if}}">
        <a data-action="itemEdit" class="name">{{item.name}}{{#if (sc2lt 1 item.system.ranks)}} ×{{item.system.ranks}}{{/if}}</a>
        {{#if (sc2eq item.system.featKind "temporary")}}<span class="tag">{{localize "SPYCRAFT.Template.ActorAgentFeats.Temporary"}}{{#if item.system.temporaryGrant}} {{localize "SPYCRAFT.Template.ActorAgentFeats.UntilTheEndOfThis"}} {{item.system.temporaryGrant.period}}{{/if}}</span>{{/if}}
        {{#if status.ok}}{{#if (sc2eq item.name "Everyday Genius")}}<a data-action="useEverydayGenius">{{localize "SPYCRAFT.Template.ActorAgentFeats.GainATemporaryBasicSkillFeat"}}</a>{{/if}}{{/if}}
        {{#if status.ok}}{{#if (sc2eq item.name "Quick Draw")}}<a data-action="useFeatFreeAction" data-resource="quickDraw">{{localize "SPYCRAFT.Template.ActorAgentFeats.FreeWeaponActionTwiceRound"}}</a>{{/if}}{{#if (sc2eq item.name "Surge of Speed")}}<a data-action="useFeatFreeAction" data-resource="surgeOfSpeed">{{localize "SPYCRAFT.Template.ActorAgentFeats.FreeNonAttackHalfAction"}}</a>{{/if}}{{/if}}
        {{#if status.ok}}{{#if (sc2eq item.name "Silver Tongue")}}{{#if @root.isGM}}<a data-action="settleSilverTongueVictory">{{localize "SPYCRAFT.Template.ActorAgentFeats.GCSettleSeductionVictory"}}</a>{{/if}}{{/if}}{{/if}}
        {{#if status.ok}}{{#if (sc2eq item.name "Mark")}}<a data-action="useMark">{{localize "SPYCRAFT.Template.ActorAgentFeats.ObserveThreeSkillsFreeAction"}}</a>{{/if}}{{/if}}
        <span class="tree">{{treeLabel}}</span>
        {{#if item.system.granted}}<span class="tag">{{localize "SPYCRAFT.Feat.Granted"}}: {{item.system.grantSource}}</span>{{/if}}
        {{#unless status.ok}}<span class="bad" data-tooltip="{{prereqText}}"><i class="fa-solid fa-triangle-exclamation"></i> {{#each status.unmet}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</span>{{/unless}}
        <span class="controls"><a data-action="itemChat"><i class="fa-solid fa-comment"></i></a> <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></span>
      </li>
    {{else}}<li class="muted">{{localize "SPYCRAFT.Feat.None"}}</li>{{/each}}
  </ul>
</section>
