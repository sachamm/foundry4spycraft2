<section class="tab gear {{tab.cssClass}}" data-tab="gear" data-group="primary">
  <h3>{{localize "SPYCRAFT.Weapons"}} <span class="controls"><a data-action="browse" data-type="weapon"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ActorAgentGear.BrowseWeapons"}}</a> <a data-action="createItem" data-type="weapon"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ActorAgentGear.AddWeapon"}}</a></span></h3>
  <ul class="inventory-weapons" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentGear.Weapons'}}">
    {{#each weapons}}
    <li class="inventory-weapon" data-item-id="{{item.id}}">
      <div class="inventory-title"><a data-action="itemEdit" class="inventory-name" aria-label="Open {{item.name}}">{{item.name}}</a><span class="equipment-state">{{#if item.system.equipped}}{{localize "SPYCRAFT.Template.ActorAgentGear.Equipped"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentGear.NotEquipped"}}{{/if}}</span></div>
      <div class="inventory-rolls">
        <a data-action="rollAttack" class="sc2-primary-action {{#unless attack.trained}}bad{{/unless}}" aria-label="Roll attack with {{item.name}}">{{localize "SPYCRAFT.Template.ActorAgentGear.Attack"}} {{signed attack.total}}{{#unless attack.trained}}*{{/unless}}</a>
        <a data-action="rollDamage" aria-label="Roll damage for {{item.name}}">{{item.system.damage}}</a>
        {{#if attack.range}}<a data-action="rollRangedAttack" aria-label="Attack with {{item.name}} at a measured distance">{{localize "SPYCRAFT.Template.ActorAgentGear.MeasuredAttack"}}</a>{{/if}}
      </div>
      <dl class="inventory-stats">
        {{#if attack.firearm}}<div><dt>{{localize "SPYCRAFT.Template.ActorAgentGear.FireMode"}}</dt><dd>{{attack.fireModeLabel}}</dd></div>{{/if}}
        <div><dt>{{localize "SPYCRAFT.Template.ActorAgentGear.Error"}}</dt><dd>{{attack.error}}</dd></div><div><dt>{{localize "SPYCRAFT.Template.ActorAgentGear.Threat"}}</dt><dd>{{attack.threat}}</dd></div>
        {{#if attack.range}}<div><dt>{{localize "SPYCRAFT.Template.ActorAgentGear.RangeIncrement"}}</dt><dd>{{attack.range}} {{localize "SPYCRAFT.Template.ActorAgentGear.Ft"}}</dd></div>{{/if}}
      </dl>
      {{#if shots}}<p class="inventory-ammunition{{#if shots.empty}} inventory-warning{{/if}}">{{shots.label}} <a data-action="reloadWeapon">{{@root.playLabels.reload}}</a>{{#if shots.counted}} <a data-action="resupplyWeapon">{{@root.playLabels.resupply}}</a>{{/if}}</p>{{/if}}
      {{#unless attack.trained}}<p class="inventory-warning">{{localize "SPYCRAFT.Template.ActorAgentGear.UntrainedAttackTheAttackDialogChecks"}}</p>{{/unless}}
      {{#if attack.quirky.quirky}}{{#unless attack.trained}}<p class="inventory-warning">{{localize "SPYCRAFT.Template.ActorAgentGear.Quirky4WhileUntrained"}}</p>{{/unless}}{{/if}}
      {{#if attack.trainedOnly.trainedOnly}}{{#unless attack.trained}}<p class="inventory-warning">{{localize "SPYCRAFT.Template.ActorAgentGear.TrainingRequiredForThisWeapon"}}</p>{{/unless}}{{/if}}
      {{#if ammoConfiguration.reason}}<p class="inventory-warning">{{ammoConfiguration.reason}}</p>{{/if}}
      <details class="inventory-details" data-key="weapon-{{item.id}}"><summary>{{localize "SPYCRAFT.Template.ActorAgentGear.EquipmentAmmunition"}}</summary>
        <dl class="inventory-stats"><div><dt>{{localize "SPYCRAFT.Template.ActorAgentGear.Caliber"}}</dt><dd>{{caliber}}</dd></div><div><dt>{{localize "SPYCRAFT.Template.ActorAgentGear.MissionPick"}}</dt><dd>{{#if item.system.pick}}{{item.system.pick}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentGear.NoneRecorded"}}{{/if}}</dd></div></dl>
        {{#if ammoConfiguration.selected}}<p>{{localize "SPYCRAFT.Template.ActorAgentGear.PrintedAmmunitionStockpile"}} <b>{{ammoConfiguration.selected.shots}} {{localize "SPYCRAFT.Template.ActorAgentGear.Shots"}}</b> ({{ammoConfiguration.selected.code}}{{localize "SPYCRAFT.Template.ActorAgentGear.ThisIsTheStockpileSizeNot"}}</p>{{/if}}
        <div class="inventory-utilities">
          {{#if canPlanAmmunition}}<a data-action="planAmmunition">{{localize "SPYCRAFT.Template.ActorAgentGear.CalculateAmmunitionCost"}}</a>{{/if}}
          {{#if canResistDisarm}}<a data-action="rollDisarmResponse">{{localize "SPYCRAFT.Template.ActorAgentGear.ResistADisarm"}}</a>{{/if}}
          <a data-action="itemEquip" aria-pressed="{{item.system.equipped}}" aria-label="{{#if item.system.equipped}}Unequip{{else}}Equip{{/if}} {{item.name}}">{{#if item.system.equipped}}{{localize "SPYCRAFT.Template.ActorAgentGear.Unequip"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentGear.Equip"}}{{/if}}</a>
          <a data-action="itemDelete" aria-label="Remove {{item.name}}">{{localize "SPYCRAFT.Template.ActorAgentGear.RemoveWeapon"}}</a>
        </div>
      </details>
    </li>
    {{else}}<li class="inventory-empty">{{localize "SPYCRAFT.Template.ActorAgentGear.NoWeaponsRecordedChooseBrowseWeapons"}}</li>{{/each}}
  </ul>

  <h3>{{localize "SPYCRAFT.Armor"}} <span class="controls"><a data-action="browse" data-type="armor"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ActorAgentGear.BrowseArmor"}}</a> <a data-action="createItem" data-type="armor"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ActorAgentGear.AddArmor"}}</a></span></h3>
  <div class="inventory-table-wrap"><table class="items inventory-table" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentGear.Armor'}}">
    <thead><tr><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Name"}}</th><th scope="col"><abbr title="{{localize 'SPYCRAFT.Template.ActorAgentGear.DamageReductionOrdinarySubdual'}}">{{localize "SPYCRAFT.Template.ActorAgentGear.DamageReduction"}}</abbr></th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Defense"}}</th><th scope="col"><abbr title="{{localize 'SPYCRAFT.Template.ActorAgentGear.ArmorCheckPenalty'}}">{{localize "SPYCRAFT.Template.ActorAgentGear.CheckPenalty"}}</abbr></th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Speed"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Caliber"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Pick"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Actions"}}</th></tr></thead>
    <tbody>{{#each armor}}
      <tr data-item-id="{{item.id}}">
        <td><a data-action="itemEdit">{{item.name}}</a></td>
        <td>{{item.system.damageReduction}}/{{item.system.damageReductionSubdual}}</td><td>{{item.system.defensePenalty}}</td><td>{{item.system.armorCheck}}</td><td>{{item.system.speedPenalty}}</td><td>{{caliber}}</td><td>{{item.system.pick}}</td>
        <td class="controls" data-sc2-display="icon"><a data-action="itemEquip" aria-pressed="{{item.system.equipped}}" aria-label="{{#if item.system.equipped}}Unequip{{else}}Equip{{/if}} {{item.name}}">{{#if item.system.equipped}}{{localize "SPYCRAFT.Template.ActorAgentGear.Unequip"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentGear.Equip"}}{{/if}}</a> <a class="edit-only" data-action="itemDelete" aria-label="Remove {{item.name}}">{{localize "SPYCRAFT.Template.ActorAgentGear.Remove"}}</a></td>
      </tr>
    {{else}}<tr><td colspan="8" class="inventory-empty">{{localize "SPYCRAFT.Template.ActorAgentGear.NoArmorRecordedUseBrowseArmor"}}</td></tr>{{/each}}</tbody>
  </table></div>

  <h3>{{localize "SPYCRAFT.Gear"}} <span class="controls"><a data-action="browse" data-type="gear"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ActorAgentGear.BrowseGear"}}</a> <a data-action="createItem" data-type="gear"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ActorAgentGear.AddGear"}}</a></span></h3>
  <div class="inventory-table-wrap"><table class="items inventory-table" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentGear.Gear'}}">
    <thead><tr><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Name"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Quantity"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Caliber"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Pick"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Actions"}}</th></tr></thead>
    <tbody>{{#each gear}}
      <tr data-item-id="{{item.id}}">
        <td><a data-action="itemEdit">{{item.name}}</a>{{#if toolShed.expired}} <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentGear.LostAtMissionEnd"}}</span>{{else}}{{#if toolShed.blockedReason}} <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentGear.GrantNeedsReview"}}</span>{{/if}}{{/if}}</td><td>{{item.system.quantity}}</td><td>{{caliber}}</td><td>{{item.system.pick}}</td>
        <td class="controls" data-sc2-display="icon"><a data-action="itemChat" aria-label="Share {{item.name}} in chat">{{localize "SPYCRAFT.Template.ActorAgentGear.Share"}}</a> <a class="edit-only" data-action="itemDelete" aria-label="Remove {{item.name}}">{{localize "SPYCRAFT.Template.ActorAgentGear.Remove"}}</a></td>
      </tr>
    {{else}}<tr><td colspan="5" class="inventory-empty">{{localize "SPYCRAFT.Template.ActorAgentGear.NoGearRecordedUseBrowseGear"}}</td></tr>{{/each}}</tbody>
  </table></div>

  <h3>{{localize "SPYCRAFT.Template.ActorAgentGear.Vehicles"}} <span class="controls"><a data-action="browse" data-type="vehicle"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ActorAgentGear.BrowseVehicles"}}</a> <a data-action="createItem" data-type="vehicle"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ActorAgentGear.AddVehicle"}}</a></span></h3>
  <div class="inventory-table-wrap"><table class="items inventory-table" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentGear.Vehicles'}}">
    <thead><tr><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Name"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Category"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Caliber"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Pick"}}</th><th scope="col"><abbr title="{{localize 'SPYCRAFT.Template.ActorAgentGear.AccelerationTurning'}}">{{localize "SPYCRAFT.Template.ActorAgentGear.AccelTurn"}}</abbr></th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.MPH"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.DefenseSave"}}</th><th scope="col">{{localize "SPYCRAFT.Template.ActorAgentGear.Actions"}}</th></tr></thead>
    <tbody>{{#each vehicles}}
      <tr data-item-id="{{item.id}}">
        <td><a data-action="itemEdit">{{item.name}}</a></td><td>{{classLabel}}</td><td>{{caliber}}</td><td>{{item.system.pick}}</td><td>{{item.system.accelerationTurning}}</td><td>{{item.system.mph}}</td><td>{{item.system.defenseSave}}</td>
        <td class="controls" data-sc2-display="icon"><a data-action="itemChat" aria-label="Share {{item.name}} in chat">{{localize "SPYCRAFT.Template.ActorAgentGear.Share"}}</a> <a class="edit-only" data-action="itemDelete" aria-label="Remove {{item.name}}">{{localize "SPYCRAFT.Template.ActorAgentGear.Remove"}}</a></td>
      </tr>
    {{else}}<tr><td colspan="8" class="inventory-empty">{{localize "SPYCRAFT.Template.ActorAgentGear.NoVehiclesRecordedUseBrowseVehicles"}}</td></tr>{{/each}}</tbody>
  </table></div>
  <details class="reference-panel" data-key="gearPlanning"><summary>{{localize "SPYCRAFT.Template.ActorAgentGear.WealthMissionPlanningAndAcquisitions"}}</summary>
  <h3>{{localize "SPYCRAFT.Wealth"}} <span class="points {{#if (sc2lt system.wealth.remaining 0)}}bad{{/if}}">{{system.wealth.allocated}} / {{system.wealth.total}}</span></h3>
  <table class="wealth">
    <thead><tr><th></th><th>{{localize "SPYCRAFT.Spent"}}</th><th>{{localize "SPYCRAFT.Rank"}}</th><th></th></tr></thead>
    <tbody>
      <tr><th>{{localize "SPYCRAFT.Lifestyle"}}</th><td><input class="w-2 edit-only" type="number" name="system.wealthAllocation.lifestyle" value="{{system.wealthAllocation.lifestyle}}" min="0" /></td>
        <td>{{system.wealth.lifestyle.rank}}</td><td class="muted">{{system.wealth.lifestyle.home}} · {{localize "SPYCRAFT.Vehicle"}} {{system.wealth.lifestyle.vehicle}} · {{system.wealth.lifestyle.appearance}} ({{signed system.wealth.lifestyle.appearanceMod}})</td></tr>
      <tr><th>{{localize "SPYCRAFT.Possessions"}}</th><td><input class="w-2 edit-only" type="number" name="system.wealthAllocation.possessions" value="{{system.wealthAllocation.possessions}}" min="0" /></td>
        <td>{{system.wealth.possessions.rank}}</td><td class="muted">{{system.wealth.possessions.picks}}</td></tr>
      <tr><th>{{localize "SPYCRAFT.SpendingCash"}}</th><td><input class="w-2 edit-only" type="number" name="system.wealthAllocation.spendingCash" value="{{system.wealthAllocation.spendingCash}}" min="0" /></td>
        <td>{{system.wealth.spendingCash.rank}}</td><td class="muted">${{system.wealth.spendingCash.amount}}</td></tr>
    </tbody>
  </table>
  {{#if system.bloodstainDefense.earned}}<label><input type="checkbox" name="system.wealthAllocation.dressedForLifestyle" {{checked system.wealthAllocation.dressedForLifestyle}} /> {{localize "SPYCRAFT.Template.ActorAgentGear.BloodstainResistantIAmDressedAccording"}}</label><p>{{localize "SPYCRAFT.Template.ActorAgentGear.BloodstainResistantDefense"}}{{system.bloodstainDefense.bonus}}. {{system.bloodstainDefense.reason}}</p>{{/if}}
  <p>{{localize "SPYCRAFT.Template.ActorAgentGear.WealthPossessions"}} {{system.wealth.possessions.budget.spent}} / {{system.wealth.possessions.budget.total}} {{localize "SPYCRAFT.Template.ActorAgentGear.Picks"}} {{system.wealth.possessions.budget.unfunded}} {{localize "SPYCRAFT.Template.ActorAgentGear.WithoutAnEligibleCaliberSlot"}} {{system.wealth.possessions.budget.unclassified}} {{localize "SPYCRAFT.Template.ActorAgentGear.GearEntriesHaveNoAcquisitionClassification"}}</p>
  <details><summary>{{localize "SPYCRAFT.Template.ActorAgentGear.PossessionsAllowanceByMaximumCaliber"}}</summary>{{#each system.wealth.possessions.budget.available}}<span>{{localize "SPYCRAFT.Template.ActorAgentGear.Caliber"}} {{@key}}: {{this}} {{localize "SPYCRAFT.Template.ActorAgentGear.Slots"}} {{lookup ../system.wealth.possessions.budget.remaining @key}} {{localize "SPYCRAFT.Template.ActorAgentGear.Remaining"}} </span>{{/each}}<p>{{localize "SPYCRAFT.Template.ActorAgentGear.LowerCaliberPicksMayUseHigher"}}</p></details>
  <div class="inline-fields">
    <label>{{localize "SPYCRAFT.Reputation"}} <input type="number" name="system.reputation" value="{{system.reputation}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.NetWorth"}} <input type="number" name="system.netWorth" value="{{system.netWorth}}" class="w-4" /></label>
    <span class="muted">{{localize "SPYCRAFT.CommonItems"}}: {{system.commonItems.count}} + {{system.commonItems.perMission}}/{{localize "SPYCRAFT.Mission"}}</span>
  </div>

  {{#if careerAgentReward.active}}{{#if careerAgentReward.record}}<p>{{localize "SPYCRAFT.Template.ActorAgentGear.CareerAgentMissionRewardRecorded"}} {{#if (sc2eq careerAgentReward.record.field "reputation")}}+{{careerAgentReward.record.amount}} {{localize "SPYCRAFT.Reputation"}}{{else}}+${{careerAgentReward.record.amount}} {{localize "SPYCRAFT.NetWorth"}}{{/if}}.</p>{{else}}{{#if isGM}}{{#unless careerAgentReward.review.needsReview}}<p><a data-action="useCareerAgentReward">{{localize "SPYCRAFT.Template.ActorAgentGear.CareerAgentSettleAdditionalMissionEnd"}}</a></p>{{/unless}}{{/if}}{{/if}}{{/if}}
  {{#if careerAgentReward.review.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentGear.CareerAgentMissionRewardNeedsReview"}} {{#if isGM}}<a data-action="reviewCareerAgentReward">{{localize "SPYCRAFT.Template.ActorAgentGear.GCReviewActualResourceBalancesAnd"}}</a>{{/if}}</p>{{/if}}

  <p><a data-action="browse" data-type="gear"><i class="fa-solid fa-book-open"></i> {{localize "SPYCRAFT.Template.ActorAgentGear.BrowseKits"}}</a></p>
  <p>{{localize "SPYCRAFT.Template.ActorAgentGear.CarriedWeight"}} {{system.encumbrance.weight}} {{localize "SPYCRAFT.Template.ActorAgentGear.Lbs"}} {{system.encumbrance.load}} {{localize "SPYCRAFT.Template.ActorAgentGear.Load"}} {{system.encumbrance.condition}} {{localize "SPYCRAFT.Template.ActorAgentGear.DR"}} {{system.dr.melee}} / {{system.dr.other}} {{localize "SPYCRAFT.Template.ActorAgentGear.MeleeOtherAttacks"}}</p>
  <h3>{{localize "SPYCRAFT.GearPicks"}}</h3>
  <div class="gear-picks">
    {{#each gearPicks}}<span class="slot {{#if (sc2lt remaining 0)}}bad{{/if}}" data-tooltip="{{label}}"><b>{{key}}</b> {{spent}} / {{available}}</span>{{/each}}
  </div>

  {{#if system.armorGrantStatus.caliber}}<p>{{localize "SPYCRAFT.Template.ActorAgentGear.ArmorUseOneArmorPieceUp"}} {{system.armorGrantStatus.caliber}} · {{#if system.armorGrantStatus.used}}{{localize "SPYCRAFT.Template.ActorAgentGear.SelectedForThisMission"}}{{else}}<a data-action="selectArmorUseGear">{{localize "SPYCRAFT.Template.ActorAgentGear.SelectFreeIntelPhaseArmor"}}</a>{{/if}}.</p>{{/if}}
  {{#if system.bigStickStatus.active}}<p>{{localize "SPYCRAFT.Template.ActorAgentGear.BigStick"}} {{#if (sc2eq system.bigStickStatus.caliber 5)}}{{system.bigStickStatus.upgradeAllowance}} {{localize "SPYCRAFT.Template.ActorAgentGear.ExtraUpgradesForWeaponMissionPicks"}}{{else}}{{#if system.bigStickStatus.used}}{{localize "SPYCRAFT.Template.ActorAgentGear.HigherCaliberWeaponSelectedForThis"}}{{else}}<a data-action="selectBigStickGear">{{localize "SPYCRAFT.Template.ActorAgentGear.SelectOneHigherCaliberMissionWeapon"}}</a>{{/if}}{{/if}}</p>{{/if}}
  {{#each system.missionCaliberOptions}}<p>{{name}}: {{#if (sc2eq caliber 5)}}{{upgradeAllowance}} {{localize "SPYCRAFT.Template.ActorAgentGear.ExtraUpgradesFor"}} {{category}} {{localize "SPYCRAFT.Template.ActorAgentGear.MissionPicksPurchasingEffectsRequireSeparate"}}{{else}}{{#if used}}{{localize "SPYCRAFT.Template.ActorAgentGear.SelectedForThisMission2"}}{{else}}{{#if selected}}{{selected}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentGear.PicksSelected"}} {{/if}}<a data-action="selectMissionCaliberGear" data-source="{{key}}">{{localize "SPYCRAFT.Template.ActorAgentGear.SelectOneHigherCaliberMissionPick"}}</a>{{/if}}{{/if}}</p>{{/each}}
  <p>{{localize "SPYCRAFT.Template.ActorAgentGear.ReserveCapacity"}} {{system.reserveUsed}} / {{system.reserveCapacity}} {{localize "SPYCRAFT.Template.ActorAgentGear.CombinedPicksAndCommonItemsReserved"}}</p>
  {{#if system.reserveTransactionReview.needsReview}}<p><a data-action="reviewReserveTransaction">{{localize "SPYCRAFT.Template.ActorAgentGear.GCReviewInterruptedReserveTransaction"}}</a></p>{{/if}}
  <p><a data-action="allocateMissionReserves">{{localize "SPYCRAFT.Template.ActorAgentGear.AllocateUnassignedMissionReserves"}}</a> <a data-action="rollGearAcquisition">{{localize "SPYCRAFT.Template.ActorAgentGear.RequestGearCheck"}}</a> <a data-action="findImprovisedWeapon">{{localize "SPYCRAFT.Template.ActorAgentGear.FindImprovisedWeapon"}}</a> <a data-action="claimGearAcquisition">{{localize "SPYCRAFT.Template.ActorAgentGear.ClaimSuccessfulAcquisition"}}</a></p>
  {{#if system.activeMissionReserves}}{{#if (sc2eq system.activeMissionReserves.initialized false)}}<p>{{localize "SPYCRAFT.Template.ActorAgentGear.MissionReservesAreUnallocatedPersonalStash"}}</p>{{else}}<p>{{localize "SPYCRAFT.Template.ActorAgentGear.CurrentMissionCaliber"}} {{system.activeMissionReserves.caliber}} {{localize "SPYCRAFT.Template.ActorAgentGear.ReserveCommonItems"}} {{system.activeMissionReserves.common}}{{localize "SPYCRAFT.Template.ActorAgentGear.ReservedPicks"}} {{#each system.activeMissionReserves.picks}}{{@key}} {{this}} · {{/each}}</p>{{/if}}{{/if}}
  {{#if safeHouseSource}}<p><a data-action="useSafeHouse">{{localize "SPYCRAFT.Template.ActorAgentGear.SafeHouseSceneOpeningDeclaration"}}</a>{{#if isGM}} <a data-action="reviewSafeHouseMission">{{localize "SPYCRAFT.Template.ActorAgentGear.GCReviewMissionUses"}}</a> <a data-action="reviewSafeHouseScene">{{localize "SPYCRAFT.Template.ActorAgentGear.GCReviewSceneUse"}}</a>{{/if}}</p>{{/if}}
  {{#if safeHouses.length}}<details><summary>{{localize "SPYCRAFT.Template.ActorAgentGear.SafeHousesDeclarationsAndGCLocations"}}</summary>{{#each safeHouses}}<p><b>{{record.currentLocation}}</b> {{localize "SPYCRAFT.Template.ActorAgentGear.HomeTier"}} {{state.rank}}: {{state.home}}. {{#if state.active}}{{#if state.placed}}{{record.placement.city}}: {{record.placement.address}}. {{record.placement.description}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentGear.GCExactLocationPending"}}{{/if}}{{else}}<span class="bad">{{state.reason}}</span>{{/if}}{{#if @root.isGM}}{{#if state.canPlace}} <a data-action="placeSafeHouse" data-house="{{key}}">{{localize "SPYCRAFT.Template.ActorAgentGear.GCConfirmLocation"}}</a>{{/if}} <a data-action="correctSafeHouseRecord" data-house="{{key}}">{{localize "SPYCRAFT.Template.ActorAgentGear.CorrectErroneousDeclaration"}}</a>{{/if}}</p>{{/each}}</details>{{/if}}
  {{#if wellFundedActive}}<p><a data-action="useWellFunded">{{localize "SPYCRAFT.Template.ActorAgentGear.WellFundedReceiveCashAtHome"}}</a>{{#if isGM}} <a data-action="reviewWellFundedCounter">{{localize "SPYCRAFT.Template.ActorAgentGear.GCReviewWellFundedUses"}}</a>{{/if}}</p>{{/if}}
  {{#if wellFundedCash.grants.length}}<details><summary>{{localize "SPYCRAFT.Template.ActorAgentGear.WellFundedCashReceived"}}{{wellFundedCash.totalReceived}} {{localize "SPYCRAFT.Template.ActorAgentGear.AllRecordedGrants"}}</summary><p class="muted">{{localize "SPYCRAFT.Template.ActorAgentGear.ReceiptsOfCashReceivedSpendingIs"}}</p>{{#each wellFundedCash.grants}}<p>${{amount}} {{localize "SPYCRAFT.Template.ActorAgentGear.Wealth"}} {{wealth}} · {{home}} {{localize "SPYCRAFT.Template.ActorAgentGear.Mission"}} {{epoch}}</p>{{/each}}</details>{{/if}}{{#if wellFundedCash.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentGear.ReviewInvalidWellFundedCashGrant"}}</p>{{/if}}
  {{#if toolShedSource}}<p><a data-action="useToolShed">{{localize "SPYCRAFT.Template.ActorAgentGear.ToolShedFindAGradeIII"}}</a>{{#if isGM}} <a data-action="reviewToolShedCounter">{{localize "SPYCRAFT.Template.ActorAgentGear.GCReviewToolShedUses"}}</a>{{/if}}</p>{{/if}}
  <details><summary>{{localize "SPYCRAFT.Template.ActorAgentGear.CharismaPenaltyRemoveClassGrantedPicks"}}</summary>
  {{#each gearPicks}}{{#unless (sc2eq key "CHA")}}<label>{{key}} <input type="number" min="0" name="system.gearPickLosses.{{key}}" value="{{lookup ../system.gearPickLosses key}}" class="w-2" /></label>{{/unless}}{{/each}}
  </details>
  </details>
</section>
