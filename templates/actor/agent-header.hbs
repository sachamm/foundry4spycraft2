<header class="sheet-header">
  <img class="portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}" />
  <div class="header-main">
    <div class="name-row">
      <input class="name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}" />
      <input class="codename" name="system.codename" type="text" value="{{system.codename}}" placeholder="{{localize 'SPYCRAFT.Codename'}}" />
    </div>
    <div class="summary">
      <span class="level"><b>{{localize "SPYCRAFT.CareerLevel"}} {{system.level}}</b></span>
      <label>{{localize "SPYCRAFT.XP"}} <input type="number" name="system.xp" value="{{system.xp}}" class="w-xp" /></label>
      {{#if xpNext}}<span class="muted">/ {{xpNext}}</span>{{/if}}
      <span class="talent">{{#if talent}}{{talent.name}}{{else}}<a data-action="browse" data-type="origin" data-origin-type="talent">{{localize "SPYCRAFT.Origin.ChooseTalent"}}</a>{{/if}}</span>
      <span class="specialty">{{#if specialty}}{{specialty.name}}{{else}}<a data-action="browse" data-type="origin" data-origin-type="specialty">{{localize "SPYCRAFT.Origin.ChooseSpecialty"}}</a>{{/if}}</span>
    </div>
    <div class="resources">
      <label class="res vitality">{{localize "SPYCRAFT.Vitality"}}
        <input type="number" name="system.vitality.value" value="{{system.vitality.value}}" /> <span>/ {{system.vitality.max}}</span></label>
      <label class="res wounds">{{localize "SPYCRAFT.Wounds"}}
        <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" /> <span>/ {{system.wounds.max}}</span></label>
      <span class="res action-dice">{{localize "SPYCRAFT.ActionDice.Label"}}
        <input type="number" name="system.actionDice.value" value="{{system.actionDice.value}}" /> <span>/ {{system.actionDice.max}} (d{{system.actionDice.die}}{{#if system.actionDice.bonus}}{{signed system.actionDice.bonus}}{{/if}})</span>
        <a data-action="spendActionDie" data-tooltip="SPYCRAFT.ActionDice.Spend"><i class="fa-solid fa-dice"></i></a>
        <a data-action="refreshActionDice" data-tooltip="SPYCRAFT.ActionDice.Refresh"><i class="fa-solid fa-rotate"></i></a>
      </span>
    </div>
  </div>
</header>
{{#if warnings.length}}
<details class="warnings">
  <summary><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SPYCRAFT.Warnings" count=warnings.length}} ({{warnings.length}})</summary>
  <ul>{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
</details>
{{/if}}
