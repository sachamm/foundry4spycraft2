{{!-- A template part must render exactly one root element, so the header, to-do and warnings share a wrapper. --}}
<div class="sheet-top">
<header class="sheet-header">
  <img class="portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}" />
  <div class="header-main">
    <div class="name-row">
      {{#if editMode}}<input class="name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}" />
      <input class="codename" name="system.codename" type="text" value="{{system.codename}}" placeholder="{{localize 'SPYCRAFT.Codename'}}" />{{else}}<strong class="agent-name" title="{{actor.name}}">{{actor.name}}</strong>{{#if system.codename}}<span class="agent-codename">{{system.codename}}</span>{{/if}}{{/if}}
      {{#if editable}}<button type="button" class="mode-toggle" data-sc2-display="{{#if editMode}}both{{else}}icon{{/if}}" data-action="toggleEditMode" aria-pressed="{{editMode}}">{{#if editMode}}{{localize "SPYCRAFT.Template.ActorAgentHeader.DoneEditingReturnToPlay"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentHeader.EditCharacter"}}{{/if}}</button>{{/if}}
    </div>
    <div class="summary">
      <span class="level sc2-chip"><b>{{localize "SPYCRAFT.CareerLevel"}} {{system.level}}</b></span>
      <label class="edit-only">{{localize "SPYCRAFT.XP"}} <input type="number" name="system.xp" value="{{system.xp}}" class="w-xp" /></label>
      {{#if xpNext}}<span class="muted edit-only">/ {{xpNext}}</span>{{/if}}
      <span class="talent origin sc2-chip" data-sc2-display="icon" {{#if talent}}data-item-id="{{talent.id}}"{{/if}}>{{#if talent}}<a data-action="itemEdit" data-tooltip="SPYCRAFT.Origin.talent">{{talent.name}}</a>
        <a class="edit-only" data-action="browse" data-type="origin" data-origin-type="talent" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.ChangeTalent'}}" data-tooltip="SPYCRAFT.Origin.Change"><i class="fa-solid fa-right-left"></i></a>
        <a class="edit-only" data-action="itemDelete" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.RemoveTalent'}}" data-tooltip="SPYCRAFT.Origin.Remove"><i class="fa-solid fa-xmark"></i></a>{{else}}<a class="edit-only" data-sc2-display="both" data-action="browse" data-type="origin" data-origin-type="talent">{{localize "SPYCRAFT.Origin.ChooseTalent"}}</a>{{/if}}</span>
      <span class="specialty origin sc2-chip" data-sc2-display="icon" {{#if specialty}}data-item-id="{{specialty.id}}"{{/if}}>{{#if specialty}}<a data-action="itemEdit" data-tooltip="SPYCRAFT.Origin.specialty">{{specialty.name}}</a>
        <a class="edit-only" data-action="browse" data-type="origin" data-origin-type="specialty" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.ChangeSpecialty'}}" data-tooltip="SPYCRAFT.Origin.Change"><i class="fa-solid fa-right-left"></i></a>
        <a class="edit-only" data-action="itemDelete" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.RemoveSpecialty'}}" data-tooltip="SPYCRAFT.Origin.Remove"><i class="fa-solid fa-xmark"></i></a>{{else}}<a class="edit-only" data-sc2-display="both" data-action="browse" data-type="origin" data-origin-type="specialty">{{localize "SPYCRAFT.Origin.ChooseSpecialty"}}</a>{{/if}}</span>
    </div>
    <div class="resources">
      <label class="res sc2-meter vitality"><span class="sc2-meter-label">{{localize "SPYCRAFT.Vitality"}}</span>
        <input type="number" name="system.vitality.value" value="{{system.vitality.value}}" /> <span class="sc2-meter-max" {{sc2tip tips.vitality}}>/ {{system.vitality.max}}</span>
        <progress max="{{system.vitality.max}}" value="{{system.vitality.value}}" aria-hidden="true"></progress></label>
      <label class="res sc2-meter wounds"><span class="sc2-meter-label">{{localize "SPYCRAFT.Wounds"}}</span>
        <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" /> <span class="sc2-meter-max" {{sc2tip tips.wounds}}>/ {{system.wounds.max}}</span>
        <progress max="{{system.wounds.max}}" value="{{system.wounds.value}}" aria-hidden="true"></progress></label>
      <span class="res action-dice" data-sc2-display="icon"><span class="sc2-meter-label">{{localize "SPYCRAFT.ActionDice.Label"}}</span>
        <input type="number" name="system.actionDice.value" aria-label="{{localize 'SPYCRAFT.ActionDice.Label'}}" value="{{system.actionDice.value}}" /> <span class="sc2-meter-max" {{sc2tip tips.actionDice}}>/ {{system.actionDice.max}} · d{{system.actionDice.die}}{{#if system.actionDice.bonus}}{{signed system.actionDice.bonus}}{{/if}}</span>
        <span class="res-actions">
        {{#unless startingDiceEntry.blocked}}<a data-sc2-display="both" data-action="initializeStartingDice" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.BeginPlayOnceWithThisCharacter'}}">{{localize "SPYCRAFT.Template.ActorAgentHeader.BeginPlay"}}</a>{{/unless}}
        <a data-action="spendActionDie" data-tooltip="SPYCRAFT.ActionDice.Spend">{{localize "SPYCRAFT.Template.ActorAgentHeader.Spend"}}</a>
        <a data-action="healActionDice" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.HealOutsideCombatWithActionDice'}}">{{localize "SPYCRAFT.Template.ActorAgentHeader.Heal"}}</a>
        <a data-action="refreshAction" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.BeginOrCompleteAFullRound'}}">{{localize "SPYCRAFT.Template.ActorAgentHeader.Refresh"}}</a>
        <a data-action="boostDefense" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.BoostDefenseWithAnActionDie'}}">{{localize "SPYCRAFT.Template.ActorAgentHeader.Defense"}}</a>
        </span>
      </span>
    </div>
  </div>
</header>
{{#if setupGuide.next}}
<aside class="setup-next edit-only" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.NextSetupChoice'}}">
  <div><strong>{{localize "SPYCRAFT.Template.ActorAgentHeader.Next"}} {{setupGuide.next.label}}</strong><p>{{setupGuide.next.text}}</p></div>
  {{#if editable}}<button type="button" class="sc2-primary-action" data-action="setupTask" data-tab="{{setupGuide.next.tab}}" data-order="{{setupGuide.next.order}}" {{#if setupGuide.next.skillLevel}}data-skill-level="{{setupGuide.next.skillLevel}}"{{/if}} {{#if setupGuide.next.browse}}data-type="{{setupGuide.next.browse.type}}" data-origin-type="{{setupGuide.next.browse.originType}}"{{/if}}>{{localize "SPYCRAFT.Template.ActorAgentHeader.ContinueSetup"}}</button>{{/if}}
</aside>
<details class="todo" data-key="todo" {{#if open.todo}}open{{/if}}>
  <summary><i class="fa-solid fa-list-check" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ActorAgentHeader.SetupChecklist"}} {{setupGuide.count}} {{localize "SPYCRAFT.Template.ActorAgentHeader.Reminders"}}</summary>
  <ol class="setup-steps" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.RemainingCharacterSetup'}}">
    {{#each setupGuide.steps}}<li><details data-key="setup-{{tab}}">
      <summary>{{label}} <span class="setup-count">{{count}}</span></summary>
      <ul>{{#each tasks}}<li>{{#if @root.editable}}<button type="button" data-action="setupTask" data-tab="{{tab}}" data-order="{{order}}" {{#if skillLevel}}data-skill-level="{{skillLevel}}"{{/if}} {{#if browse}}data-type="{{browse.type}}" data-origin-type="{{browse.originType}}"{{/if}}>{{text}}</button>{{else}}{{text}}{{/if}}</li>{{/each}}</ul>
    </details></li>{{/each}}
  </ol>
</details>
{{else}}
<p class="setup-clear edit-only">{{localize "SPYCRAFT.Template.ActorAgentHeader.NoSetupRemindersCheckAnyCharacter"}}</p>
{{/if}}
{{#if warnings.length}}
<details class="warnings" data-key="warnings" {{#if open.warnings}}open{{/if}}>
  <summary><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SPYCRAFT.Warnings" count=warnings.length}} ({{warnings.length}})</summary>
  <ul>{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
</details>
{{/if}}
</div>
