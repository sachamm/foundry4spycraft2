<section class="tab main play {{tab.cssClass}}" data-tab="play" data-pane="main" data-group="primary">
{{#each shakenInitiativeReviews}}<p class="bad">{{name}}{{localize "SPYCRAFT.Template.ActorAgentMain.InitiativeCount"}} {{count}} {{localize "SPYCRAFT.Template.ActorAgentMain.NeedsShakenReview"}} {{reason}} {{#if @root.isGM}}<a data-action="reviewShakenInitiative" data-combat-id="{{combatId}}" data-combatant-id="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewIncludedPenalty"}}</a>{{/if}}</p>{{/each}}
{{> "systems/spycraft2/templates/actor/play/dashboard.hbs"}}

  {{> "systems/spycraft2/templates/actor/play/identities.hbs"}}
  <div class="cols main-reference">
    {{> "systems/spycraft2/templates/actor/play/reference-abilities.hbs"}}

    {{> "systems/spycraft2/templates/actor/play/reference-combat.hbs"}}
  </div>
  <section class="combat-toolbox play-only" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentMain.CombatTools'}}">
    <div class="combat-tool-head">
      <h3>{{localize "SPYCRAFT.Template.ActorAgentMain.CombatTools"}}</h3>
      {{#if editable}}<button type="button" class="pin-mode" data-sc2-display="both" data-action="togglePinMode" aria-pressed="{{pinMode}}">{{#if pinMode}}{{localize "SPYCRAFT.Pins.Done"}}{{else}}{{localize "SPYCRAFT.Pins.Choose"}}{{/if}}</button>{{/if}}
      <input type="search" class="combat-tool-search" placeholder="{{localize 'SPYCRAFT.Template.ActorAgentMain.FindATool'}}" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentMain.FindATool'}}" />
      {{#if isGM}}<label class="combat-tool-all"><input type="checkbox" data-action="toggleAllTools" {{checked showAllTools}} /> {{localize "SPYCRAFT.Template.ActorAgentMain.ShowAllTools"}}</label>{{/if}}
    </div>
    {{#if pinMode}}<p class="tool-hint pin-hint">{{localize "SPYCRAFT.Pins.Hint"}}</p>{{/if}}
    <p class="combat-tool-empty muted" hidden>{{localize "SPYCRAFT.Template.ActorAgentMain.NoToolMatches"}}</p>
    <div class="combat-tool-groups">
    {{> "systems/spycraft2/templates/actor/play/combat-attacks.hbs"}}
    {{#if combatTools.styles}}
    {{> "systems/spycraft2/templates/actor/play/combat-movement.hbs"}}
    {{/if}}
    {{> "systems/spycraft2/templates/actor/play/combat-defense.hbs"}}
    {{> "systems/spycraft2/templates/actor/play/combat-outcomes.hbs"}}
{{> "systems/spycraft2/templates/actor/play/combat-conditions.hbs"}}
    {{#if isGM}}
    {{> "systems/spycraft2/templates/actor/play/combat-review.hbs"}}
    {{else}}
      {{#if combatReviewNeeded}}<aside class="combat-review-notice" role="status">
      {{#if usagePeriodReview.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.Interrupted"}} {{usagePeriodReview.period}} {{localize "SPYCRAFT.Template.ActorAgentMain.StartNeedsGCReview"}} {{#if isGM}}<a data-action="reviewUsagePeriod">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewStartingDiceAndCounters"}}</a>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewThe"}}{{/if}}</p>{{/if}}
      {{#if actor.flags.spycraft2.missionXPReview.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.InterruptedMissionXPNeedsGCReview"}} {{#if isGM}}<a data-action="reviewMissionXP">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewMissionXPAndReward"}}</a>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewMission"}}{{/if}}</p>{{/if}}
      {{#if actor.flags.spycraft2.actionDieAwardReview.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.InterruptedAwardNeedsGCReview"}} {{#if isGM}}<a data-action="reviewActionDieAward">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewAwardAndBalances"}}</a>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewThe2"}}{{/if}}</p>{{/if}}
      {{#if system.actionDiceSettlementReview.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.InterruptedActionDieUseNeedsGC"}} {{#if isGM}}<a data-action="reviewActionDiceSettlement">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewHealthAndActionDice"}}</a>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewHealth"}}{{/if}}</p>{{/if}}
      </aside>{{/if}}
    {{/if}}
    </div>
  </section>

  <details class="misc-mods edit-only">
    <summary>{{localize "SPYCRAFT.MiscModifiers"}}</summary>
    <div class="misc-grid">
      {{#each system.misc as |v k|}}
        <label>{{k}} <input type="number" name="system.misc.{{k}}" value="{{v}}" class="w-2" /></label>
      {{/each}}
    </div>
  </details>
</section>
