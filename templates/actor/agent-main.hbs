<section class="tab main {{tab.cssClass}}" data-tab="main" data-group="primary">
{{#each shakenInitiativeReviews}}<p class="bad">{{name}}{{localize "SPYCRAFT.Template.ActorAgentMain.InitiativeCount"}} {{count}} {{localize "SPYCRAFT.Template.ActorAgentMain.NeedsShakenReview"}} {{reason}} {{#if @root.isGM}}<a data-action="reviewShakenInitiative" data-combat-id="{{combatId}}" data-combatant-id="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewIncludedPenalty"}}</a>{{/if}}</p>{{/each}}
  <div class="play-dashboard play-only">
    <div class="defense-summary">      <h3>{{localize "SPYCRAFT.Defenses"}}</h3>
      <div class="stat-grid">
        {{#each saves}}
          <button type="button" class="stat sc2-stat-action" data-action="rollSave" data-save="{{key}}" aria-label="Roll {{label}}"><span>{{label}}</span><b {{sc2tip tip}}>{{signed total}}</b><small>{{localize "SPYCRAFT.Base"}} {{base}}{{#if bonus}}, {{signed bonus}}{{/if}}</small></button>
        {{/each}}
        <div class="stat"><span>{{localize "SPYCRAFT.Defense"}}</span><b {{sc2tip tips.defense}}>{{system.defense.total}}</b><small>{{localize "SPYCRAFT.Base"}} {{system.defense.base}}{{#if system.defense.armor}}, {{localize "SPYCRAFT.Armor"}} {{signed system.defense.armor}}{{/if}}</small></div>
        <button type="button" class="stat sc2-stat-action" data-action="rollInitiative" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentMain.RollInitiative'}}"><span>{{localize "SPYCRAFT.Initiative"}}</span><b {{sc2tip tips.initiative}}>{{signed system.initiative.total}}</b><small>{{localize "SPYCRAFT.Base"}} {{system.initiative.base}}</small></button>
        <div class="stat"><span>{{localize "SPYCRAFT.Speed"}}</span><b {{sc2tip tips.speed}}>{{#if system.conditionSpeedReview}}{{localize "SPYCRAFT.Template.ActorAgentMain.GCRulingNeeded"}}{{else}}{{system.speed}} {{localize "SPYCRAFT.Template.ActorAgentMain.Ft"}}{{/if}}</b></div>
      </div></div>
    <div class="dashboard-weapons">      <h3>{{localize "SPYCRAFT.Weapons"}}</h3>
      <ul class="item-list compact">
        {{#each weapons}}
          <li data-item-id="{{item.id}}">
            <a data-action="rollAttack" class="name sc2-primary-action">{{localize "SPYCRAFT.Template.ActorAgentMain.Attack"}} {{item.name}}</a>
            <span class="{{#unless attack.trained}}bad{{/unless}}">{{signed attack.total}}{{#unless attack.trained}}*{{/unless}}</span>
            <a data-action="rollDamage" aria-label="Roll damage for {{item.name}}">{{localize "SPYCRAFT.Template.ActorAgentMain.Damage"}} {{item.system.damage}}</a>
          </li>
        {{else}}<li class="muted">{{localize "SPYCRAFT.NoWeapons"}}</li>{{/each}}
      </ul>
</div>
    <div class="quick-actions" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentMain.CommonActions'}}">      <p><a data-action="checkNumericalAdvantage">{{localize "SPYCRAFT.Template.ActorAgentMain.CheckNumericalAdvantage"}}</a> · <a data-action="checkCombatMovement">{{localize "SPYCRAFT.Template.ActorAgentMain.CheckCombatMovement"}}</a> · <a data-action="takeTotalDefense">{{localize "SPYCRAFT.Template.ActorAgentMain.TakeTotalDefense"}}</a>{{#if system.totalDefenseState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.Dodge"}}{{system.totalDefenseState.bonus}}{{#if system.totalDefenseState.equilibrium}} {{localize "SPYCRAFT.Template.ActorAgentMain.EquilibriumBasics"}}{{system.totalDefenseState.equilibrium.bonus}} {{localize "SPYCRAFT.Template.ActorAgentMain.Included"}}{{/if}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.totalDefenseState.dueRound}}{{/if}}</p></div>
    {{#if activeConditions.length}}<div class="condition-summary"><b>{{localize "SPYCRAFT.Template.ActorAgentMain.CurrentConditions"}}</b>{{#each activeConditions}}<span class="tag bad">{{this}}</span>{{/each}}</div>{{/if}}
  </div>

  <section class="combat-toolbox play-only" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentMain.CombatTools'}}">
    <h3>{{localize "SPYCRAFT.Template.ActorAgentMain.CombatTools"}}</h3>
    <div class="combat-tool-groups">
    <details class="combat-tool-group" data-key="combat-attacks">
      <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.AttacksReactions"}}</span><small>{{localize "SPYCRAFT.Template.ActorAgentMain.DisarmTricksAndFinalAttacks"}}</small></summary>
      <p class="tool-hint">{{localize "SPYCRAFT.Template.ActorAgentMain.ChooseANewActionHereCounter"}}</p>
      <div class="tool-actions">
        {{#if combatTools.striking}}<a data-action="takeStrikingAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.StrikingReaction"}}</a>{{/if}}
        {{#if combatTools.missTrick}}<a data-action="takeMissTrick">{{localize "SPYCRAFT.Template.ActorAgentMain.DoubleTwirlRemiss"}}</a>{{/if}}
        <a data-action="rollDisarm">{{localize "SPYCRAFT.Template.ActorAgentMain.DisarmOpposedCheck"}}</a>
        <a data-action="rollCheapShot">{{localize "SPYCRAFT.Template.ActorAgentMain.CheapShot"}}</a>
        <a data-action="takeCounterTrip">{{localize "SPYCRAFT.Template.ActorAgentMain.CounterTrip"}}</a>
        <a data-action="takeTripFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.TripFinalAttack"}}</a>
      </div>
      {{#with mobileOffense}}<p>{{#if @root.startedCharacterCombat}}{{localize "SPYCRAFT.Template.ActorAgentMain.MobileOffense"}} {{remaining}} /{{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.ThisRound"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}}<a data-action="takeMobileOffense">{{localize "SPYCRAFT.Template.ActorAgentMain.FinalAttackDuringStandardMove"}}</a>{{/if}}{{/if}}{{#if @root.isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="mobileOffense">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewUsesAlreadyResolved"}}</a>{{/if}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.MobileOffenseStartACombatContaining"}}{{/if}}</p>{{/with}}
      {{#with contempt}}<p>{{#if @root.startedCharacterCombat}}{{localize "SPYCRAFT.Template.ActorAgentMain.Contempt"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.ThisCombat"}} {{@root.contemptRound.remaining}} {{localize "SPYCRAFT.Template.ActorAgentMain.1ThisRound"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCombatCountNeedsGCReview"}}</span>{{else}}{{#if @root.contemptRound.counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedRoundCountNeedsGCReview"}}</span>{{else}}{{#if remaining}}{{#if @root.contemptRound.remaining}}<a data-action="takeContempt">{{localize "SPYCRAFT.Template.ActorAgentMain.FinalAttackAgainstStandardCharacter"}}</a>{{/if}}{{/if}}{{/if}}{{/if}}{{#if @root.isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="contempt">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewCombatUses"}}</a> · <a data-action="reviewLimitedUseCounter" data-resource="contemptRound">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewRoundUses"}}</a>{{/if}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.ContemptStartACombatContainingThis"}}{{/if}}</p>{{/with}}
      {{#with combatInstincts}}<p>{{#if @root.startedCharacterCombat}}{{localize "SPYCRAFT.Template.ActorAgentMain.CombatInstincts"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.ThisRound"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}}<a data-action="takeCombatInstincts">{{localize "SPYCRAFT.Template.ActorAgentMain.ImmediateFinalAttackAfterMiss"}}</a>{{/if}}{{/if}}{{#if @root.isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="combatInstincts">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewReactionsAlreadyUsed"}}</a>{{/if}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.CombatInstinctsStartACombatContaining"}}{{/if}}</p>{{/with}}
      {{#with cleaveBasics}}<p>{{#if @root.startedCharacterCombat}}{{localize "SPYCRAFT.Template.ActorAgentMain.CleaveBasicsUses"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.ThisRound"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}}<a data-action="takeCleaveBasics">{{localize "SPYCRAFT.Template.ActorAgentMain.AttackAnotherOpponentAfterADrop"}}</a>{{/if}}{{/if}}{{#if @root.isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="cleaveBasics">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewReactionsAlreadyUsed"}}</a>{{/if}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.DropFollowUpStartACombat"}}{{/if}}</p>{{/with}}
      {{#with snapShot}}<p>{{#if @root.startedCharacterCombat}}{{localize "SPYCRAFT.Template.ActorAgentMain.SnapShotUses"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.ThisRound"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}}<a data-action="takeSnapShot">{{localize "SPYCRAFT.Template.ActorAgentMain.AttackAnotherOpponentAfterADrop"}}</a>{{/if}}{{/if}}{{#if @root.isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="snapShot">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewReactionsAlreadyUsed"}}</a>{{/if}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.DropFollowUpStartACombat"}}{{/if}}</p>{{/with}}
      {{#with opportunist}}<p>{{#if @root.startedCharacterCombat}}{{localize "SPYCRAFT.Template.ActorAgentMain.OpportunistUses"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.ThisRound"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}}<a data-action="takeOpportunist">{{localize "SPYCRAFT.Template.ActorAgentMain.OpportunistTake"}}</a>{{/if}}{{/if}}{{#if @root.isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="opportunist">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewReactionsAlreadyUsed"}}</a>{{/if}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.OpportunistStartACombat"}}{{/if}}</p>{{/with}}
      {{#with twoWeaponFinalAttack}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.FinalAttacks"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.Remaining"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedUseHistoryNeedsGCVerification"}}</span>{{else}}{{#if remaining}}<a data-action="takeTwoWeaponFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.TakeFinalAttack"}}</a>{{/if}}{{/if}}{{#if @root.isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="twoWeaponFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewAttacksAlreadyUsed"}}</a>{{else}}{{#if counterReview}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewThis"}}{{/if}}{{/if}}</p>{{/with}}
    </details>
    {{#if combatTools.styles}}
    <details class="combat-tool-group" data-key="combat-movement">
      <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.StancesMovement"}}</span><small>{{localize "SPYCRAFT.Template.ActorAgentMain.YourStanceAndAttackStyles"}}</small></summary>
      <p class="tool-hint">{{localize "SPYCRAFT.Template.ActorAgentMain.TheseControlsUseThisCharacterS"}}</p>
      {{#if combatTools.stance}}<p><a data-action="declareCombatStance">{{localize "SPYCRAFT.Template.ActorAgentMain.CombatStance"}}</a>{{#if system.combatStance}} {{localize "SPYCRAFT.Template.ActorAgentMain.Current"}} {{system.combatStance.key}}{{/if}}</p>{{/if}}
      {{#if combatTools.movement}}<p><a data-action="reviewStanceMovement">{{localize "SPYCRAFT.Template.ActorAgentMain.RecordRoundMovement"}}</a></p>{{/if}}
      {{#if combatTools.twoWeapon}}<p><a data-action="declareTwoWeapon">{{localize "SPYCRAFT.Template.ActorAgentMain.DeclareTwoWeaponCombat"}}</a>{{#if system.twoWeaponStyleState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.Declared"}} {{system.twoWeaponStyleState.extraAttacks}} {{localize "SPYCRAFT.Template.ActorAgentMain.FinalStandardAttacksAttackPenalty"}}{{system.twoWeaponStyleState.penalty}}{{localize "SPYCRAFT.Template.ActorAgentMain.SkillPenalty"}} {{#if system.twoWeaponStyleState.skillPenalty}}−{{system.twoWeaponStyleState.skillPenalty}}{{else}}0{{/if}}{{#if system.twoWeaponStyleState.handgunSkillWaiver}} {{localize "SPYCRAFT.Template.ActorAgentMain.BothGunsBlazingAlsoWaivesThis"}}{{/if}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.twoWeaponStyleState.dueRound}}{{/if}}{{#if system.twoWeaponStyleState.needsReview}} <span class="bad">{{system.twoWeaponStyleState.reason}}</span>{{/if}}{{#if system.twoWeaponStyle}}{{#if isGM}} · <a data-action="reviewTwoWeapon">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewRemainingTradeoff"}}</a>{{/if}}{{/if}}</p>{{/if}}
      {{#if combatTools.twoHit}}<p><a data-action="declareTwoHit">{{localize "SPYCRAFT.Template.ActorAgentMain.TwoHitComboWarriorsGrace"}}</a></p>{{/if}}
      {{#if combatTools.followUp}}<p><a data-action="declareFollowUp">{{localize "SPYCRAFT.Template.ActorAgentMain.FollowUpShotHailOfFire"}}</a></p>{{/if}}
      {{#if combatTools.darting}}
      <p><a data-action="declareDarting">{{localize "SPYCRAFT.Template.ActorAgentMain.DartingFlashingWeapon"}}</a>{{#if system.dartingStyleState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.AttackSkillPenalty"}}{{system.dartingStyleState.penalty}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.dartingStyleState.dueRound}}{{localize "SPYCRAFT.Template.ActorAgentMain.FinalAttacks2"}} {{dartingFinalAttack.remaining}} /{{system.dartingStyleState.extraAttacks}} · <a data-action="takeDartingFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.TakeFinalMeleeHurledAttack"}}</a>{{#if isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="dartingFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewAttacksAlreadyResolved"}}</a>{{/if}}{{/if}}{{#if system.dartingStyleState.needsReview}} <span class="bad">{{system.dartingStyleState.reason}}</span>{{/if}}{{#if system.dartingStyle}}{{#if isGM}} · <a data-action="reviewDarting">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewRemainingTradeoff"}}</a>{{/if}}{{/if}}</p>
      {{/if}}
    </details>
    {{/if}}
    <details class="combat-tool-group" data-key="combat-defense">
      <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.DefenseDamage"}}</span><small>{{localize "SPYCRAFT.Template.ActorAgentMain.IncomingAttacksSavesAndInjuries"}}</small></summary>
      <p class="tool-hint">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewAnIncomingAttackOrA"}}</p>
      {{#if combatTools.expertise}}
      <p><a data-action="activateCombatExpertise">{{localize "SPYCRAFT.Template.ActorAgentMain.CombatExpertise"}}</a>{{#if system.combatExpertiseState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.AttackSkillPenalty"}}{{system.combatExpertiseState.penalty}}{{localize "SPYCRAFT.Template.ActorAgentMain.Dodge2"}}{{system.combatExpertiseState.dodgeBonus}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.combatExpertiseState.dueRound}}{{/if}}</p>
      {{/if}}
      {{#if combatTools.cover}}
      <p><a data-action="declareSuperiorCover">{{localize "SPYCRAFT.Template.ActorAgentMain.SuperiorCover"}}</a>{{#if system.superiorCoverState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.AttackSkillPenalty2DR"}}{{system.superiorCoverState.dr}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.superiorCoverState.dueRound}} · <a data-action="reviewSuperiorCover">{{localize "SPYCRAFT.Template.ActorAgentMain.ConfirmChangedLostCover"}}</a>{{/if}}{{#if system.superiorCoverState.needsReview}} <span class="bad">{{system.superiorCoverState.reason}}</span>{{/if}}</p>
      {{/if}}
      <p><a data-action="checkIncomingDefense">{{localize "SPYCRAFT.Template.ActorAgentMain.CheckIncomingAttackDefense"}}</a> <a data-action="sufferInitiativeLoss">{{localize "SPYCRAFT.Template.ActorAgentMain.ApplyInitiativeCountLoss"}}</a>{{#if system.uncannyDodge.grade}} {{localize "SPYCRAFT.Template.ActorAgentMain.UncannyDodge"}} {{system.uncannyDodge.grade}}{{/if}}</p>
      <p><a data-action="checkReflexDamage">{{localize "SPYCRAFT.Template.ActorAgentMain.CheckDamageAfterARecordedReflex"}}</a>{{#if system.evasion.grade}} {{localize "SPYCRAFT.Template.ActorAgentMain.Evasion"}} {{system.evasion.grade}}{{/if}}</p>
      <p><a data-action="rollCriticalInjury">{{localize "SPYCRAFT.Template.ActorAgentMain.RollCriticalInjuryTableOfOuch"}}</a></p>
      {{#each criticalInjuryReviews}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.Injury"}} {{id}} — {{source}}: {{label}}. {{#if @root.isGM}}<a data-action="reviewCriticalInjury" data-injury="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewShowOriginalResult"}}</a>{{/if}}</p>{{/each}}
      {{#if system.adrenalineJunkieSource}}{{#if isGM}}<p><a data-action="recordAdrenalineWoundLoss">{{localize "SPYCRAFT.Template.ActorAgentMain.AdrenalineJunkieRecordFinalWoundLoss"}}</a></p>{{/if}}{{/if}}
      {{#with fortunate}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateUses"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.FortunateThisSession"}}{{#if @root.isGM}}{{#if counterReview}} <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}} · <a data-action="grantFortunate">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateGrant"}}</a>{{/if}}{{/if}} · <a data-action="reviewLimitedUseCounter" data-resource="fortunate">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateReview"}}</a>{{else}} {{localize "SPYCRAFT.Template.ActorAgentMain.FortunateAskGC"}}{{/if}}</p>{{/with}}
      {{#with blackCat}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.BlackCatUses"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.BlackCatThisScene"}}{{#if @root.isGM}}{{#if counterReview}} <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}} · <a data-action="applyBlackCat">{{localize "SPYCRAFT.Template.ActorAgentMain.BlackCatApply"}}</a>{{/if}}{{/if}} · <a data-action="reviewLimitedUseCounter" data-resource="blackCat">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateReview"}}</a>{{else}} {{localize "SPYCRAFT.Template.ActorAgentMain.BlackCatAskGC"}}{{/if}}</p>{{/with}}
      {{#with gunslinger}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.GunslingerUses"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerThisSession"}}{{#if remaining}} · <a data-action="useGunslingersEye">{{localize "SPYCRAFT.Template.ActorAgentMain.GunslingerSizeUp"}}</a>{{/if}}{{#if @root.isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="gunslingersEye">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateReview"}}</a>{{/if}}</p>{{/with}}
      {{#with berserker}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerUses"}} {{remaining}} / {{limit}} {{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerThisSession"}}{{#if @root.system.berserkerRageState.active}} · {{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerRaging"}} {{@root.system.berserkerRageState.remaining}} · <a data-action="endBerserkerRage">{{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerEnd"}}</a>{{else}}{{#if @root.system.berserkerRageState.record}} · <a data-action="endBerserkerRage">{{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerOver"}}</a>{{else}}{{#if remaining}} · <a data-action="enterBerserkerRage">{{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerEnter"}}</a>{{/if}}{{/if}}{{/if}}{{#if @root.isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="berserkerRage">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateReview"}}</a>{{/if}}</p>{{/with}}
      {{#each system.unrestrictedBonusPools}}<p>{{label}}: {{available}} d{{die}} {{localize "SPYCRAFT.Template.ActorAgentMain.BonusDiceAvailableUntil"}} {{expiryLabel}}{{#if reason}} · {{reason}}{{/if}}</p>{{/each}}
      {{#if system.actionDieDefense}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.ActionDie2DefenseThroughRound"}} {{system.actionDieDefense.lastRound}}.</p>{{/if}}
    </details>
    <details class="combat-tool-group" data-key="combat-outcomes">
      <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.RecordedOutcomes"}}</span><small>{{localize "SPYCRAFT.Template.ActorAgentMain.ResolveAnAttackAlreadyRolled"}}</small></summary>
      <p class="hint">{{localize "SPYCRAFT.Template.ActorAgentMain.UseTheseToolsAfterAnAttack"}}</p>
      <div class="tool-actions">
        <a data-action="manageTripOutcomes">{{localize "SPYCRAFT.Template.ActorAgentMain.TripOutcomes"}}</a>
        <a data-action="manageFeintOutcomes">{{localize "SPYCRAFT.Template.ActorAgentMain.FeintOutcomes"}}</a>
        <a data-action="manageTakedown">{{localize "SPYCRAFT.Template.ActorAgentMain.TakedownSavesOutcomes"}}</a>
        <a data-action="manageMeleeTradeoff">{{localize "SPYCRAFT.Template.ActorAgentMain.RecordedAttackBenefits"}}</a>
        <a data-action="manageCheapShots">{{localize "SPYCRAFT.Template.ActorAgentMain.CheapShotOutcomesRecovery"}}</a>
        <a data-action="recordFendMovement">{{localize "SPYCRAFT.Template.ActorAgentMain.FendMovement"}}</a>
        <a data-action="manageThreadNeedle">{{localize "SPYCRAFT.Template.ActorAgentMain.ThreadTheNeedleOutcome"}}</a>
        <a data-action="manageStanceDamage">{{localize "SPYCRAFT.Template.ActorAgentMain.StanceDamage"}}</a>
        <a data-action="settleGrapple">{{localize "SPYCRAFT.Template.ActorAgentMain.SettleAGrapple"}}</a>
        <a data-action="manageDrivingStance">{{localize "SPYCRAFT.Template.ActorAgentMain.DrivingStanceOutcome"}}</a>
      </div>
    </details>
    <details class="combat-tool-group" data-key="combat-conditions">
      <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.ConditionsRecovery"}}</span><small>{{#if activeConditions.length}}{{activeConditions.length}} {{localize "SPYCRAFT.Template.ActorAgentMain.CurrentConditionLabels"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.ApplyConditionsOrTrackRecovery"}}{{/if}}</small></summary>
      <details class="condition-group" data-key="conditions-posture"><summary>{{localize "SPYCRAFT.Template.ActorAgentMain.PostureRestraints"}}</summary>
      <p><a data-action="setMovementCondition" data-condition="nauseated">{{localize "SPYCRAFT.Template.ActorAgentMain.NauseatedCondition"}}</a>{{#if system.conditionContext.nauseated}} {{localize "SPYCRAFT.Template.ActorAgentMain.NoConcentrationChecksAtMostOne"}}{{/if}}{{#if startedCharacterCombat}} {{localize "SPYCRAFT.Template.ActorAgentMain.RecordedFinalAttacksThisRound"}} {{finalAttackRound.used}}{{#if finalAttackRound.counterReview}} <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewActualCurrentRoundCount"}}</span>{{/if}}{{#if isGM}} · <a data-action="reviewLimitedUseCounter" data-resource="finalAttackRound">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewAllFinalAttacksAlready"}}</a>{{/if}}{{/if}}</p>
      <p><a data-action="setMovementCondition" data-condition="prone">{{localize "SPYCRAFT.Template.ActorAgentMain.ProneCondition"}}</a> · <a data-action="setMovementCondition" data-condition="sprawled">{{localize "SPYCRAFT.Template.ActorAgentMain.SprawledCondition"}}</a>{{#if system.postureMovement.prone}} {{localize "SPYCRAFT.Template.ActorAgentMain.ProneNoStandardMoveBullRush"}}{{/if}}{{#if system.postureMovement.sprawled}} {{localize "SPYCRAFT.Template.ActorAgentMain.SprawledVulnerableAttacks2MovementOnly"}}{{/if}}</p>
      {{#if system.restraintReleaseReview.needsReview}}<p><a data-action="reviewRestraintRelease">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewInterruptedGrappleRelease"}}</a></p>{{/if}}
