      {{#if system.mentalLeapState.exhausted}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.ExhaustedSTRDEX6SpeedHalved"}} <a data-action="recordFatigueEscalation">{{localize "SPYCRAFT.Template.ActorAgentMain.RecordAnotherFatigueExhaustionApplication"}}</a></p>{{else}}{{#if system.mentalLeapState.fatigued}}<p class="bad">{{#if system.mentalLeapState.fatiguedPenaltiesIgnored}}{{localize "SPYCRAFT.Template.ActorAgentMain.FatiguedGutsIgnoresItsSTRDEX"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.FatiguedSTRDEX2CannotRun"}}{{/if}} {{localize "SPYCRAFT.Template.ActorAgentMain.6ToSavesAgainstFatigue"}}</p>{{/if}}{{/if}}
      {{#if system.mentalLeapState.unconscious}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.UnconsciousHelplessMayTakeNoActions"}}</p>{{/if}}
      {{#if system.mentalLeapState.recoveryAvailable}}<p><a data-action="startMentalLeapSleep">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewTrackUnconsciousnessSleep"}}</a>{{#if system.mentalLeapSleep}} {{localize "SPYCRAFT.Template.ActorAgentMain.RecordedRequirements"}} {{#if system.mentalLeapSleep.requirements}}{{#each system.mentalLeapSleep.requirements}}{{requiredHours}} {{localize "SPYCRAFT.Template.ActorAgentMain.FullHours"}}{{#unless @last}}; {{/unless}}{{/each}}{{else}}{{system.mentalLeapSleep.requiredHours}} {{localize "SPYCRAFT.Template.ActorAgentMain.FullHoursEarlierRecord"}}{{/if}}{{#if system.mentalLeapState.sleepCauseReview}} {{localize "SPYCRAFT.Template.ActorAgentMain.ReviewCurrentCausesBeforeCompletion"}}{{else}} · <a data-action="completeMentalLeapSleep">{{localize "SPYCRAFT.Template.ActorAgentMain.ConfirmCompletedSleep"}}</a>{{/if}}{{/if}}</p>{{/if}}
      {{#each system.attributeCollapse.entries}}<p class="bad"><b>{{label}} {{score}}:</b> {{text}}</p>{{/each}}
      {{#if attributeDamageRows.length}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.AttributeDamage"}} {{#each attributeDamageRows}}{{label}} {{total}} {{localize "SPYCRAFT.Template.ActorAgentMain.Temporary"}} {{temporary}}{{localize "SPYCRAFT.Template.ActorAgentMain.Permanent"}} {{permanent}}){{#unless @last}} · {{/unless}}{{/each}}.</p>{{/if}}
      {{#if attributeDamageHistory}}{{#if attributeMissionRecovered}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.CurrentMissionSTemporaryAttributeRecovery"}}</p>{{else}}{{#if isGM}}<p><a data-action="recoverSilverTongueAtMissionEnd">{{localize "SPYCRAFT.Template.ActorAgentMain.GCRecoverSilverTongueWisdomDamage"}}</a></p>{{/if}}{{/if}}{{/if}}
      {{#if system.attributeCollapse.wisdomEpisode}}<p><a data-action="rollWisdomCollapse">{{localize "SPYCRAFT.Template.ActorAgentMain.RollWisdomCollapseEpisodeForGC"}}</a></p>{{/if}}
      {{#if system.cqbReadiedRules.initiativeBonus}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.CQBSupremacyInitiativeChecks5While"}}</p>{{/if}}

      </details>

    </div>

    <div class="col">
      <h3>{{localize "SPYCRAFT.Combat"}}</h3>
      <div class="stat-grid">
        <div class="stat"><span>{{localize "SPYCRAFT.Template.ActorAgentMain.CQBRangeBeyondReach"}}</span><b>{{system.cqbRange}} {{localize "SPYCRAFT.Template.ActorAgentMain.Ft2"}}</b></div>
        <div class="stat"><span>{{localize "SPYCRAFT.BAB"}}</span><b>{{signed system.bab}}</b></div>
        <div class="stat"><span>{{localize "SPYCRAFT.AttackUnarmed"}}</span><b>{{signed system.attack.unarmed}}</b></div>
        <div class="stat"><span>{{localize "SPYCRAFT.AttackMelee"}}</span><b>{{signed system.attack.melee}}</b></div>
        <div class="stat"><span>{{localize "SPYCRAFT.AttackRanged"}}</span><b>{{signed system.attack.ranged}}</b></div>
        <div class="stat"><span>{{localize "SPYCRAFT.StressThreshold"}}</span><b>{{system.stressThreshold}}</b></div>
        <div class="stat"><span>{{localize "SPYCRAFT.SubdualThreshold"}}</span><b>{{system.subdualThreshold}}</b></div>
      </div>
      <p><a data-action="checkAccumulatedDamage">{{localize "SPYCRAFT.Template.ActorAgentMain.CheckStressSubdualThresholds"}}</a>{{#if isGM}} · <a data-action="reviewDamageLedger">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewAccumulatedTotals"}}</a>{{/if}}</p>
      {{#if system.accumulatedDamage}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.AccumulatedStress"}} {{system.accumulatedDamage.stress}} {{localize "SPYCRAFT.Template.ActorAgentMain.Subdual"}} {{system.accumulatedDamage.subdual}} {{localize "SPYCRAFT.Template.ActorAgentMain.PendingSaves"}} {{system.accumulatedDamage.pending.length}}.{{#if system.accumulatedDamage.pending.length}} <a data-action="rollPendingDamageSave">{{localize "SPYCRAFT.Template.ActorAgentMain.RollOrReviewNextPendingSave"}}</a> · <a data-action="settlePendingDamageSave">{{localize "SPYCRAFT.Template.ActorAgentMain.SettleNextPendingSave"}}</a>.{{/if}} <a data-action="applyAccumulatedDamage">{{localize "SPYCRAFT.Template.ActorAgentMain.RecordDamageEvent"}}</a></p>{{else}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.AccumulatedDamageHasNotBeenInitialized"}}</p>{{/if}}
      <div class="hazards">
        <p><b>{{localize "SPYCRAFT.Template.ActorAgentMain.Hazards"}}</b> · <a data-action="exposeToContagion">{{localize "SPYCRAFT.Template.ActorAgentMain.ExposeToAContagion"}}</a> · <a data-action="exposeToFire">{{localize "SPYCRAFT.Template.ActorAgentMain.FireDamage"}}</a></p>
        {{#each hazards.contagions}}<p class="hazard{{#if due}} due{{/if}}">{{label}}{{#if doses}} ×{{doses}}{{/if}} — {{phase}}, {{localize "SPYCRAFT.Template.ActorAgentMain.FortitudeDC"}} {{dc}} ({{effect}}); {{#if due}}<b>{{localize "SPYCRAFT.Template.ActorAgentMain.SaveDueNow"}}</b>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.SaveDueIn"}} {{dueIn}}{{/if}} · <a data-action="rollContagionSave" data-id="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentMain.RollTheSave"}}</a> · <a data-action="cureHazard" data-id="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentMain.AntidoteOrEnd"}}</a></p>{{/each}}
        {{#if hazards.fire}}<p class="hazard due"><b>{{localize "SPYCRAFT.Template.ActorAgentMain.OnFire"}}</b> {{hazards.fire.damage}} ({{localize "SPYCRAFT.Template.ActorAgentMain.ArmorPiercing"}} {{hazards.fire.ap}}; {{localize "SPYCRAFT.Template.ActorAgentMain.TakenFromThisFire"}} {{hazards.fire.suffered}}) · <a data-action="burningRound">{{localize "SPYCRAFT.Template.ActorAgentMain.StartOfRound"}}</a> · <a data-action="rollFireSave" data-kind="will">{{localize "SPYCRAFT.Template.ActorAgentMain.WillSaveToAct"}}</a> · <a data-action="fightFire" data-method="roll">{{localize "SPYCRAFT.Template.ActorAgentMain.RollOnTheGround"}}</a> · <a data-action="fightFire" data-method="water">{{localize "SPYCRAFT.Template.ActorAgentMain.Water"}}</a> · <a data-action="fightFire" data-method="blanket">{{localize "SPYCRAFT.Template.ActorAgentMain.Blanket"}}</a> · <a data-action="fightFire" data-method="extinguisher">{{localize "SPYCRAFT.Template.ActorAgentMain.Extinguisher"}}</a> · <a data-action="rollFireSave" data-kind="scar">{{localize "SPYCRAFT.Template.ActorAgentMain.ScarringSave"}}</a>{{#if isGM}} · <a data-action="extinguishFire">{{localize "SPYCRAFT.Template.ActorAgentMain.FireIsOut"}}</a>{{/if}}</p>{{/if}}
      </div>
      <p>{{localize "SPYCRAFT.Template.ActorAgentMain.SightHearingIncrements"}} {{system.senses.visualIncrement}} / {{system.senses.hearingIncrement}} {{localize "SPYCRAFT.Template.ActorAgentMain.FtScentRange"}} {{system.senses.scentRange}} {{localize "SPYCRAFT.Template.ActorAgentMain.Ft2"}}{{#if system.senses.keenSensesBonus}} {{localize "SPYCRAFT.Template.ActorAgentMain.KeenSenses20FtIncluded"}}{{/if}} {{#if system.senses.blinded}} {{localize "SPYCRAFT.Template.ActorAgentMain.CurrentlyCannotSee"}}{{/if}}{{#if system.senses.deafened}} {{localize "SPYCRAFT.Template.ActorAgentMain.CurrentlyCannotHear"}}{{/if}} {{localize "SPYCRAFT.Template.ActorAgentMain.ApplyGearAndEnvironmentModifiers"}}</p>
      <h3>{{localize "SPYCRAFT.Checks"}}</h3>
      <div class="stat-grid">
        <div class="stat"><span>{{localize "SPYCRAFT.Knowledge"}}</span><a data-action="rollKnowledge" {{sc2tip tips.knowledge}}>{{signed system.knowledge}}</a></div>
        <div class="stat"><span>{{localize "SPYCRAFT.Request"}}</span><b>{{signed system.requestCheck}}</b></div>
        <div class="stat"><span>{{localize "SPYCRAFT.GearCheck"}}</span><b>{{signed system.gearCheck}}</b></div>
      </div>
      {{#if system.actionDieAwardSummary.count}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.GCActionDiceAwardedThisMission"}} {{system.actionDieAwardSummary.count}} · {{#if system.actionDieAwardSummary.settled}}{{localize "SPYCRAFT.Template.ActorAgentMain.MissionRewardSettled"}} {{system.actionDieAwardSummary.totalXP}} {{localize "SPYCRAFT.Template.ActorAgentMain.XP"}}{{else}}+{{system.actionDieAwardSummary.baseXP}} {{localize "SPYCRAFT.Template.ActorAgentMain.BaseMissionXPBeforeTheCareer"}}{{/if}}</p>{{/if}}
      <p><a data-action="configureFortuneTeammates">{{localize "SPYCRAFT.Template.ActorAgentMain.ImprovedFortuneTeammates"}}</a>{{#if system.improvedFortune.value}} · +{{system.improvedFortune.value}} {{localize "SPYCRAFT.Template.ActorAgentMain.StartingActionDiceTeamCap3"}}{{/if}}</p>
      <h3>{{localize "SPYCRAFT.Carrying"}}</h3>
      <div class="carry muted">
        {{localize "SPYCRAFT.Carry.Light"}} {{system.carry.light}} · {{localize "SPYCRAFT.Carry.Medium"}} {{system.carry.medium}} · {{localize "SPYCRAFT.Carry.Heavy"}} {{system.carry.heavy}} ·
        {{localize "SPYCRAFT.Carry.Extreme"}} {{system.carry.extreme}} {{localize "SPYCRAFT.Template.ActorAgentMain.Lbs"}}<br>
        {{localize "SPYCRAFT.Carry.Lift"}} {{system.carry.liftOverhead}} / {{system.carry.liftGround}} · {{localize "SPYCRAFT.Carry.Push"}} {{system.carry.push}} {{localize "SPYCRAFT.Template.ActorAgentMain.Lbs"}}
      </div>
    </div>
  </div>

  <details class="misc-mods edit-only">
    <summary>{{localize "SPYCRAFT.MiscModifiers"}}</summary>
    <div class="misc-grid">
      {{#each system.misc as |v k|}}
        <label>{{k}} <input type="number" name="system.misc.{{k}}" value="{{v}}" class="w-2" /></label>
      {{/each}}
    </div>
  </details>
</section>
