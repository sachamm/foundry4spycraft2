{{!-- The rail stays in view on every tab: who this is, how hurt they are, and what they roll most. --}}
<aside class="sheet-rail" aria-label="{{actor.name}}">
  <div class="rail-id">
    <img class="portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}" />
    {{#if editable}}<button type="button" class="mode-toggle" data-sc2-display="both" data-action="toggleEditMode" aria-pressed="{{editMode}}">{{#if editMode}}{{localize "SPYCRAFT.Rail.Done"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentHeader.EditCharacter"}}{{/if}}</button>{{/if}}
    {{#if editMode}}<input class="name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}" aria-label="{{localize 'Name'}}" />
    <input
      class="codename"
      name="system.codename" type="text" value="{{system.codename}}" placeholder="{{localize 'SPYCRAFT.Codename'}}"
      aria-label="{{localize 'SPYCRAFT.Codename'}}" />{{else}}<strong
      class="agent-name">{{actor.name}}</strong>{{#if system.codename}}<span
      class="sc2-stamp agent-codename">{{system.codename}}</span>{{/if}}{{/if}}
    <div class="summary">
      <span class="level sc2-chip"><b>{{localize "SPYCRAFT.CareerLevel"}} {{system.level}}</b></span>
      <label class="edit-only">{{localize "SPYCRAFT.XP"}} <input type="number" name="system.xp" value="{{system.xp}}" class="w-xp" />{{#if xpNext}}<span class="muted"> / {{xpNext}}</span>{{/if}}</label>
      <span class="play-only sc2-chip xp-chip">{{localize "SPYCRAFT.XP"}} {{system.xp}}{{#if xpNext}} / {{xpNext}}{{/if}}</span>
      {{#if levelUpReady}}{{#if editable}}<button type="button" class="sc2-primary-action level-up" data-action="addLevel">{{localize "SPYCRAFT.Rail.LevelUp"}}</button>{{/if}}{{/if}}
      <span class="talent origin sc2-chip" data-sc2-display="icon" {{#if talent}}data-item-id="{{talent.id}}"{{/if}}>{{#if talent}}<button type="button" class="sc2-action" data-action="itemEdit" data-tooltip="{{localize 'SPYCRAFT.Origin.talent'}}">{{talent.name}}</button>
        <button type="button" class="edit-only sc2-action" data-action="browse" data-type="origin" data-origin-type="talent" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.ChangeTalent'}}" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.ChangeTalent'}}"></button>
        <button type="button" class="edit-only sc2-action" data-action="itemDelete" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.RemoveTalent'}}" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.RemoveTalent'}}"></button>{{else}}<button type="button" class="edit-only sc2-action" data-sc2-display="both" data-action="browse" data-type="origin" data-origin-type="talent">{{localize "SPYCRAFT.Origin.ChooseTalent"}}</button>{{/if}}</span>
      <span class="specialty origin sc2-chip" data-sc2-display="icon" {{#if specialty}}data-item-id="{{specialty.id}}"{{/if}}>{{#if specialty}}<button type="button" class="sc2-action" data-action="itemEdit" data-tooltip="{{localize 'SPYCRAFT.Origin.specialty'}}">{{specialty.name}}</button>
        <button type="button" class="edit-only sc2-action" data-action="browse" data-type="origin" data-origin-type="specialty" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.ChangeSpecialty'}}" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.ChangeSpecialty'}}"></button>
        <button type="button" class="edit-only sc2-action" data-action="itemDelete" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.RemoveSpecialty'}}" data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.RemoveSpecialty'}}"></button>{{else}}<button type="button" class="edit-only sc2-action" data-sc2-display="both" data-action="browse" data-type="origin" data-origin-type="specialty">{{localize "SPYCRAFT.Origin.ChooseSpecialty"}}</button>{{/if}}</span>
    </div>
  </div>

  {{!-- The next build step sits at the top of the rail, so it is in view on a small screen. --}}
  {{#if setupGuide.next}}{{#if editable}}<div class="sc2-next-setup">
    <span class="sc2-caption">{{playLabels.nextSetup}}</span>
    {{#with setupGuide.next}}<button type="button" class="sc2-primary-action{{#if error}} sc2-over{{/if}}" data-action="setupTask" data-tab="{{tab}}" data-order="{{order}}" {{#if skillLevel}}data-skill-level="{{skillLevel}}"{{/if}} {{#if browse}}data-type="{{browse.type}}" data-origin-type="{{browse.originType}}"{{/if}}>{{text}}</button>{{/with}}
  </div>{{/if}}{{/if}}

  {{#if activeConditions.length}}<div
    class="rail-conditions"
    role="status"
    aria-label="{{localize 'SPYCRAFT.Template.ActorAgentMain.CurrentConditions'}}">{{#each conditionStamps}}<span
    class="sc2-stamp"{{#if tip}}
    data-tooltip="{{tip}}" tabindex="0"{{/if}}>{{label}}</span>{{/each}}</div>{{/if}}

  <div class="rail-block resources">
    <label class="res sc2-meter vitality"><span class="sc2-caption" data-tooltip="{{localize 'SPYCRAFT.VitalityWhat'}}">{{localize "SPYCRAFT.Vitality"}} <i class="fa-solid fa-circle-question" aria-hidden="true"></i></span>
      <input type="number" name="system.vitality.value" value="{{system.vitality.value}}" /> <span class="sc2-meter-max" {{sc2tip tips.vitality}}>/ {{system.vitality.max}}</span>
      <progress max="{{system.vitality.max}}" value="{{system.vitality.value}}" aria-hidden="true"></progress></label>
    <label class="res sc2-meter wounds"><span class="sc2-caption" data-tooltip="{{localize 'SPYCRAFT.WoundsWhat'}}">{{localize "SPYCRAFT.Wounds"}} <i class="fa-solid fa-circle-question" aria-hidden="true"></i></span>
      <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" /> <span class="sc2-meter-max" {{sc2tip tips.wounds}}>/ {{system.wounds.max}}</span>
      <progress max="{{system.wounds.max}}" value="{{system.wounds.value}}" aria-hidden="true"></progress></label>
    {{#if nonLethalMeters.length}}<div class="sc2-nonlethal" role="status">{{#each nonLethalMeters}}<button type="button" class="sc2-nonlethal-meter{{#if pending}} pending{{/if}} sc2-action" data-action="{{action}}" data-tooltip="{{tooltip}}"><span class="sc2-caption">{{label}}</span> <b>{{total}}</b> / {{threshold}}<progress max="{{threshold}}" value="{{total}}" aria-hidden="true"></progress></button>{{/each}}</div>{{/if}}
  </div>

  <div class="rail-block rail-fields">
    <button type="button"
      class="sc2-field stat sc2-stat-action"
      data-action="checkIncomingDefense"
      aria-label="{{localize 'SPYCRAFT.Rail.CheckDefense'}}"><span
      class="sc2-caption">{{localize "SPYCRAFT.Defense"}}</span><b
      class="sc2-value" {{sc2tip tips.defense}}>{{system.defense.total}}</b></button>
    <button type="button" class="sc2-field stat sc2-stat-action" data-action="rollInitiative" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentMain.RollInitiative'}}"><span class="sc2-caption">{{localize "SPYCRAFT.Initiative"}}</span><b class="sc2-value" {{sc2tip tips.initiative}}>{{signed system.initiative.total}}</b></button>
    <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Speed"}}</span><b class="sc2-value" {{sc2tip tips.speed}}>{{#if system.conditionSpeedReview}}?{{else}}{{system.speed}}{{/if}}</b></div>
    <p
      class="rail-defense-note"
     
        data-tooltip="{{localize 'SPYCRAFT.Rail.DefenseNote'}}">{{localize "SPYCRAFT.Rail.FlatFooted" value=flatFootedDefense}} · {{localize "SPYCRAFT.Rail.DamageReduction" melee=system.dr.melee other=system.dr.other}}</p>
    {{#each saves}}<button type="button" class="sc2-field stat sc2-stat-action" data-action="rollSave" data-save="{{key}}" aria-label="{{localize 'SPYCRAFT.Action.RollNamed' name=label}}"><span class="sc2-caption">{{label}}</span><b class="sc2-value" {{sc2tip tip}}>{{signed total}}</b></button>{{/each}}
  </div>

  <div class="rail-block action-dice" data-sc2-display="both">
    <span class="sc2-caption" data-tooltip="{{localize 'SPYCRAFT.ActionDice.What'}}">{{localize "SPYCRAFT.ActionDice.Label"}} <i class="fa-solid fa-circle-question" aria-hidden="true"></i> <span class="die" {{sc2tip tips.actionDice}}>d{{system.actionDice.die}}{{#if system.actionDice.bonus}}{{signed system.actionDice.bonus}}{{/if}}</span></span>
    <div class="dice-line">
      <b class="sc2-value play-only">{{system.actionDice.value}}</b>
      <input class="edit-only" type="number" name="system.actionDice.value" aria-label="{{localize 'SPYCRAFT.ActionDice.Label'}}" value="{{system.actionDice.value}}" />
      <span class="sc2-pips" aria-hidden="true">{{#each actionDicePips}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
      {{#if editable}}<button type="button"
        class="sc2-action play-only"
        data-sc2-display="icon"
        data-action="adjustActionDice"
        aria-label="{{localize 'SPYCRAFT.ActionDice.Adjust'}}"
        data-tooltip="{{localize 'SPYCRAFT.ActionDice.AdjustHint'}}"><i
        class="fa-solid fa-pen"
        aria-hidden="true"></i></button>{{/if}}
    </div>
    <div class="res-actions">
      {{#unless startingDiceEntry.blocked}}<button type="button"
        class="sc2-primary-action sc2-action"
        data-sc2-display="both"
        data-action="initializeStartingDice"
        data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.BeginPlayOnceWithThisCharacter'}}">{{localize "SPYCRAFT.Template.ActorAgentHeader.BeginPlay"}}</button>{{/unless}}
      <button type="button"
        class="sc2-action"
        data-sc2-display="both"
        data-action="boostDefense" {{#unless defenseBoost.available}}disabled{{/unless}}
       
          data-tooltip="{{#if defenseBoost.reason}}{{defenseBoost.reason}}{{else}}{{localize 'SPYCRAFT.Template.ActorAgentHeader.BoostDefenseWithAnActionDie'}}{{/if}}">{{localize "SPYCRAFT.Template.ActorAgentHeader.Defense"}}</button>
      {{#if defenseBoost.active}}<span class="sc2-chip" role="status">{{defenseBoost.active}}</span>{{/if}}
      {{#if dying}}<button type="button" data-sc2-display="both" data-action="rollDying" class="bad sc2-action">{{playLabels.dying}}</button>{{/if}}
      <details class="rail-more" data-key="railMore"><summary>{{localize "SPYCRAFT.Rail.More"}}</summary>
        <button type="button"
          class="sc2-action"
          data-sc2-display="both"
          data-action="spendActionDie"
          data-tooltip="{{localize 'SPYCRAFT.ActionDice.Spend'}}">{{localize "SPYCRAFT.Template.ActorAgentHeader.Spend"}}</button>
        <button type="button"
          class="sc2-action"
          data-sc2-display="both"
          data-action="healActionDice"
          data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.HealOutsideCombatWithActionDice'}}">{{localize "SPYCRAFT.Template.ActorAgentHeader.Heal"}}</button>
        <button type="button"
          class="sc2-action"
          data-sc2-display="both"
          data-action="refreshAction"
          data-tooltip="{{localize 'SPYCRAFT.Template.ActorAgentHeader.BeginOrCompleteAFullRound'}}">{{localize "SPYCRAFT.Template.ActorAgentHeader.Refresh"}}</button>
      </details>
    </div>
  </div>

{{#if setupGuide.next}}{{#if editable}}<button type="button"
  class="sc2-chip setup-chip play-only"
  data-action="toggleEditMode"
  data-tooltip="{{localize 'SPYCRAFT.Rail.SetupLeftHint'}}">{{localize "SPYCRAFT.Rail.SetupLeft" count=setupGuide.count}}</button>{{/if}}{{/if}}
{{#if setupGuide.next}}
<details class="todo edit-only" data-key="todo" {{#if open.todo}}open{{/if}}>
  <summary><i class="fa-solid fa-list-check" aria-hidden="true"></i> {{localize "SPYCRAFT.Rail.SetupChecklist" count=setupGuide.count}}</summary>
  <ol class="setup-steps" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentHeader.RemainingCharacterSetup'}}">
    {{#each setupGuide.steps}}<li><details data-key="setup-{{tab}}">
      <summary>{{label}} <span class="setup-count">{{count}}</span></summary>
      <ul>{{#each tasks}}<li>{{#if @root.editable}}<button type="button" data-action="setupTask" data-tab="{{tab}}" data-order="{{order}}" {{#if skillLevel}}data-skill-level="{{skillLevel}}"{{/if}} {{#if browse}}data-type="{{browse.type}}" data-origin-type="{{browse.originType}}"{{/if}}>{{text}}</button>{{else}}{{text}}{{/if}}</li>{{/each}}</ul>
    </details></li>{{/each}}
  </ol>
</details>
{{else}}
<p class="setup-clear edit-only">{{localize "SPYCRAFT.Template.ActorAgentHeader.NoSetupRemindersCheckAnyCharacter"}}</p>
{{/if}}
{{#if warnings.length}}
<button type="button"
  class="sc2-chip setup-chip play-only"
  data-action="toggleEditMode"
  data-tooltip="{{localize 'SPYCRAFT.Rail.WarningsHint'}}">{{localize "SPYCRAFT.Rail.WarningsLeft" count=warnings.length}}</button>
<details class="warnings edit-only" data-key="warnings" {{#if open.warnings}}open{{/if}}>
  <summary><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{localize "SPYCRAFT.Warnings" count=warnings.length}} ({{warnings.length}})</summary>
  <ul>{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
</details>
{{/if}}
</aside>
