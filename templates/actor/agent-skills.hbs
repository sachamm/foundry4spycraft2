<section class="tab skills {{tab.cssClass}}" data-tab="skills" data-group="primary">
  {{#if system.bankedTrainingPoints}}<p>{{localize "SPYCRAFT.CareerZero.TrainingBank" count=system.bankedTrainingPoints}}</p>{{/if}}
  {{#if cakewalk}}<div class="sc2-panel"><p><b>{{cakewalk.label}}:</b> {{cakewalk.selected}}</p>{{#if cakewalk.warning}}<p class="bad">{{cakewalk.warning}}</p>{{/if}}{{#if cakewalk.canChoose}}<button type="button" class="sc2-action" data-action="selectCakewalkSkills">{{cakewalk.action}}</button>{{/if}}</div>{{/if}}
  {{#if canReviewSkillPurchasePolicy}}<p class="edit-only"><button type="button" class="sc2-action" data-action="reviewSkillPurchasePolicy">{{skillPurchasePolicyLabel}}</button></p>{{/if}}
  {{#if skillPurchasePolicyHint}}<p class="edit-only {{#if skillPurchasePolicyNeedsReview}}bad{{else}}muted{{/if}}">{{skillPurchasePolicyHint}}</p>{{/if}}
  {{#if skillLevel}}
  <div class="skill-levels edit-only">
    <span>{{localize "SPYCRAFT.Skill.SpendAtLevel"}}:</span>
    {{#each skillLevels}}<button type="button" class="lvl {{#if active}}active{{/if}} sc2-action" data-action="skillLevel" data-level="{{level}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{level}}</button>{{/each}}
    <span class="points {{#if (sc2lt skillLevelInfo.remaining 0)}}bad{{/if}}">{{skillLevelInfo.className}}: {{skillLevelInfo.spent}} / {{skillLevelInfo.available}} {{localize "SPYCRAFT.SkillPoints"}}</span>
    {{#if skillLevelInfo.classGrantPoints}}<span class="muted">{{localize "SPYCRAFT.Template.ActorAgentSkills.Includes"}} {{skillLevelInfo.classGrantName}} +{{skillLevelInfo.classGrantPoints}} {{localize "SPYCRAFT.Template.ActorAgentSkills.Points"}}</span>{{/if}}
    <span class="muted">{{localize "SPYCRAFT.Skill.MaxRanks"}} {{skillLevelInfo.maxRanks}} · {{localize "SPYCRAFT.Skill.ClassPicks"}} {{system.classSkillPicks.used}}/{{system.classSkillPicks.available}}</span>
  </div>
  {{else}}<p class="muted">{{localize "SPYCRAFT.Skill.NeedLevel"}}</p>{{/if}}
  {{#if isGM}}<p class="edit-only"><button type="button" data-action="manageAnalysisTasks">{{localize "SPYCRAFT.Template.ActorAgentSkills.ComplexAnalysisTasksGC"}}</button></p>{{/if}}
  <div class="skill-filters"><label>{{localize "SPYCRAFT.Template.ActorAgentSkills.FindASkill"}} <input type="search" class="skill-search" placeholder="{{localize 'SPYCRAFT.Template.ActorAgentSkills.NameOrAttribute'}}" aria-label="{{localize 'SPYCRAFT.Template.ActorAgentSkills.FindASkill'}}" /></label><label><input type="checkbox" class="trained-filter" /> {{localize "SPYCRAFT.Template.ActorAgentSkills.TrainedSkillsOnly"}}</label><span class="skill-count" role="status" aria-live="polite"></span></div>
  <p class="play-only hint">{{localize "SPYCRAFT.Template.ActorAgentSkills.ChooseASkillNameOrBonus"}}</p>
  <table class="skills-table">
    <thead><tr>
      <th>{{localize "SPYCRAFT.Skill.Label"}}</th><th class="edit-only" data-tooltip="{{localize 'SPYCRAFT.Skill.ClassOverrideHint'}}">{{localize "SPYCRAFT.Skill.ClassManual"}}</th>
      <th class="edit-only">{{localize "SPYCRAFT.Skill.Points"}}</th><th>{{localize "SPYCRAFT.Skill.Ranks"}}</th><th class="edit-only">{{localize "SPYCRAFT.Skill.Bonus"}}</th>
      <th
        class="edit-only">{{localize "SPYCRAFT.Skill.Misc"}}</th><th>{{localize "SPYCRAFT.Skill.Total"}}</th><th
        data-tooltip="{{localize 'SPYCRAFT.Skill.ThreatHint'}}">{{localize "SPYCRAFT.Skill.ThreatRange"}}</th><th
        data-tooltip="{{localize 'SPYCRAFT.Skill.CapHint'}}">{{localize "SPYCRAFT.Skill.Cap"}} <i
        class="fa-solid fa-circle-question"
        aria-hidden="true"></i></th>
    </tr></thead>
    <tbody>
    {{#each skills}}
      <tr data-skill-name="{{name}} {{abilityLabel}}" data-trained="{{#if ranks}}true{{else}}false{{/if}}" class="{{#if isClass}}class-skill{{/if}} {{#if classAtLevel}}class-at-level{{/if}}">
        <th><button type="button" class="sc2-action" data-action="rollSkill" data-skill="{{key}}" aria-label="{{rollLabel}}">{{name}}</button>{{#if focus}}<span class="sc2-focus-mark" data-tooltip="{{localize 'SPYCRAFT.Skill.FocusHint'}}" aria-label="{{localize 'SPYCRAFT.Skill.FocusHint'}}" tabindex="0">*</span>{{/if}} <span class="muted">{{abilityLabel}}</span></th>
        <td class="edit-only"><input type="checkbox" name="system.skills.{{key}}.classSkill" {{checked classOverride}} aria-label="{{localize 'SPYCRAFT.Action.ClassSkillOf' name=name}}" /></td>
        <td class="edit-only">{{#if ../skillLevel}}<input type="number" name="skillpts.{{key}}" value="{{points}}" class="w-2" min="0" aria-label="{{localize 'SPYCRAFT.Action.SkillPointsIn' name=name}}" />{{/if}}</td>
        <td class="{{#if overMax}}bad{{/if}}">{{ranks}} / {{maxRanks}}{{#if ../skillLevel}}<br class="edit-only"/><small class="muted edit-only">{{localize "SPYCRAFT.Template.ActorAgentSkills.AtLevel"}} {{../skillLevel}}: {{historicalRanks}} / {{purchaseMaxRanks}}</small>{{/if}}</td>
        <td class="edit-only">{{#if bonus}}<span {{sc2tip bonusTip}}>{{signed bonus}}</span>{{/if}}</td>
        <td class="edit-only"><input type="number" name="system.skills.{{key}}.misc" value="{{misc}}" class="w-2" aria-label="{{localize 'SPYCRAFT.Action.MiscModifierOf' name=name}}" /></td>
        <td>{{#each totals}}<button type="button" class="sc2-action" data-action="rollSkill" data-skill="{{../key}}" data-ability="{{ability}}" aria-label="{{rollLabel}}" {{sc2tip tip}}>{{signed total}}</button>{{#unless @last}} / {{/unless}}{{/each}}</td>
        <td><span {{sc2tip threatTip}}>{{threatLabel}}</span></td>
        <td><span {{sc2tip capTip}}>{{capLabel}}</span></td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  <p class="muted edit-only">{{localize "SPYCRAFT.Template.ActorAgentSkills.ChooseVersatilitySkillsOnClassesThe"}}</p>
  <p class="muted hint edit-only">{{localize "SPYCRAFT.Skill.Hint"}}</p>
</section>
