<section class="tab skills {{tab.cssClass}}" data-tab="skills" data-group="primary">
  {{#if skillLevel}}
  <div class="skill-levels edit-only">
    <span>{{localize "SPYCRAFT.Skill.SpendAtLevel"}}:</span>
    {{#each skillLevels}}<a class="lvl {{#if active}}active{{/if}}" data-action="skillLevel" data-level="{{level}}">{{level}}</a>{{/each}}
    <span class="points {{#if (sc2lt skillLevelInfo.remaining 0)}}bad{{/if}}">{{skillLevelInfo.className}}: {{skillLevelInfo.spent}} / {{skillLevelInfo.available}} {{localize "SPYCRAFT.SkillPoints"}}</span>
    {{#if skillLevelInfo.classGrantPoints}}<span class="muted">Includes {{skillLevelInfo.classGrantName}} +{{skillLevelInfo.classGrantPoints}} points</span>{{/if}}
    <span class="muted">{{localize "SPYCRAFT.Skill.MaxRanks"}} {{skillLevelInfo.maxRanks}} · {{localize "SPYCRAFT.Skill.ClassPicks"}} {{system.classSkillPicks.used}}/{{system.classSkillPicks.available}}</span>
  </div>
  {{else}}<p class="muted">{{localize "SPYCRAFT.Skill.NeedLevel"}}</p>{{/if}}
  {{#if isGM}}<p class="edit-only"><button type="button" data-action="manageAnalysisTasks">Complex Analysis Tasks (GC)</button></p>{{/if}}
  <div class="skill-filters"><label>Find a skill <input type="search" class="skill-search" placeholder="Name or attribute…" aria-label="Find a skill" /></label><label><input type="checkbox" class="trained-filter" /> Trained skills only</label><span class="skill-count" role="status" aria-live="polite"></span></div>
  <p class="play-only hint">Choose a skill name or bonus to roll a named check.</p>
  <table class="skills-table">
    <thead><tr>
      <th>{{localize "SPYCRAFT.Skill.Label"}}</th><th class="edit-only" data-tooltip="SPYCRAFT.Skill.ClassOverrideHint">GC override</th>
      <th class="edit-only">{{localize "SPYCRAFT.Skill.Points"}}</th><th>{{localize "SPYCRAFT.Skill.Ranks"}}</th><th class="edit-only">{{localize "SPYCRAFT.Skill.Bonus"}}</th>
      <th class="edit-only">{{localize "SPYCRAFT.Skill.Misc"}}</th><th>{{localize "SPYCRAFT.Skill.Total"}}</th><th>{{localize "SPYCRAFT.Skill.Threat"}}</th><th>{{localize "SPYCRAFT.Skill.Cap"}}</th>
    </tr></thead>
    <tbody>
    {{#each skills}}
      <tr data-skill-name="{{name}} {{abilityLabel}}" data-trained="{{#if ranks}}true{{else}}false{{/if}}" class="{{#if isClass}}class-skill{{/if}} {{#if classAtLevel}}class-at-level{{/if}}">
        <th><a data-action="rollSkill" data-skill="{{key}}">{{name}}{{#if focus}}*{{/if}}</a> <span class="muted">{{abilityLabel}}</span></th>
        <td class="edit-only"><input type="checkbox" name="system.skills.{{key}}.classSkill" {{checked classOverride}} /></td>
        <td class="edit-only">{{#if ../skillLevel}}<input type="number" name="skillpts.{{key}}" value="{{points}}" class="w-2" min="0" />{{/if}}</td>
        <td class="{{#if overMax}}bad{{/if}}">{{ranks}} / {{maxRanks}}{{#if ../skillLevel}}<br class="edit-only"/><small class="muted edit-only">At level {{../skillLevel}}: {{historicalRanks}} / {{purchaseMaxRanks}}</small>{{/if}}</td>
        <td class="edit-only">{{#if bonus}}<span {{sc2tip bonusTip}}>{{signed bonus}}</span>{{/if}}</td>
        <td class="edit-only"><input type="number" name="system.skills.{{key}}.misc" value="{{misc}}" class="w-2" /></td>
        <td>{{#each totals}}<a data-action="rollSkill" data-skill="{{../key}}" data-ability="{{ability}}" {{sc2tip tip}}>{{signed total}}</a>{{#unless @last}} / {{/unless}}{{/each}}</td>
        <td><span {{sc2tip threatTip}}>{{#if (sc2lt threat 20)}}{{threat}}-20{{else}}20{{/if}}</span></td>
        <td><span {{sc2tip capTip}}>{{cap}}</span></td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  <p class="muted edit-only">Choose Versatility skills on Classes. The GC override checkbox is a manual exception; it does not represent a class-specific choice.</p>
  <p class="muted hint edit-only">{{localize "SPYCRAFT.Skill.Hint"}}</p>
</section>
