<section class="tab training {{tab.cssClass}}" data-tab="training" data-group="primary">
  <div class="play-only training-summary">
    <h3>{{localize "SPYCRAFT.Template.ActorAgentTraining.WeaponProficiencies"}}</h3>
    {{#each proficiencies}}{{#if proficient}}<span class="tag">{{label}}{{#if forte}} {{localize "SPYCRAFT.Template.ActorAgentTraining.Forte"}}{{/if}}</span>{{/if}}{{/each}}
    <h3>{{localize "SPYCRAFT.Template.ActorAgentTraining.Focuses"}}</h3>
    {{#each focusGroups}}<p><b>{{label}}:</b> {{#each options}}{{#if checked}}<span class="tag">{{name}}</span>{{/if}}{{/each}}</p>{{/each}}
    <p><b>{{localize "SPYCRAFT.Template.ActorAgentTraining.Profession"}}</b> {{professionText}}</p>
    <h3>{{localize "SPYCRAFT.Template.ActorAgentTraining.SkillFortes"}}</h3><ul class="plain">{{#each system.skillFortes}}<li>{{skill}} · {{focus}} · {{forte}}</li>{{/each}}</ul>
    <h3>{{localize "SPYCRAFT.Template.ActorAgentTraining.Interests"}}</h3><p>{{system.interests}}</p>
    <h3>{{localize "SPYCRAFT.Template.ActorAgentTraining.Contacts"}}</h3><ul class="plain">{{#each system.contacts}}<li><b>{{name}}</b> · {{lookup ../contactGrades rank}} {{notes}}</li>{{else}}<li>{{localize "SPYCRAFT.Template.ActorAgentTraining.NoContactsRecorded"}}</li>{{/each}}</ul>
    <h3>{{localize "SPYCRAFT.Template.ActorAgentTraining.Subplots"}}</h3><ul class="plain">{{#each system.subplots}}<li><b>{{name}}</b>{{#if complete}} {{localize "SPYCRAFT.Template.ActorAgentTraining.Complete"}}{{/if}} {{notes}}</li>{{else}}<li>{{localize "SPYCRAFT.Template.ActorAgentTraining.NoSubplotsRecorded"}}</li>{{/each}}</ul>
    {{#each system.temporaryFocusGrants}}<p>{{name}} <a data-action="chooseTemporaryFocuses" data-item-id="{{itemId}}">{{localize "SPYCRAFT.Template.ActorAgentTraining.ChooseTemporaryFocuses"}}</a></p>{{/each}}
  </div>
  <div class="edit-only">

  <div class="cols">
    <div class="col">
      <h3>{{localize "SPYCRAFT.Proficiencies"}} <span class="points {{#if (sc2lt system.proficiencyPicks.remaining 0)}}bad{{/if}}">{{system.proficiencyPicks.used}} / {{system.proficiencyPicks.available}}</span></h3>
      <table class="profs">
        <thead><tr><th></th><th>{{localize "SPYCRAFT.Proficient"}}</th><th>{{localize "SPYCRAFT.Forte"}}</th></tr></thead>
        <tbody>
        {{#each proficiencies}}
          <tr><th>{{label}}{{#if hint}} <span class="tag" data-tooltip="SPYCRAFT.ProficiencyHint">x</span>{{/if}}</th>
            <td><input type="checkbox" name="system.proficiencies.{{key}}.proficient" {{checked proficient}} {{#if granted}}disabled{{/if}} /></td>
            <td><input type="checkbox" name="system.proficiencies.{{key}}.forte" {{checked forte}} {{#if forteGranted}}disabled{{/if}} /></td></tr>
        {{/each}}
        </tbody>
      </table>
      <h3>{{localize "SPYCRAFT.Interests"}} <span class="points">{{system.interestPicks.used}} / {{system.interestPicks.available}}</span></h3>
      <label>{{localize "SPYCRAFT.Template.ActorAgentTraining.PermanentlyRelinquishedInterestSlots"}} <input type="number" min="0" name="system.relinquishedInterests" value="{{system.relinquishedInterests}}" class="w-2" /></label>
      <p>{{localize "SPYCRAFT.Template.ActorAgentTraining.ApplicableInterestsGrant1Maximum2"}}</p>
      <textarea name="system.interests" rows="3" placeholder="{{localize 'SPYCRAFT.InterestsHint'}}">{{system.interests}}</textarea>
      <label>{{localize "SPYCRAFT.Template.ActorAgentTraining.GCConfirmedCrossroadsTitle"}} <select name="system.crossroadsTitle">{{selectOptions crossroadsTitles selected=system.crossroadsTitle blank="—"}}</select></label>
      {{#if system.crossroads.label}}<p>{{system.crossroads.label}}: +{{system.crossroads.actionDice}} {{localize "SPYCRAFT.Template.ActorAgentTraining.StartingActionDice"}}{{system.crossroads.xpPercent}}{{localize "SPYCRAFT.Template.ActorAgentTraining.MissionXPRequiredLevel"}} {{system.crossroads.level}}, {{system.crossroads.completed}} {{localize "SPYCRAFT.Template.ActorAgentTraining.CompletedSubplotsAndAllLowerTitles"}}</p>{{/if}}
      <h3>{{localize "SPYCRAFT.Subplots"}} <span class="points">{{system.subplotPicks.used}} / {{system.subplotPicks.available}}</span>
        <span class="controls"><a data-action="addRow" data-list="subplots"><i class="fa-solid fa-plus"></i></a></span></h3>
      <ul class="rows">
        {{#each system.subplots}}
          <li><input type="checkbox" name="subplots.{{@index}}.complete" {{checked complete}} />
            <input type="text" name="subplots.{{@index}}.name" value="{{name}}" list="sc2-subplots" />
            <input type="text" name="subplots.{{@index}}.notes" value="{{notes}}" placeholder="{{localize 'SPYCRAFT.Notes'}}" />
            <a data-action="removeRow" data-list="subplots" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></a></li>
        {{/each}}
      </ul>
      {{#if system.subplotPicks.minimum}}<p class="{{#if system.subplotPicks.needsSubplot}}bad{{else}}muted{{/if}}">{{localize "SPYCRAFT.Template.ActorAgentTraining.TroubleMagnetAtLeastOneUnfinished"}} {{system.subplotPicks.inPlay}}{{localize "SPYCRAFT.Template.ActorAgentTraining.NameTheSubplotOrDescribeIt"}}</p>{{/if}}
      <datalist id="sc2-subplots">{{#each config.tables.subplots}}<option value="{{this}}"></option>{{/each}}</datalist>
    </div>
    <div class="col">
      {{#each focusGroups}}
        <h3>{{label}} {{localize "SPYCRAFT.Focuses"}} <span class="points {{#if (sc2lt picks.remaining 0)}}bad{{/if}}">{{picks.used}} / {{picks.available}}</span></h3>
        <div class="focus-list">
          {{#each options}}<label><input type="checkbox" data-action="toggleFocus" data-skill="{{../skill}}" data-value="{{name}}" {{checked checked}} {{#if granted}}disabled{{/if}} /> {{name}}</label>{{/each}}
        </div>
      {{/each}}
      <h3>{{localize "SPYCRAFT.ProfessionFocuses"}} <span class="points">{{system.focusPicks.profession.used}} / {{system.focusPicks.profession.available}}</span></h3>
      <textarea name="professionText" rows="2" placeholder="{{localize 'SPYCRAFT.OnePerLine'}}">{{professionText}}</textarea>
      <h3>{{localize "SPYCRAFT.Template.ActorAgentTraining.SkillFortes"}} <span class="controls"><a data-action="addRow" data-list="skillFortes"><i class="fa-solid fa-plus"></i></a></span></h3>
      <ul class="rows">{{#each system.skillFortes}}<li>
        <select name="skillFortes.{{@index}}.skill">{{selectOptions ../forteSkills selected=skill}}</select>
        <input type="text" name="skillFortes.{{@index}}.focus" value="{{focus}}" placeholder="{{localize 'SPYCRAFT.Template.ActorAgentTraining.OwnedFocus'}}" />
        <input type="text" name="skillFortes.{{@index}}.forte" value="{{forte}}" placeholder="{{localize 'SPYCRAFT.Template.ActorAgentTraining.CountryVehicleTypeTaskGearType'}}" />
        <a data-action="removeRow" data-list="skillFortes" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></a>
      </li>{{/each}}</ul>
      <label>{{localize "SPYCRAFT.Template.ActorAgentTraining.INTModifierAtCareerLevel1"}} <input type="number" name="system.startingIntelligenceModifier" value="{{system.startingIntelligenceModifier}}" class="w-2" /></label>
      <p>{{localize "SPYCRAFT.Template.ActorAgentTraining.FlexiblePicksMayBeSpentOn"}}</p>
      <h3>{{localize "SPYCRAFT.GenericFocuses"}} <span class="points">{{system.focusPicks.generic.used}} / {{system.focusPicks.generic.available}}</span></h3>
      {{#if system.focusPicks.generic.reservedAvailable}}<p>{{localize "SPYCRAFT.Template.ActorAgentTraining.TemporaryDepthOfStudyReserves"}} {{system.focusPicks.generic.reservedAvailable}} {{localize "SPYCRAFT.Template.ActorAgentTraining.PicksUseEachSourceBelowSo"}}</p>{{/if}}
      {{#each system.temporaryFocusGrants}}<fieldset><legend>{{localize "SPYCRAFT.Template.ActorAgentTraining.Temporary"}} {{name}} ({{used}} / {{available}})</legend>
        {{#each choices}}<p>{{skill}}: {{focus}}{{#if forte}} — {{forte}}{{/if}}</p>{{/each}}
        <a data-action="chooseTemporaryFocuses" data-item-id="{{itemId}}">{{localize "SPYCRAFT.Template.ActorAgentTraining.ChooseTwoFocusesFortes"}}</a>
      </fieldset>{{/each}}
      <textarea name="fortesText" rows="2" placeholder="{{localize 'SPYCRAFT.OnePerLine'}}">{{fortesText}}</textarea>
      <h3>{{localize "SPYCRAFT.Contacts"}} <span class="points {{#if (sc2lt system.contactPicks.remaining 0)}}bad{{/if}}">{{system.contactPicks.used}} / {{system.contactPicks.available}}</span>
        <span class="controls"><a data-action="addRow" data-list="contacts"><i class="fa-solid fa-plus"></i></a></span></h3>
      <ul class="rows contact-rows">
        {{#each system.contacts}}
          <li><input type="text" name="contacts.{{@index}}.name" value="{{name}}" placeholder="{{localize 'Name'}}" />
            <select name="contacts.{{@index}}.rank" data-dtype="Number">{{selectOptions ../contactGrades selected=rank}}</select>
            <input type="text" name="contacts.{{@index}}.notes" value="{{notes}}" placeholder="{{localize 'SPYCRAFT.Notes'}}" />
            <a data-action="removeRow" data-list="contacts" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></a>
            {{#if @root.hasContactFeatUpgrades}}<details class="contact-upgrade" data-key="networkingContact{{@index}}"><summary>{{localize "SPYCRAFT.Template.ActorAgentTraining.NewNetworkingContactThemedFeatUpgrade"}}</summary><p>{{localize "SPYCRAFT.Template.ActorAgentTraining.OnlyANewContactGainedAfter"}}</p><label>{{localize "SPYCRAFT.Template.ActorAgentTraining.NetworkingMilestone"}} <select name="contacts.{{@index}}.networkingMilestone" data-dtype="Number">{{selectOptions @root.contactMilestones selected=networkingMilestone}}</select></label><label>{{localize "SPYCRAFT.Template.ActorAgentTraining.ContactFeat"}} <select name="contacts.{{@index}}.networkingFeat">{{selectOptions @root.contactFeatOptions selected=networkingFeat}}</select></label><label>{{localize "SPYCRAFT.Template.ActorAgentTraining.MatchingTheme"}} <input name="contacts.{{@index}}.networkingTheme" maxlength="200" value="{{networkingTheme}}" /></label><label><input name="contacts.{{@index}}.networkingFeatConfirmed" type="checkbox" {{checked networkingFeatConfirmed}} /> {{localize "SPYCRAFT.Template.ActorAgentTraining.GCConfirmsThisNewContactWas"}}</label></details>{{/if}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
  </div>
</section>
