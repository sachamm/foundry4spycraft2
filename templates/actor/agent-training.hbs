<section class="tab training {{tab.cssClass}}" data-tab="training" data-group="primary">
  <div class="play-only training-summary">
    <h3>Weapon proficiencies</h3>
    {{#each proficiencies}}{{#if proficient}}<span class="tag">{{label}}{{#if forte}} · Forte{{/if}}</span>{{/if}}{{/each}}
    <h3>Focuses</h3>
    {{#each focusGroups}}<p><b>{{label}}:</b> {{#each options}}{{#if checked}}<span class="tag">{{name}}</span>{{/if}}{{/each}}</p>{{/each}}
    <p><b>Profession:</b> {{professionText}}</p>
    <h3>Skill fortes</h3><ul class="plain">{{#each system.skillFortes}}<li>{{skill}} · {{focus}} · {{forte}}</li>{{/each}}</ul>
    <h3>Interests</h3><p>{{system.interests}}</p>
    <h3>Contacts</h3><ul class="plain">{{#each system.contacts}}<li><b>{{name}}</b> · {{lookup ../contactGrades rank}} {{notes}}</li>{{else}}<li>No contacts recorded.</li>{{/each}}</ul>
    <h3>Subplots</h3><ul class="plain">{{#each system.subplots}}<li><b>{{name}}</b>{{#if complete}} · Complete{{/if}} {{notes}}</li>{{else}}<li>No subplots recorded.</li>{{/each}}</ul>
    {{#each system.temporaryFocusGrants}}<p>{{name}} <a data-action="chooseTemporaryFocuses" data-item-id="{{itemId}}">Choose temporary focuses</a></p>{{/each}}
  </div>
  <div class="edit-only">

  <div class="cols">
    <div class="col">
      <h3>{{localize "SPYCRAFT.Proficiencies"}} <span class="points {{#if (sc2lt system.proficiencyPicks.remaining 0)}}bad{{/if}}">{{system.proficiencyPicks.used}} / {{system.proficiencyPicks.available}}</span></h3>
      <table class="profs">
        <thead><tr><th></th><th>{{localize "SPYCRAFT.Proficient"}}</th><th>{{localize "SPYCRAFT.Forte"}}</th></tr></thead>
        <tbody>
        {{#each proficiencies}}
          <tr><th>{{label}}{{#if hint}} <span class="tag" data-tooltip="SPYCRAFT.ProficiencyHint">x</span>{{/if}}</th>
            <td><input type="checkbox" name="system.proficiencies.{{key}}.proficient" {{checked proficient}} {{#if granted}}disabled{{/if}} /></td>
            <td><input type="checkbox" name="system.proficiencies.{{key}}.forte" {{checked forte}} {{#if forteGranted}}disabled{{/if}} /></td></tr>
        {{/each}}
        </tbody>
      </table>
      <h3>{{localize "SPYCRAFT.Interests"}} <span class="points">{{system.interestPicks.used}} / {{system.interestPicks.available}}</span></h3>
      <label>Permanently relinquished Interest slots <input type="number" min="0" name="system.relinquishedInterests" value="{{system.relinquishedInterests}}" class="w-2" /></label>
      <p>Applicable Interests grant +1, maximum +2 per check; Interest benefits per session are limited by starting action dice. Relinquished slots are permanently lost (p.53).</p>
      <textarea name="system.interests" rows="3" placeholder="{{localize 'SPYCRAFT.InterestsHint'}}">{{system.interests}}</textarea>
      <label>GC-confirmed Crossroads title <select name="system.crossroadsTitle">{{selectOptions crossroadsTitles selected=system.crossroadsTitle blank="—"}}</select></label>
      {{#if system.crossroads.label}}<p>{{system.crossroads.label}}: +{{system.crossroads.actionDice}} starting action dice; +{{system.crossroads.xpPercent}}% mission XP. Required: level {{system.crossroads.level}}, {{system.crossroads.completed}} completed Subplots and all lower titles (p.54).</p>{{/if}}
      <h3>{{localize "SPYCRAFT.Subplots"}} <span class="points">{{system.subplotPicks.used}} / {{system.subplotPicks.available}}</span>
        <span class="controls"><a data-action="addRow" data-list="subplots"><i class="fa-solid fa-plus"></i></a></span></h3>
      <ul class="rows">
        {{#each system.subplots}}
          <li><input type="checkbox" name="subplots.{{@index}}.complete" {{checked complete}} />
            <input type="text" name="subplots.{{@index}}.name" value="{{name}}" list="sc2-subplots" />
            <input type="text" name="subplots.{{@index}}.notes" value="{{notes}}" placeholder="{{localize 'SPYCRAFT.Notes'}}" />
            <a data-action="removeRow" data-list="subplots" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></a></li>
        {{/each}}
      </ul>
      {{#if system.subplotPicks.minimum}}<p class="{{#if system.subplotPicks.needsSubplot}}bad{{else}}muted{{/if}}">Trouble Magnet: at least one unfinished Subplot must be in play. Recorded: {{system.subplotPicks.inPlay}}. Name the Subplot or describe it in Notes.</p>{{/if}}
      <datalist id="sc2-subplots">{{#each config.tables.subplots}}<option value="{{this}}"></option>{{/each}}</datalist>
    </div>
    <div class="col">
      {{#each focusGroups}}
        <h3>{{label}} {{localize "SPYCRAFT.Focuses"}} <span class="points {{#if (sc2lt picks.remaining 0)}}bad{{/if}}">{{picks.used}} / {{picks.available}}</span></h3>
        <div class="focus-list">
          {{#each options}}<label><input type="checkbox" data-action="toggleFocus" data-skill="{{../skill}}" data-value="{{name}}" {{checked checked}} {{#if granted}}disabled{{/if}} /> {{name}}</label>{{/each}}
        </div>
      {{/each}}
      <h3>{{localize "SPYCRAFT.ProfessionFocuses"}} <span class="points">{{system.focusPicks.profession.used}} / {{system.focusPicks.profession.available}}</span></h3>
      <textarea name="professionText" rows="2" placeholder="{{localize 'SPYCRAFT.OnePerLine'}}">{{professionText}}</textarea>
      <h3>Skill fortes <span class="controls"><a data-action="addRow" data-list="skillFortes"><i class="fa-solid fa-plus"></i></a></span></h3>
      <ul class="rows">{{#each system.skillFortes}}<li>
        <select name="skillFortes.{{@index}}.skill">{{selectOptions ../forteSkills selected=skill}}</select>
        <input type="text" name="skillFortes.{{@index}}.focus" value="{{focus}}" placeholder="Owned focus" />
        <input type="text" name="skillFortes.{{@index}}.forte" value="{{forte}}" placeholder="Country / vehicle type / task / gear type" />
        <a data-action="removeRow" data-list="skillFortes" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></a>
      </li>{{/each}}</ul>
      <label>INT modifier at career level 1 <input type="number" name="system.startingIntelligenceModifier" value="{{system.startingIntelligenceModifier}}" class="w-2" /></label>
      <p>Flexible picks may be spent on any focus or a forte in an owned focus. Only one applicable forte adds +1 to a check (p.98).</p>
      <h3>{{localize "SPYCRAFT.GenericFocuses"}} <span class="points">{{system.focusPicks.generic.used}} / {{system.focusPicks.generic.available}}</span></h3>
      {{#if system.focusPicks.generic.reservedAvailable}}<p>Temporary Depth of Study reserves {{system.focusPicks.generic.reservedAvailable}} picks. Use each source below so its choices expire with the feat.</p>{{/if}}
      {{#each system.temporaryFocusGrants}}<fieldset><legend>Temporary {{name}} ({{used}} / {{available}})</legend>
        {{#each choices}}<p>{{skill}}: {{focus}}{{#if forte}} — {{forte}}{{/if}}</p>{{/each}}
        <a data-action="chooseTemporaryFocuses" data-item-id="{{itemId}}">Choose two focuses / fortes</a>
      </fieldset>{{/each}}
      <textarea name="fortesText" rows="2" placeholder="{{localize 'SPYCRAFT.OnePerLine'}}">{{fortesText}}</textarea>
      <h3>{{localize "SPYCRAFT.Contacts"}} <span class="points {{#if (sc2lt system.contactPicks.remaining 0)}}bad{{/if}}">{{system.contactPicks.used}} / {{system.contactPicks.available}}</span>
        <span class="controls"><a data-action="addRow" data-list="contacts"><i class="fa-solid fa-plus"></i></a></span></h3>
      <ul class="rows contact-rows">
        {{#each system.contacts}}
          <li><input type="text" name="contacts.{{@index}}.name" value="{{name}}" placeholder="{{localize 'Name'}}" />
            <select name="contacts.{{@index}}.rank" data-dtype="Number">{{selectOptions ../contactGrades selected=rank}}</select>
            <input type="text" name="contacts.{{@index}}.notes" value="{{notes}}" placeholder="{{localize 'SPYCRAFT.Notes'}}" />
            <a data-action="removeRow" data-list="contacts" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></a>
            {{#if @root.hasContactFeatUpgrades}}<details class="contact-upgrade" data-key="networkingContact{{@index}}"><summary>New Networking contact: themed feat upgrade</summary><p>Only a new contact gained after taking the selected feat enters play as an associate. This does not upgrade an existing contact or grant the initial associate's time/error benefits.</p><label>Networking milestone <select name="contacts.{{@index}}.networkingMilestone" data-dtype="Number">{{selectOptions @root.contactMilestones selected=networkingMilestone}}</select></label><label>Contact feat <select name="contacts.{{@index}}.networkingFeat">{{selectOptions @root.contactFeatOptions selected=networkingFeat}}</select></label><label>Matching theme <input name="contacts.{{@index}}.networkingTheme" maxlength="200" value="{{networkingTheme}}" /></label><label><input name="contacts.{{@index}}.networkingFeatConfirmed" type="checkbox" {{checked networkingFeatConfirmed}} /> GC confirms this new contact was gained through Networking after taking the feat and has its matching theme</label></details>{{/if}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
  </div>
</section>
