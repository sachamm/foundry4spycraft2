<section class="npc-builder">
  <p class="hint">{{localize "SPYCRAFT.NpcDefense.BuiltInChoice"}}</p>
  {{#if npc.drainedBuildNote}}<p class="hint">{{localize "SPYCRAFT.Drained.NPCBuild"}}</p>{{/if}}
  {{#if isGM}}{{#if editable}}
  <details><summary>{{localize "SPYCRAFT.CampaignGear.CreationRules"}}</summary>
    <button type="button" data-action="reviewCreationPolicy">{{localize "SPYCRAFT.CampaignGear.ReviewCreationRules"}}</button>
    {{#if system.startingAttributeReview}}
    <button type="button" data-action="reviewStartingAttributes">{{localize "SPYCRAFT.CampaignGear.ReviewStartingAttributes"}}</button>
    {{/if}}
  </details>
  {{#if actor.flags.spycraft2.triggeredAttacks}}
  <button type="button" data-action="reviewTriggeredAttacks">{{localize "SPYCRAFT.Review.ExtraAttackClaims"}}</button>
  {{/if}}
  {{/if}}{{/if}}
  <div class="npc-builder-title"><h2>{{localize "SPYCRAFT.Template.ActorNpcBuilder.NPCCreation"}}</h2>{{#if editable}}<button type="button" data-action="npcEnable">{{#if system.npcProfile.enabled}}{{localize "SPYCRAFT.Template.ActorNpcBuilder.UseManualStatBlock"}}{{else}}{{localize "SPYCRAFT.Template.ActorNpcBuilder.UseGradedNPCCreation"}}{{/if}}</button>{{/if}}</div>
  {{#if system.npcProfile.enabled}}
  {{#if npcPackages}}
  <fieldset><legend>{{npcPackages.current}}: {{npcPackages.label}}</legend>
    <p class="npc-note">{{npcPackages.note}}</p>
    {{#if isGM}}{{#if editable}}<button type="button" data-action="npcPackages">{{npcPackages.preview}}</button><button type="button" data-action="npcPackageBands">{{npcPackages.bands}}</button>{{/if}}{{/if}}
  </fieldset>
  {{/if}}
  <p class="npc-note">{{localize "SPYCRAFT.Template.ActorNpcBuilder.ChooseGradesListedSkillsEquipmentPicks"}}</p>
  <fieldset {{#unless editable}}disabled{{/unless}}>
    <div class="npc-controls">
      <label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.NPCTier"}} <select name="system.npcProfile.tier" data-dtype="Number">{{selectOptions npc.tierOptions selected=npc.profile.tier}}</select></label>
      <label><input type="checkbox" name="system.npcProfile.group" {{checked npc.profile.group}} /> {{localize "SPYCRAFT.Template.ActorNpcBuilder.NPCGroup"}}</label>
      <strong>{{localize "SPYCRAFT.Template.ActorNpcBuilder.EffectiveTL"}} {{npc.result.effectiveLevel}}</strong>
    </div>
    <div class="npc-grade-grid">{{#each npc.grades}}<label>{{label}}<select name="system.npcProfile.grades.{{key}}" data-dtype="Number">{{selectOptions options selected=value}}</select></label>{{/each}}</div>
  </fieldset>
  {{#if npc.result.warnings}}<ul class="npc-warnings" role="status">{{#each npc.result.warnings}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  <fieldset {{#unless editable}}disabled{{/unless}}>
    <div class="npc-section-title"><h3>{{localize "SPYCRAFT.Template.ActorNpcBuilder.ListedSkillsSkilledQuality"}}</h3><button type="button" data-action="npcAddSkill">{{localize "SPYCRAFT.Template.ActorNpcBuilder.AddSkill"}}</button></div>
    <p class="npc-note">{{localize "SPYCRAFT.Template.ActorNpcBuilder.UseTheHigherOfTheListed"}}</p>
    {{#each npc.skills}}<div class="npc-row">
      <select aria-label="{{localize 'SPYCRAFT.Template.ActorNpcBuilder.ListedSkill'}}" name="npcSkill.{{index}}.key">{{selectOptions ../npc.skillOptions selected=key}}</select>
      <select aria-label="{{localize 'SPYCRAFT.Template.ActorNpcBuilder.SkillGrade'}}" name="npcSkill.{{index}}.grade" data-dtype="Number">{{selectOptions ../npc.gradeOptions selected=grade}}</select>
      <span>{{localize "SPYCRAFT.Template.ActorNpcBuilder.Bonus"}} <b data-tooltip="{{localize 'SPYCRAFT.Action.StandardValue' value=(signed resolved.normalBonus) state=resolved.skillCondition.state}}">{{signed resolved.bonus}}</b> {{localize "SPYCRAFT.Template.ActorNpcBuilder.Cap"}} {{resolved.cap}} · {{grade}} {{localize "SPYCRAFT.Template.ActorNpcBuilder.XP"}}</span>
      <button type="button" data-action="npcRemoveRow" data-list="skills" data-index="{{index}}" aria-label="{{localize 'SPYCRAFT.Template.ActorNpcBuilder.RemoveListedSkill'}}">{{localize "SPYCRAFT.Template.ActorNpcBuilder.Remove"}}</button>
    </div>{{/each}}
    <div class="npc-section-title"><h3>{{localize "SPYCRAFT.Template.ActorNpcBuilder.EquipmentAllowances"}}</h3></div>
    <p class="npc-note">{{localize "SPYCRAFT.Template.ActorNpcBuilder.StartsWithOneCaliberIWeapon"}}</p>
    {{#if npc.organizationOptions}}<label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.Organization"}}
      <select name="system.npcProfile.organization">{{selectOptions npc.organizationOptions selected=npc.profile.organization}}</select></label>
    {{#if npc.result.organizationCaps}}<p class="npc-note">{{npc.organizationCapsNote}}</p>{{/if}}{{/if}}
    {{#each npc.equipment}}<div class="npc-equipment"><strong>{{category}}</strong>
      {{#each picks}}<label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.Caliber"}} <select aria-label="{{category}} pick Caliber" name="npcPick.{{category}}.{{index}}" data-dtype="Number">{{selectOptions ../../npc.caliberOptions selected=caliber}}</select><button type="button" data-action="npcRemoveRow" data-list="equipment" data-category="{{category}}" data-index="{{index}}" aria-label="{{localize 'SPYCRAFT.Action.RemovePick' category=category}}">×</button>{{#if budget}} <span class="npc-note">{{budget}}</span>{{/if}}</label>{{/each}}
      <button type="button" data-action="npcAddPick" data-category="{{category}}">{{localize "SPYCRAFT.Template.ActorNpcBuilder.AddPick"}}</button>
    </div>{{/each}}
    <label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.AdditionalAmmunitionPairs"}} <input type="number" min="0" max="100" name="system.npcProfile.extraAmmoPairs" value="{{npc.profile.extraAmmoPairs}}" data-dtype="Number" /></label>
    <p class="npc-note">{{npc.result.ammoPerWeapon}} {{localize "SPYCRAFT.Template.ActorNpcBuilder.StartingStockpileSPerWeaponEach"}}</p>
    <div class="npc-section-title"><h3>{{localize "SPYCRAFT.Template.ActorNpcBuilder.NPCQualities"}}</h3><button type="button" data-action="npcAddQuality">{{localize "SPYCRAFT.Template.ActorNpcBuilder.AddQuality"}}</button></div>
    {{#each npc.qualities}}<div class="npc-quality">
      <div class="npc-row"><select aria-label="{{localize 'SPYCRAFT.Template.ActorNpcBuilder.NPCQuality'}}" name="npcQuality.{{index}}.id">{{selectOptions ../npc.qualityOptions selected=id}}</select><label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.Units"}} <input type="number" min="1" max="100" name="npcQuality.{{index}}.units" value="{{units}}" data-dtype="Number" /></label><button type="button" data-action="npcRemoveRow" data-list="qualities" data-index="{{index}}">{{localize "SPYCRAFT.Template.ActorNpcBuilder.Remove"}}</button></div>
      <small>{{rule.costLabel}} · p.{{rule.page}}</small>
      {{#if caliberCost}}<label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.Caliber"}} <select name="npcQuality.{{index}}.caliber" data-dtype="Number">{{selectOptions ../npc.caliberOptions selected=caliber}}</select></label>{{/if}}
      {{#if classLevel}}<label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.LowestClassLevelGrantingTheAbility"}} <input type="number" min="1" max="20" name="npcQuality.{{index}}.level" value="{{level}}" data-dtype="Number" /></label>{{/if}}
      {{#if decision}}<label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.DecisionModifier5To5"}} <input type="number" min="-5" max="5" name="npcQuality.{{index}}.modifier" value="{{modifier}}" data-dtype="Number" /></label>{{/if}}
      {{#if linked}}<label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.OriginalLinkedQualityCost"}} <input type="number" min="0" name="npcQuality.{{index}}.linkedCost" value="{{linkedCost}}" data-dtype="Number" /></label><small>{{localize "SPYCRAFT.Template.ActorNpcBuilder.ReplacesTheLinkedQualityCostDo"}}</small>{{/if}}
      {{#if movement}}<label><input type="checkbox" name="npcQuality.{{index}}.limited" {{checked limited}} /> {{localize "SPYCRAFT.Template.ActorNpcBuilder.LimitedToOneOrTwoMovement"}}</label>{{/if}}
      <input type="text" aria-label="{{localize 'SPYCRAFT.Template.ActorNpcBuilder.QualityDetails'}}" name="npcQuality.{{index}}.details" value="{{details}}" placeholder="{{localize 'SPYCRAFT.Template.ActorNpcBuilder.ChosenFeatAbilityTerrainItemDamage'}}" />
    </div>{{/each}}
  </fieldset>
  <details class="npc-xp" open><summary>{{localize "SPYCRAFT.Template.ActorNpcBuilder.XPCalculation"}} {{#if npc.result.complete}}— {{npc.result.xp}} {{localize "SPYCRAFT.Template.ActorNpcBuilder.XP"}}{{else}}{{localize "SPYCRAFT.Template.ActorNpcBuilder.CorrectTheWarningsAbove"}}{{/if}}</summary>
    <table><thead><tr><th>{{localize "SPYCRAFT.Template.ActorNpcBuilder.Component"}}</th><th>{{localize "SPYCRAFT.Template.ActorNpcBuilder.XP"}}</th></tr></thead><tbody>{{#each npc.result.breakdown}}<tr><td>{{label}}</td><td>{{signed xp}}</td></tr>{{/each}}</tbody></table>
    {{#if npc.result.complete}}<p><b>{{localize "SPYCRAFT.Template.ActorNpcBuilder.NPCReward"}} {{npc.result.xp}} {{localize "SPYCRAFT.Template.ActorNpcBuilder.XPMissionContribution"}} {{npc.result.missionXP}} {{localize "SPYCRAFT.Template.ActorNpcBuilder.XP2"}}{{npc.result.multiplier}})</b></p>{{/if}}
    <p class="npc-note">{{localize "SPYCRAFT.Template.ActorNpcBuilder.QualityReductionsCannotLowerTheStatistic"}}</p>
  </details>
  {{#if npc.result.manual}}<details><summary>{{localize "SPYCRAFT.Template.ActorNpcBuilder.GCAdjudicationSourceNotes"}}</summary><ul>{{#each npc.result.manual}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}
  <details><summary>{{localize "SPYCRAFT.Template.ActorNpcBuilder.CoreRulesTablesPp443452"}}</summary>
    <p class="npc-note">{{npc.source.title}} {{localize "SPYCRAFT.Template.ActorNpcBuilder.Tables711And713"}}</p>
    {{#each npc.referenceTables}}<details><summary>{{label}}</summary><div class="npc-table-scroll"><table><thead><tr><th>{{localize "SPYCRAFT.Template.ActorNpcBuilder.GradeTL"}}</th>{{#each ../npc.levels}}<th>{{this}}</th>{{/each}}</tr></thead><tbody>{{#each rows}}<tr><th>{{grade}}</th>{{#each values}}<td>{{this}}</td>{{/each}}</tr>{{/each}}</tbody></table></div></details>{{/each}}
    <h4>{{localize "SPYCRAFT.Template.ActorNpcBuilder.QualityCosts"}}</h4><table><thead><tr><th>{{localize "SPYCRAFT.Template.ActorNpcBuilder.Quality"}}</th><th>{{localize "SPYCRAFT.Template.ActorNpcBuilder.CostRestriction"}}</th><th>{{localize "SPYCRAFT.Template.ActorNpcBuilder.Page"}}</th></tr></thead><tbody>{{#each npc.catalog}}<tr><td>{{name}}</td><td>{{costLabel}}</td><td>{{page}}</td></tr>{{/each}}</tbody></table>
    <p class="npc-note">{{localize "SPYCRAFT.Template.ActorNpcBuilder.TierITL4IITL"}}</p>
    {{#each npc.source.notes}}<p class="npc-note">{{this}}</p>{{/each}}
  </details>
  {{else}}<p class="npc-note">{{localize "SPYCRAFT.Template.ActorNpcBuilder.ManualModePreservesExistingNPCStat"}}</p>{{/if}}
</section>
