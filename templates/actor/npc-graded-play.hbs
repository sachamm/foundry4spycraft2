{{!-- Graded NPC statistics used in play; the builder that sets them is in npc-builder.hbs. --}}
<div class="npc-graded-play">
  <div class="npc-results" aria-live="polite">
    <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Template.ActorNpcBuilder.Initiative"}}</span><b class="sc2-value">{{signed system.initiative.total}}</b></div>
    <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Template.ActorNpcBuilder.AttackBase"}}</span><b class="sc2-value">{{signed system.bab}}</b></div>
    <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Template.ActorNpcBuilder.Defense"}}</span><b class="sc2-value">{{system.defense.total}}</b></div>
    <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Template.ActorNpcBuilder.ResilienceBase"}}</span><b class="sc2-value">{{signed npc.result.stats.resilience}}</b></div>
    {{#unless npc.animal}}<div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Template.ActorNpcBuilder.Competence"}}</span><b class="sc2-value" data-tooltip="Standard {{signed npc.result.normalCompetence}}; {{npc.result.competenceCondition.state}}">{{signed npc.result.competence}}</b></div>{{/unless}}
    {{#if npc.special}}<div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Template.ActorNpcBuilder.VitalityMax"}}</span><b class="sc2-value">{{system.vitality.max}}</b></div><div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Template.ActorNpcBuilder.WoundsMax"}}</span><b class="sc2-value">{{system.wounds.max}}</b></div>
    {{else}}<div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Template.ActorNpcBuilder.DamageSave"}}</span><b class="sc2-value">{{signed system.damageSave}}</b></div>{{/if}}
    {{#if system.conditionContext.incompetent}}<p class="npc-note bad">{{localize "SPYCRAFT.Template.ActorNpcBuilder.IncompetentSkillBonuses0"}}</p>{{else}}{{#if system.conditionContext.baffled}}<p class="npc-note bad">{{localize "SPYCRAFT.Template.ActorNpcBuilder.BaffledHalfSkillCompetenceBonusesRound"}}</p>{{/if}}{{/if}}{{#if system.conditionContext.baffled}}<p class="npc-note bad">{{localize "SPYCRAFT.Template.ActorNpcBuilder.8SavesResistingBaffled"}}</p>{{/if}}
  </div>
  {{#if npc.special}}<div class="resources"><label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.CurrentVitality"}} <input type="number" name="system.vitality.value" value="{{system.vitality.value}}" /></label><label>{{localize "SPYCRAFT.Template.ActorNpcBuilder.CurrentWounds"}} <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" /></label></div>{{/if}}
  {{#if npc.skills.length}}<p class="npc-skill-line"><b>{{localize "SPYCRAFT.Template.ActorNpcBuilder.Skills"}}</b> {{#each npc.skills}}{{lookup ../npc.skillOptions key}} {{signed resolved.bonus}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
  <p><a data-action="applyBaffled">{{localize "SPYCRAFT.Template.ActorNpcBuilder.ApplyNewBaffledEffect"}}</a> <a data-action="setNpcSkillCondition" data-condition="baffled">{{localize "SPYCRAFT.Template.ActorNpcBuilder.ReviewBaffledState"}}</a> <a data-action="setNpcSkillCondition" data-condition="incompetent">{{localize "SPYCRAFT.Template.ActorNpcBuilder.ReviewIncompetentState"}}</a>{{#if system.baffledApplicationReview.needsReview}} <a data-action="reviewBaffledApplication">{{localize "SPYCRAFT.Template.ActorNpcBuilder.GCReviewInterruptedBaffledEffect"}}</a>{{/if}}</p>
</div>
