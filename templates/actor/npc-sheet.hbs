<section class="spycraft2-sheet npc">
<p><a data-action="manageTakedown">{{localize "SPYCRAFT.Template.ActorNpcSheet.TakedownSavesOutcomes"}}</a> · <a data-action="manageCheapShots">{{localize "SPYCRAFT.Template.ActorNpcSheet.CheapShotOutcomesRecovery"}}</a> · <a data-action="applyShaken">{{localize "SPYCRAFT.Template.ActorNpcSheet.ApplyANewShakenSource"}}</a></p>
{{#if actor.shakenApplicationReview.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorNpcSheet.InterruptedShakenApplicationNeedsGCReview"}} {{#if isGM}}<a data-action="reviewShakenApplication">{{localize "SPYCRAFT.Template.ActorNpcSheet.ReviewActualSourceEffects"}}</a>{{/if}}</p>{{/if}}
{{#each actor.shakenSourceEntries}}<p>{{name}} {{localize "SPYCRAFT.Template.ActorNpcSheet.Grade"}} {{grade}}{{#unless active}} {{localize "SPYCRAFT.Template.ActorNpcSheet.EndedOrDisabled"}}{{/unless}}{{#if editable}} · <a data-action="editShakenSource" data-source-uuid="{{uuid}}">{{localize "SPYCRAFT.Template.ActorNpcSheet.EditOrEndThisSource"}}</a>{{/if}}</p>{{/each}}
{{#each shakenInitiativeReviews}}<p class="bad">{{name}}{{localize "SPYCRAFT.Template.ActorNpcSheet.InitiativeCount"}} {{count}} {{localize "SPYCRAFT.Template.ActorNpcSheet.NeedsShakenReview"}} {{reason}} {{#if @root.isGM}}<a data-action="reviewShakenInitiative" data-combat-id="{{combatId}}" data-combatant-id="{{id}}">{{localize "SPYCRAFT.Template.ActorNpcSheet.ReviewIncludedPenalty"}}</a>{{/if}}</p>{{/each}}
{{#each system.cheapShotActive}}<p class="bad">{{localize "SPYCRAFT.Template.ActorNpcSheet.CheapShot"}} {{#if (sc2eq choice "speed")}}{{localize "SPYCRAFT.Template.ActorNpcSheet.Speed10FtApplyToThe"}}{{else}}{{choice}} {{localize "SPYCRAFT.Template.ActorNpcSheet.AttackSkillChecks2"}}{{/if}}{{localize "SPYCRAFT.Template.ActorNpcSheet.EndsWithTheSceneOrA"}}</p>{{/each}}
<div class="dossier-band" aria-hidden="true">
  <img class="agency-seal" src="systems/spycraft2/assets/retro/agency-seal.svg" alt="" />
  <span class="file-label">{{localize "SPYCRAFT.Retro.SubjectDossier"}}</span>
  <span class="file-stamp">{{localize "SPYCRAFT.Retro.Classified"}}</span>
</div>
  <header class="sheet-header">
    <img class="portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}" />
    <div class="header-main">
      <input class="name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}" />
      <div class="summary">
        <label>{{localize "SPYCRAFT.ThreatLevel"}} <input name="system.threatLevel" type="number" value="{{system.threatLevel}}" class="w-2" /></label>
        <select name="system.npcType">{{selectOptions npcTypes selected=system.npcType}}</select>
        <label title="{{localize 'SPYCRAFT.Template.ActorNpcSheet.UseTheActiveMissionSThreat'}}"><input type="checkbox" name="system.followMission" {{checked system.followMission}} /> {{localize "SPYCRAFT.Template.ActorNpcSheet.FollowMissionTL"}}{{#if system.usesMissionThreatLevel}} ({{system.effectiveThreatLevel}}){{/if}}</label>
      </div>
      {{#unless system.npcProfile.enabled}}<div class="resources">
        <label>{{localize "SPYCRAFT.Vitality"}} <input name="system.vitality.value" type="number" value="{{system.vitality.value}}" /> / <input name="system.vitality.max" type="number" value="{{system.vitality.max}}" /></label>
        <label>{{localize "SPYCRAFT.Wounds"}} <input name="system.wounds.value" type="number" value="{{system.wounds.value}}" /> / <input name="system.wounds.max" type="number" value="{{system.wounds.max}}" /></label>
      </div>{{/unless}}
    </div>
  </header>
  <div class="npc-play">
    {{#if gcPlay.special}}{{#unless system.npcProfile.enabled}}<p><label>{{localize "SPYCRAFT.Template.ActorNpcSheet.VillainRoleSetsTheGCS"}} <select name="system.manualRole">{{selectOptions manualRoles selected=system.manualRole}}</select></label></p>{{/unless}}{{/if}}
    <p><a data-action="rollNpcSkill">{{localize "SPYCRAFT.Template.ActorNpcSheet.SkillCheck"}}</a> · <a data-action="manageDisposition">{{localize "SPYCRAFT.Template.ActorNpcSheet.Disposition"}}{{gcPlay.baseDisposition}}{{#each gcPlay.dispositions}}; {{name}}: {{grade}}{{/each}})</a>{{#if system.promoted}} · <b>{{localize "SPYCRAFT.Template.ActorNpcSheet.PromotedToSpecialForThisMission"}}</b> <a data-action="endPromotion">{{localize "SPYCRAFT.Template.ActorNpcSheet.End"}}</a>{{/if}}</p>
    {{#unless gcPlay.special}}<p>{{localize "SPYCRAFT.Template.ActorNpcSheet.DamageSave"}} {{signed gcPlay.damage.bonus}} {{localize "SPYCRAFT.Template.ActorNpcSheet.AccumulatedDamage"}} {{gcPlay.damage.track.accumulated}} {{localize "SPYCRAFT.Template.ActorNpcSheet.NextDC"}} {{gcPlay.damage.nextDC}}{{localize "SPYCRAFT.Template.ActorNpcSheet.FailedSaves"}} {{gcPlay.damage.track.failures}}{{#if gcPlay.damage.tough}} {{localize "SPYCRAFT.Template.ActorNpcSheet.Tough"}} {{gcPlay.damage.tough}} {{localize "SPYCRAFT.Template.ActorNpcSheet.Used"}} {{gcPlay.damage.track.ignored}}){{/if}} · <b>{{gcPlay.damage.track.state}}</b>
      · <a data-action="npcDamageSave">{{localize "SPYCRAFT.Template.ActorNpcSheet.SufferDamage"}}</a> · <a data-action="resetDamageTrack">{{localize "SPYCRAFT.Template.ActorNpcSheet.Reset"}}</a>
      <label>{{localize "SPYCRAFT.Template.ActorNpcSheet.SaveAdjustmentVitalityWoundEffectsP"}} <input name="system.damageSaveAdjust" type="number" value="{{system.damageSaveAdjust}}" class="w-2" /></label>
      {{#unless system.npcProfile.enabled}}<label>{{localize "SPYCRAFT.Template.ActorNpcSheet.VillainRole"}} <select name="system.manualRole">{{selectOptions manualRoles selected=system.manualRole}}</select></label>
      <label>{{localize "SPYCRAFT.Template.ActorNpcSheet.DamageSaveBonus"}} <input name="system.manualDamageSave" type="number" value="{{system.manualDamageSave}}" class="w-2" /></label>{{/unless}}</p>{{/unless}}
  </div>
  {{> "systems/spycraft2/templates/actor/npc-builder.hbs"}}
  {{#if system.qualityEffects.notes.length}}<div class="npc-qualities-play">
    <h3>{{localize "SPYCRAFT.Template.ActorNpcSheet.QualitiesInPlay"}}</h3>
    <p>{{localize "SPYCRAFT.Template.ActorNpcSheet.Speed"}} {{system.qualityEffects.speed}} {{localize "SPYCRAFT.Template.ActorNpcSheet.Ft"}}{{#if system.qualityEffects.flySpeed}}, {{localize "SPYCRAFT.Template.ActorNpcSheet.Flying"}} {{system.qualityEffects.flySpeed}} {{localize "SPYCRAFT.Template.ActorNpcSheet.Ft"}}{{/if}} · {{localize "SPYCRAFT.Template.ActorNpcSheet.Size"}} {{system.qualityEffects.size}}{{#if system.qualityEffects.damageReduction}} · {{localize "SPYCRAFT.Template.ActorNpcSheet.DamageReduction"}} {{system.qualityEffects.damageReduction}}{{/if}}</p>
    <ul>{{#each system.qualityEffects.notes}}<li><b>{{name}}</b> — {{text}} <small>(p.{{page}})</small></li>{{/each}}</ul>
    {{#each system.qualityEffects.saveCalls}}<p><a data-action="callQualitySave" data-id="{{id}}">{{localize "SPYCRAFT.Template.ActorNpcSheet.CallForTheSave"}}: {{name}} ({{localize "SPYCRAFT.Template.ActorNpcSheet.WillDC"}} {{dc}})</a></p>{{/each}}
  </div>{{/if}}
  <div class="abilities-row">
    {{#each abilities}}
      <div class="ability"><a data-action="rollAbility" data-ability="{{key}}">{{label}}</a>
        <input name="system.abilities.{{key}}.value" type="number" value="{{value}}" class="w-2" /> <span class="mod">{{signed mod}}</span></div>
    {{/each}}
  </div>
  {{#unless system.npcProfile.enabled}}
  <div class="stat-grid">
    <div class="stat"><span>{{localize "SPYCRAFT.BAB"}}</span><input name="system.bab" type="number" value="{{system.bab}}" class="w-2" /></div>
    {{#each saves}}<div class="stat"><a data-action="rollSave" data-save="{{key}}">{{label}}</a><input name="system.saves.{{key}}.base" type="number" value="{{base}}" class="w-2" /><b>{{signed total}}</b></div>{{/each}}
    <div class="stat"><span>{{localize "SPYCRAFT.Defense"}}</span><input name="system.defense.bonus" type="number" value="{{system.defense.bonus}}" class="w-2" /><b>{{system.defense.total}}</b></div>
    <div class="stat"><span>{{localize "SPYCRAFT.Initiative"}}</span><input name="system.initiative.bonus" type="number" value="{{system.initiative.bonus}}" class="w-2" /><b>{{signed system.initiative.total}}</b></div>
  </div>
  {{/unless}}
  <h3>{{localize "SPYCRAFT.Weapons"}}</h3>
  <ul class="item-list compact">
    {{#each weapons}}<li data-item-id="{{item.id}}"><a data-action="rollAttack" class="name">{{item.name}} {{signed attack.total}}</a> <a data-action="rollDamage">{{item.system.damage}}</a>
      <span class="controls"><a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a> <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></span></li>{{/each}}
  </ul>
  <h3>{{localize "SPYCRAFT.Items"}}</h3>
  <ul class="item-list compact">
    {{#each otherItems}}<li data-item-id="{{id}}"><a data-action="itemEdit" class="name">{{name}}</a> <span class="muted">{{localize (concat "TYPES.Item." type)}}</span>
      <span class="controls"><a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></span></li>{{/each}}
  </ul>
  {{#if editable}}<prose-mirror name="system.biography" value="{{system.biography}}">{{{enrichedBiography}}}</prose-mirror>{{else}}{{{enrichedBiography}}}{{/if}}
</section>
