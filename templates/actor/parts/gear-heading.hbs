{{!-- A gear section heading with Browse and Add. Hash: title, type, browse, add (translation keys and item type). --}}
<h3>{{localize title}} <span class="controls"><a data-action="browse" data-type="{{type}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize browse}}</a> <a data-action="createItem" data-type="{{type}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize add}}</a></span></h3>
