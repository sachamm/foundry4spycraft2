{{!-- A gear section heading with Browse and Add. Hash: title, type, browse, add (translation keys and item type). --}}
<h3>{{localize title}} <span class="controls"><button type="button" class="sc2-action" data-action="browse" data-type="{{type}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize browse}}</button> <button type="button" class="sc2-action" data-action="createItem" data-type="{{type}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize add}}</button></span></h3>
