{{!-- Row controls on an inventory table: Equip (armor) or Share, then Remove in edit mode. Hash: kind ("equip" or "share"), always given so a row field of the same name never decides it. --}}
<td class="controls" data-sc2-display="icon">{{#if (sc2eq kind "equip")}}<a data-action="itemEquip" aria-pressed="{{item.system.equipped}}" aria-label="{{#if item.system.equipped}}Unequip{{else}}Equip{{/if}} {{item.name}}">{{#if item.system.equipped}}{{localize "SPYCRAFT.Template.ActorAgentGear.Unequip"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentGear.Equip"}}{{/if}}</a>{{else}}<a data-action="itemChat" aria-label="Share {{item.name}} in chat">{{localize "SPYCRAFT.Template.ActorAgentGear.Share"}}</a>{{/if}} <a class="edit-only" data-action="itemDelete" aria-label="Remove {{item.name}}">{{localize "SPYCRAFT.Template.ActorAgentGear.Remove"}}</a></td>
