{{!-- Row controls on an inventory table: Equip (armor) or Share, then Remove in edit mode. Hash: kind ("equip" or "share"), always given so a row field of the same name never decides it. --}}
<td class="controls" data-sc2-display="icon">{{#if (sc2eq kind "equip")}}<button type="button" class="sc2-action" data-action="itemEquip" aria-pressed="{{item.system.equipped}}" aria-label="{{#if item.system.equipped}}{{localize 'SPYCRAFT.Action.UnequipNamed' name=item.name}}{{else}}{{localize 'SPYCRAFT.Action.EquipNamed' name=item.name}}{{/if}}">{{#if item.system.equipped}}{{localize "SPYCRAFT.Template.ActorAgentGear.Unequip"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentGear.Equip"}}{{/if}}</button>{{else}}<button type="button" class="sc2-action" data-action="itemChat" aria-label="{{localize 'SPYCRAFT.Action.ShareNamed' name=item.name}}">{{localize "SPYCRAFT.Template.ActorAgentGear.Share"}}</button>{{/if}} <button type="button" class="edit-only sc2-action" data-action="itemDelete" aria-label="{{localize 'SPYCRAFT.Action.RemoveNamed' name=item.name}}">{{localize "SPYCRAFT.Template.ActorAgentGear.Remove"}}</button></td>
