{{!-- Contagions, fire and the other damage types at work on a character; shared by the agent and NPC sheets. --}}
<div class="hazards">
  <p><b>{{localize "SPYCRAFT.Template.ActorAgentMain.Hazards"}}</b> <a data-action="exposeToContagion">{{localize "SPYCRAFT.Template.ActorAgentMain.ExposeToAContagion"}}</a> <a data-action="exposeToFire">{{localize "SPYCRAFT.Template.ActorAgentMain.FireDamage"}}</a> <a data-action="sufferTypedDamage">{{localize "SPYCRAFT.Template.ActorAgentMain.OtherDamageTypes"}}</a> <a data-action="survivalSave">{{localize "SPYCRAFT.Template.ActorAgentMain.SurvivalSave"}}</a></p>
  {{#each hazards.contagions}}<p class="hazard{{#if due}} due{{/if}}">{{label}}{{#if doses}} ×{{doses}}{{/if}} — {{phase}}, {{localize "SPYCRAFT.Template.ActorAgentMain.FortitudeDC"}} {{dc}} ({{effect}}); {{#if due}}<b>{{localize "SPYCRAFT.Template.ActorAgentMain.SaveDueNow"}}</b>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.SaveDueIn"}} {{dueIn}}{{/if}} <a data-action="rollContagionSave" data-id="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentMain.RollTheSave"}}</a> <a data-action="cureHazard" data-id="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentMain.AntidoteOrEnd"}}</a></p>{{/each}}
  {{#if hazards.fire}}<p class="hazard due"><b>{{localize "SPYCRAFT.Template.ActorAgentMain.OnFire"}}</b> {{hazards.fire.damage}} ({{localize "SPYCRAFT.Template.ActorAgentMain.ArmorPiercing"}} {{hazards.fire.ap}}; {{localize "SPYCRAFT.Template.ActorAgentMain.TakenFromThisFire"}} {{hazards.fire.suffered}}) <a data-action="burningRound">{{localize "SPYCRAFT.Template.ActorAgentMain.StartOfRound"}}</a> <a data-action="rollFireSave" data-kind="will">{{localize "SPYCRAFT.Template.ActorAgentMain.WillSaveToAct"}}</a> <a data-action="fightFire" data-method="roll">{{localize "SPYCRAFT.Template.ActorAgentMain.RollOnTheGround"}}</a> <a data-action="fightFire" data-method="water">{{localize "SPYCRAFT.Template.ActorAgentMain.Water"}}</a> <a data-action="fightFire" data-method="blanket">{{localize "SPYCRAFT.Template.ActorAgentMain.Blanket"}}</a> <a data-action="fightFire" data-method="extinguisher">{{localize "SPYCRAFT.Template.ActorAgentMain.Extinguisher"}}</a> <a data-action="rollFireSave" data-kind="scar">{{localize "SPYCRAFT.Template.ActorAgentMain.ScarringSave"}}</a>{{#if isGM}} <a data-action="extinguishFire">{{localize "SPYCRAFT.Template.ActorAgentMain.FireIsOut"}}</a>{{/if}}</p>{{/if}}
  {{#if hazards.acid}}<p class="hazard due"><b>{{localize "SPYCRAFT.Template.ActorAgentMain.Acid"}}</b> {{hazards.acid.damage}} ({{localize "SPYCRAFT.Template.ActorAgentMain.TakenFromThisAcid"}} {{hazards.acid.suffered}}) <a data-action="acidStep" data-step="round">{{localize "SPYCRAFT.Template.ActorAgentMain.StartOfRound"}}</a> <a data-action="acidStep" data-step="end">{{localize "SPYCRAFT.Template.ActorAgentMain.EndOfRoundHalve"}}</a> <a data-action="acidStep" data-step="wash">{{localize "SPYCRAFT.Template.ActorAgentMain.WashItOff"}}</a> <a data-action="acidStep" data-step="injury">{{localize "SPYCRAFT.Template.ActorAgentMain.ScarringSave"}}</a></p>{{/if}}
  {{#if hazards.exposure}}<p class="hazard">{{hazards.exposure.label}} — {{hazards.exposure.source}}: {{hazards.exposure.suffered}} {{localize "SPYCRAFT.Template.ActorAgentMain.DamageSoFar"}} <a data-action="exposureFailedSave">{{localize "SPYCRAFT.Template.ActorAgentMain.FailedSubdualSave"}}</a> <a data-action="endTypedExposure">{{localize "SPYCRAFT.Template.ActorAgentMain.ClearOfTheSource"}}</a></p>{{/if}}
  {{#each hazards.survival}}<p class="hazard">{{label}}: {{saves}} {{localize "SPYCRAFT.Template.ActorAgentMain.SavesMade"}} <a data-action="endSurvivalHazard" data-kind="{{kind}}">{{localize "SPYCRAFT.Template.ActorAgentMain.HazardOver"}}</a></p>{{/each}}
</div>
