{{!-- Contagions, fire and the other damage types at work on a character; shared by the agent and NPC sheets. --}}
<div class="hazards">
  {{#if npcDrained}}
    <section class="hazard npc-drained">
      <h4>{{localize "SPYCRAFT.Drained.Title"}}</h4>
      {{#if npcDrained.needsReview}}<p class="hint">{{localize "SPYCRAFT.Drained.NeedsReview"}}</p>
      {{else}}
        {{#if npcDrained.count}}<p>{{localize "SPYCRAFT.Drained.NPCLosses" count=npcDrained.count}}</p>{{/if}}
        {{#if npcDrained.specialLosses}}<p>{{localize "SPYCRAFT.Drained.NPCLevel" level=npcDrained.effectiveLevel base=npcDrained.baseLevel}}</p>{{/if}}
        {{#if npcDrained.gradeLosses}}<p>{{localize "SPYCRAFT.Drained.NPCGrades" count=npcDrained.gradeLosses}}</p>{{/if}}
        {{#if npcDrained.manualStats}}<p class="hint">{{localize "SPYCRAFT.Drained.NPCManual"}}</p>{{/if}}
        {{#each npcDrained.losses}}<p>{{source}}{{#if quality}} — {{quality}}{{/if}}</p>{{/each}}
      {{/if}}
      {{#if npcDrained.canApply}}<button type="button" class="sc2-action" data-action="applyNpcDrained">{{localize "SPYCRAFT.Drained.Apply"}}</button>{{/if}}
      {{#if npcDrained.canReview}}<button type="button" class="sc2-action" data-action="reviewNpcDrainedHistory">{{localize "SPYCRAFT.Drained.NPCReview"}}</button>{{/if}}
      {{#if npcDrained.canRoll}}<button type="button" class="sc2-action" data-action="rollDrainedRecovery">{{localize "SPYCRAFT.Drained.RollRecovery"}}</button>{{/if}}
      {{#if npcDrained.recoveryState}}<p>{{localize "SPYCRAFT.Drained.Recovery" state=npcDrained.recoveryState dc=npcDrained.recoveryDC}}</p>{{/if}}
      {{#each npcDrained.pending}}
        <p>{{localize "SPYCRAFT.Drained.Pending" mission=mission dc=dc}}</p>
        <button type="button" class="sc2-action" data-action="settleDrainedRecoveryCheck" data-mission="{{mission}}">{{localize "SPYCRAFT.Drained.Settle"}}</button>
        <button type="button" class="sc2-action" data-action="reviewDrainedRecovery" data-mission="{{mission}}">{{localize "SPYCRAFT.Drained.ReviewRecovery"}}</button>
      {{/each}}
    </section>
  {{/if}}
  {{#if drained}}
    <section class="hazard">
      <h4>{{localize "SPYCRAFT.Drained.Title"}}</h4>
      {{#if drained.levels}}
        {{#if drained.needsReview}}<p class="hint">{{localize "SPYCRAFT.Drained.NeedsReview"}}</p>
        {{else}}<p>{{localize "SPYCRAFT.Drained.Levels" levels=drained.levels level=drained.effectiveLevel}}</p>{{/if}}
        {{#if drained.canReview}}<button type="button" class="sc2-action" data-action="reviewDrainedBuild">{{localize "SPYCRAFT.Drained.Review"}}</button>{{/if}}
        {{#if drained.canRoll}}<button type="button" class="sc2-action" data-action="rollDrainedRecovery">{{localize "SPYCRAFT.Drained.RollRecovery"}}</button>{{/if}}
      {{/if}}
      {{#if drained.recoveryState}}<p>{{localize "SPYCRAFT.Drained.Recovery" state=drained.recoveryState dc=drained.recoveryDC}}</p>{{/if}}
      {{#each drained.pending}}
        <p>{{localize "SPYCRAFT.Drained.Pending" mission=mission dc=dc}}</p>
        <button type="button" class="sc2-action" data-action="settleDrainedRecoveryCheck" data-mission="{{mission}}">{{localize "SPYCRAFT.Drained.Settle"}}</button>
        <button type="button" class="sc2-action" data-action="reviewDrainedRecovery" data-mission="{{mission}}">{{localize "SPYCRAFT.Drained.ReviewRecovery"}}</button>
      {{/each}}
      {{#if drained.canApply}}<button type="button" class="sc2-action" data-action="applyDrained">{{localize "SPYCRAFT.Drained.Apply"}}</button>{{/if}}
    </section>
  {{/if}}
  {{#each hazards.interrupted}}
    <p class="hazard due"><b>{{label}}</b> — {{localize "SPYCRAFT.Hazards.InterruptedResult"}}
      {{#if sourceMissing}}{{localize "SPYCRAFT.Hazards.SourceMissing"}}{{/if}}
      <button type="button" class="sc2-action" data-action="reviewHazardResolution" data-hazard="{{id}}">{{localize "SPYCRAFT.Hazards.ReviewInterrupted"}}</button>
    </p>
  {{/each}}
  <p><button type="button" class="sc2-action" data-action="trackFall"
    {{#if fallTiming}}disabled title="{{localize 'SPYCRAFT.Hazards.FinishFallFirst'}}"{{/if}}
    >{{localize "SPYCRAFT.Hazards.TrackFall"}}</button></p>
  {{#if fallTiming}}
    <p class="hazard{{#if fallTiming.due}} due{{/if}}">{{fallTiming.feet}} ft. — {{fallTiming.text}}
      {{#if canReviewFallTiming}}<button type="button" class="sc2-action" data-action="reviewFallTiming"
        >{{localize "SPYCRAFT.Hazards.ReviewFallTiming"}}</button>{{/if}}
    </p>
  {{/if}}
  <p><button type="button" class="sc2-action" data-action="recordUncontrolledFall">{{localize "SPYCRAFT.Hazards.FallWithoutCheck"}}</button></p>
  <p>
  <b>
  {{localize "SPYCRAFT.Template.ActorAgentMain.Hazards"}}
  </b>
  <button type="button" class="sc2-action" data-action="exposeToContagion">
  {{localize "SPYCRAFT.Template.ActorAgentMain.ExposeToAContagion"}}
  </button>
  <button type="button" class="sc2-action" data-action="exposeToFire">
  {{localize "SPYCRAFT.Template.ActorAgentMain.FireDamage"}}
  </button>
  <button type="button" class="sc2-action" data-action="sufferTypedDamage">
  {{localize "SPYCRAFT.Template.ActorAgentMain.OtherDamageTypes"}}
  </button>
  <button type="button" class="sc2-action" data-action="survivalSave">
  {{localize "SPYCRAFT.Template.ActorAgentMain.SurvivalSave"}}
  </button>
  </p>
  {{#each hazards.contagions}}
  <p class="hazard{{#if due}} due{{/if}}">
  {{label}}{{#if doses}} ×{{doses}}{{/if}} — {{phase}}, {{localize "SPYCRAFT.Template.ActorAgentMain.FortitudeDC"}} {{dc}} ({{effect}}); {{#if due}}
  <b>
  {{localize "SPYCRAFT.Template.ActorAgentMain.SaveDueNow"}}
  </b>
  {{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.SaveDueIn"}} {{dueIn}}{{/if}} <button type="button" class="sc2-action" data-action="rollContagionSave" data-id="{{id}}">
  {{localize "SPYCRAFT.Template.ActorAgentMain.RollTheSave"}}
  </button>
  <button type="button" class="sc2-action" data-action="cureHazard" data-id="{{id}}">
  {{localize "SPYCRAFT.Template.ActorAgentMain.AntidoteOrEnd"}}
  </button>
  </p>
  {{/each}}
  {{#if hazards.fire}}
  <p class="hazard due">
  <b>
  {{localize "SPYCRAFT.Template.ActorAgentMain.OnFire"}}
  </b> {{hazards.fire.damage}} ({{localize "SPYCRAFT.Template.ActorAgentMain.ArmorPiercing"}} {{hazards.fire.ap}}; {{localize "SPYCRAFT.Template.ActorAgentMain.TakenFromThisFire"}} {{hazards.fire.suffered}}) <button type="button" class="sc2-action" data-action="burningRound">
  {{localize "SPYCRAFT.Template.ActorAgentMain.StartOfRound"}}
  </button>
  <button type="button" class="sc2-action" data-action="rollFireSave" data-kind="will">
  {{localize "SPYCRAFT.Template.ActorAgentMain.WillSaveToAct"}}
  </button>
  <button type="button" class="sc2-action" data-action="fightFire" data-method="roll">
  {{localize "SPYCRAFT.Template.ActorAgentMain.RollOnTheGround"}}
  </button>
  <button type="button" class="sc2-action" data-action="fightFire" data-method="water">
  {{localize "SPYCRAFT.Template.ActorAgentMain.Water"}}
  </button>
  <button type="button" class="sc2-action" data-action="fightFire" data-method="blanket">
  {{localize "SPYCRAFT.Template.ActorAgentMain.Blanket"}}
  </button>
  <button type="button" class="sc2-action" data-action="fightFire" data-method="extinguisher">
  {{localize "SPYCRAFT.Template.ActorAgentMain.Extinguisher"}}
  </button> {{#unless hazards.fire.sourceId}}{{#unless hazards.fire.scarChecked}}
  <button type="button" class="sc2-action" data-action="rollFireSave" data-kind="scar">
  {{localize "SPYCRAFT.Template.ActorAgentMain.ScarringSave"}}
  </button>
  {{/unless}}{{/unless}}{{#if isGM}} <button type="button" class="sc2-action" data-action="extinguishFire">
  {{localize "SPYCRAFT.Template.ActorAgentMain.FireIsOut"}}
  </button>
  {{/if}}
  </p>
  {{/if}}
  {{#if hazards.acidLegacyNeedsReview}}
    <p class="bad">{{localize "SPYCRAFT.AcidSources.Legacy"}}</p>
    {{#if hazards.acidCanReview}}<button type="button" class="sc2-action" data-action="acidStep" data-step="review">{{localize "SPYCRAFT.AcidSources.Review"}}</button>{{/if}}
  {{/if}}
  {{#if hazards.acidSources}}
    <details class="acid-sources" {{#if hazards.acidNeedsAttention}}open{{/if}}>
      <summary>{{localize "SPYCRAFT.AcidSources.Title"}}</summary>
      <ul class="plain">
        {{#each hazards.acidSources}}
          <li>
            <b>{{label}}</b>
            <p>{{localize "SPYCRAFT.AcidSources.Remaining"}}: {{damage}} · {{localize "SPYCRAFT.AcidSources.Suffered"}}: {{suffered}}</p>
            {{#if armorAffected}}<p class="muted">{{localize "SPYCRAFT.AcidSources.Equipment"}}</p>{{/if}}
            {{#if needsReview}}<p class="bad">{{localize "SPYCRAFT.AcidSources.NeedsReview"}}</p>{{/if}}
            {{#if canRound}}<button type="button" class="sc2-action" data-action="acidStep" data-step="round" data-acid-source="{{id}}">{{localize "SPYCRAFT.AcidSources.NextRound"}}</button>{{/if}}
            {{#if canEnd}}<button type="button" class="sc2-action" data-action="acidStep" data-step="end" data-acid-source="{{id}}">{{localize "SPYCRAFT.AcidSources.EndRound"}}</button>{{/if}}
            {{#if canWash}}<button type="button" class="sc2-action" data-action="acidStep" data-step="wash" data-acid-source="{{id}}">{{localize "SPYCRAFT.AcidSources.Wash"}}</button>{{/if}}
            {{#if canInjury}}<button type="button" class="sc2-action" data-action="acidStep" data-step="injury" data-acid-source="{{id}}">{{localize "SPYCRAFT.AcidSources.Injury"}}</button>{{/if}}
            {{#if injuryPending}}<p class="muted">{{localize "SPYCRAFT.AcidSources.InjuryPending"}}</p>{{/if}}
            {{#if canReview}}<button type="button" class="sc2-action" data-action="acidStep" data-step="review" data-acid-source="{{id}}">{{localize "SPYCRAFT.AcidSources.Review"}}</button>{{/if}}
          </li>
        {{/each}}
      </ul>
    </details>
  {{/if}}
  {{#if hazards.exposure}}
  <p class="hazard">
  {{hazards.exposure.label}} — {{hazards.exposure.source}}: {{hazards.exposure.suffered}} {{localize "SPYCRAFT.Template.ActorAgentMain.DamageSoFar"}} <button type="button" class="sc2-action" data-action="exposureFailedSave">
  {{localize "SPYCRAFT.Template.ActorAgentMain.FailedSubdualSave"}}
  </button>
  <button type="button" class="sc2-action" data-action="endTypedExposure">
  {{localize "SPYCRAFT.Template.ActorAgentMain.ClearOfTheSource"}}
  </button>
  </p>
  {{/if}}
  {{#each hazards.survival}}
  <p class="hazard">
  {{label}}: {{saves}} {{localize "SPYCRAFT.Template.ActorAgentMain.SavesMade"}} <button type="button" class="sc2-action" data-action="endSurvivalHazard" data-kind="{{kind}}">
  {{localize "SPYCRAFT.Template.ActorAgentMain.HazardOver"}}
  </button>
  </p>
  {{/each}}
  {{#if hazards.fireSources.length}}
    <details {{#if hazards.fireSourceNeedsAttention}}open{{/if}}>
      <summary>{{localize "SPYCRAFT.Hazards.FireSources"}}</summary>
      {{#each hazards.fireSources}}
        <p class="hazard{{#if due}} due{{/if}}"><b>{{label}}</b> — {{localize "SPYCRAFT.Hazards.FireDamageTotal" amount=suffered}}
          {{#if needsReview}}{{localize "SPYCRAFT.Hazards.FireHistoryReview"}}{{/if}}
          {{#if scarChecked}}{{localize "SPYCRAFT.Hazards.FireScarringResolved"}}{{else}}{{#if scarRoll}}{{localize "SPYCRAFT.Hazards.FireScarringPending"}}{{/if}}{{/if}}
  {{#if canRoll}}
  <button type="button" class="sc2-action" data-action="rollFireSave" data-kind="scar" data-fire-source="{{id}}">
  {{localize "SPYCRAFT.Template.ActorAgentMain.ScarringSave"}}
  </button>
  {{/if}}
          {{#if canReview}}<button type="button" class="sc2-action" data-action="reviewFireSource" data-fire-source="{{id}}">{{localize "SPYCRAFT.Hazards.ReviewFireSource"}}</button>{{/if}}
        </p>
      {{/each}}
    </details>
  {{/if}}
</div>
