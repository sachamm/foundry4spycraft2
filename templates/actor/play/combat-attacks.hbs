<details class="combat-tool-group" data-key="combat-attacks">
  <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.AttacksReactions"}}</span><small>{{localize "SPYCRAFT.Template.ActorAgentMain.DisarmTricksAndFinalAttacks"}}</small></summary>
  <p class="tool-hint">{{localize "SPYCRAFT.Template.ActorAgentMain.ChooseANewActionHereCounter"}}</p>
  <div class="tool-actions">
    {{#if combatTools.striking}}<button type="button" class="sc2-action" data-action="takeStrikingAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.StrikingReaction"}}</button>{{/if}}
    {{#if combatTools.missTrick}}<button type="button" class="sc2-action" data-action="takeMissTrick">{{localize "SPYCRAFT.Template.ActorAgentMain.DoubleTwirlRemiss"}}</button>{{/if}}
    <button type="button" class="sc2-action" data-action="rollDisarm">{{localize "SPYCRAFT.Template.ActorAgentMain.DisarmOpposedCheck"}}</button>
    <button type="button" class="sc2-action" data-action="rollCheapShot">{{localize "SPYCRAFT.Template.ActorAgentMain.CheapShot"}}</button>
    {{#if combatTools.counterTrip}}<button type="button" class="sc2-action" data-action="takeCounterTrip">{{localize "SPYCRAFT.Template.ActorAgentMain.CounterTrip"}}</button>{{/if}}
    {{#if combatTools.tripFinalAttack}}<button type="button" class="sc2-action" data-action="takeTripFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.TripFinalAttack"}}</button>{{/if}}
  </div>
  {{#with mobileOffense}}{{> "systems/spycraft2/templates/actor/play/round-counter.hbs" label="SPYCRAFT.Template.ActorAgentMain.MobileOffense" action="takeMobileOffense" actionLabel="SPYCRAFT.Template.ActorAgentMain.FinalAttackDuringStandardMove" resource="mobileOffense" review="SPYCRAFT.Template.ActorAgentMain.GCReviewUsesAlreadyResolved" startHint="SPYCRAFT.Template.ActorAgentMain.MobileOffenseStartACombatContaining"}}{{/with}}
  {{#with contempt}}<p>{{#if @root.startedCharacterCombat}}{{localize "SPYCRAFT.Template.ActorAgentMain.Contempt"}} <b class="sc2-uses{{#unless remaining}} spent{{/unless}}">{{remaining}}/{{limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentMain.ThisCombat"}} {{@root.contemptRound.remaining}} {{localize "SPYCRAFT.Template.ActorAgentMain.1ThisRound"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCombatCountNeedsGCReview"}}</span>{{else}}{{#if @root.contemptRound.counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedRoundCountNeedsGCReview"}}</span>{{else}}{{#if remaining}}{{#if @root.contemptRound.remaining}}<button type="button" class="sc2-action" data-action="takeContempt">{{localize "SPYCRAFT.Template.ActorAgentMain.FinalAttackAgainstStandardCharacter"}}</button>{{/if}}{{/if}}{{/if}}{{/if}}{{#if @root.isGM}} {{> "systems/spycraft2/templates/actor/play/gc-review.hbs" resource="contempt" label="SPYCRAFT.Template.ActorAgentMain.GCReviewCombatUses"}} {{> "systems/spycraft2/templates/actor/play/gc-review.hbs" resource="contemptRound" label="SPYCRAFT.Template.ActorAgentMain.GCReviewRoundUses"}}{{/if}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.ContemptStartACombatContainingThis"}}{{/if}}</p>{{/with}}
  {{#with combatInstincts}}{{> "systems/spycraft2/templates/actor/play/round-counter.hbs" label="SPYCRAFT.Template.ActorAgentMain.CombatInstincts" action="takeCombatInstincts" actionLabel="SPYCRAFT.Template.ActorAgentMain.ImmediateFinalAttackAfterMiss" resource="combatInstincts" review="SPYCRAFT.Template.ActorAgentMain.GCReviewReactionsAlreadyUsed" startHint="SPYCRAFT.Template.ActorAgentMain.CombatInstinctsStartACombatContaining"}}{{/with}}
  {{#with cleaveBasics}}{{> "systems/spycraft2/templates/actor/play/round-counter.hbs" label="SPYCRAFT.Template.ActorAgentMain.CleaveBasicsUses" action="takeCleaveBasics" actionLabel="SPYCRAFT.Template.ActorAgentMain.AttackAnotherOpponentAfterADrop" resource="cleaveBasics" review="SPYCRAFT.Template.ActorAgentMain.GCReviewReactionsAlreadyUsed" startHint="SPYCRAFT.Template.ActorAgentMain.DropFollowUpStartACombat"}}{{/with}}
  {{#with snapShot}}{{> "systems/spycraft2/templates/actor/play/round-counter.hbs" label="SPYCRAFT.Template.ActorAgentMain.SnapShotUses" action="takeSnapShot" actionLabel="SPYCRAFT.Template.ActorAgentMain.AttackAnotherOpponentAfterADrop" resource="snapShot" review="SPYCRAFT.Template.ActorAgentMain.GCReviewReactionsAlreadyUsed" startHint="SPYCRAFT.Template.ActorAgentMain.DropFollowUpStartACombat"}}{{/with}}
  {{#with fireTeamSupremacy}}{{> "systems/spycraft2/templates/actor/play/round-counter.hbs" label="SPYCRAFT.Template.ActorAgentMain.FireTeamSupremacyUses" action="takeFireTeamSupremacy" actionLabel="SPYCRAFT.Template.ActorAgentMain.FireTeamSupremacyTake" resource="fireTeamSupremacy" review="SPYCRAFT.Template.ActorAgentMain.GCReviewReactionsAlreadyUsed" startHint="SPYCRAFT.Template.ActorAgentMain.FireTeamSupremacyStart"}}{{/with}}
  {{#with opportunist}}{{> "systems/spycraft2/templates/actor/play/round-counter.hbs" label="SPYCRAFT.Template.ActorAgentMain.OpportunistUses" action="takeOpportunist" actionLabel="SPYCRAFT.Template.ActorAgentMain.OpportunistTake" resource="opportunist" review="SPYCRAFT.Template.ActorAgentMain.GCReviewReactionsAlreadyUsed" startHint="SPYCRAFT.Template.ActorAgentMain.OpportunistStartACombat"}}{{/with}}
  {{#with twoWeaponFinalAttack}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.FinalAttacks"}} <b class="sc2-uses{{#unless remaining}} spent{{/unless}}">{{remaining}}/{{limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentMain.Remaining"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedUseHistoryNeedsGCVerification"}}</span>{{else}}{{#if remaining}}<button type="button" class="sc2-action" data-action="takeTwoWeaponFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.TakeFinalAttack"}}</button>{{/if}}{{/if}}{{#if @root.isGM}} {{> "systems/spycraft2/templates/actor/play/gc-review.hbs" resource="twoWeaponFinalAttack" label="SPYCRAFT.Template.ActorAgentMain.GCReviewAttacksAlreadyUsed"}}{{else}}{{#if counterReview}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewThis"}}{{/if}}{{/if}}</p>{{/with}}
</details>
