<details class="combat-tool-group" data-key="combat-defense">
  <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.DefenseDamage"}}</span><small>{{localize "SPYCRAFT.Template.ActorAgentMain.IncomingAttacksSavesAndInjuries"}}</small></summary>
  <p class="tool-hint">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewAnIncomingAttackOrA"}}</p>
  <p><a data-action="declareFightDefensively">{{localize "SPYCRAFT.Template.ActorAgentMain.FightDefensively"}}</a>{{#if system.fightDefensivelyState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.AttackSkillPenalty"}}{{system.fightDefensivelyState.penalty}}{{localize "SPYCRAFT.Template.ActorAgentMain.Dodge2"}}{{system.fightDefensivelyState.dodgeBonus}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.fightDefensivelyState.dueRound}}{{/if}}{{#if system.notTheFaceDR}} · {{localize "SPYCRAFT.Template.ActorAgentMain.NotTheFaceDR"}}{{system.notTheFaceDR}}{{/if}}</p>
  {{#if combatTools.expertise}}
  <p><a data-action="activateCombatExpertise">{{localize "SPYCRAFT.Template.ActorAgentMain.CombatExpertise"}}</a>{{#if system.combatExpertiseState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.AttackSkillPenalty"}}{{system.combatExpertiseState.penalty}}{{localize "SPYCRAFT.Template.ActorAgentMain.Dodge2"}}{{system.combatExpertiseState.dodgeBonus}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.combatExpertiseState.dueRound}}{{/if}}</p>
  {{/if}}
  {{#if combatTools.cover}}
  <p><a data-action="declareSuperiorCover">{{localize "SPYCRAFT.Template.ActorAgentMain.SuperiorCover"}}</a>{{#if system.superiorCoverState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.AttackSkillPenalty2DR"}}{{system.superiorCoverState.dr}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.superiorCoverState.dueRound}} <a data-action="reviewSuperiorCover">{{localize "SPYCRAFT.Template.ActorAgentMain.ConfirmChangedLostCover"}}</a>{{/if}}{{#if system.superiorCoverState.needsReview}} <span class="bad">{{system.superiorCoverState.reason}}</span>{{/if}}</p>
  {{/if}}
  <p><a data-action="checkIncomingDefense">{{localize "SPYCRAFT.Template.ActorAgentMain.CheckIncomingAttackDefense"}}</a> <a data-action="sufferInitiativeLoss">{{localize "SPYCRAFT.Template.ActorAgentMain.ApplyInitiativeCountLoss"}}</a>{{#if system.uncannyDodge.grade}} {{localize "SPYCRAFT.Template.ActorAgentMain.UncannyDodge"}} {{system.uncannyDodge.grade}}{{/if}}</p>
  <p><a data-action="checkReflexDamage">{{localize "SPYCRAFT.Template.ActorAgentMain.CheckDamageAfterARecordedReflex"}}</a>{{#if system.evasion.grade}} {{localize "SPYCRAFT.Template.ActorAgentMain.Evasion"}} {{system.evasion.grade}}{{/if}}</p>
  <p><a data-action="rollCriticalInjury">{{localize "SPYCRAFT.Template.ActorAgentMain.RollCriticalInjuryTableOfOuch"}}</a></p>
  {{#each criticalInjuryReviews}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.Injury"}} {{id}} — {{source}}: {{label}}. {{#if @root.isGM}}<a data-action="reviewCriticalInjury" data-injury="{{id}}">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewShowOriginalResult"}}</a>{{/if}}</p>{{/each}}
  {{#if system.adrenalineJunkieSource}}{{#if isGM}}<p><a data-action="recordAdrenalineWoundLoss">{{localize "SPYCRAFT.Template.ActorAgentMain.AdrenalineJunkieRecordFinalWoundLoss"}}</a></p>{{/if}}{{/if}}
  {{#with fortunate}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateUses"}} <b class="sc2-uses{{#unless remaining}} spent{{/unless}}">{{remaining}}/{{limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentMain.FortunateThisSession"}}{{#if @root.isGM}}{{#if counterReview}} <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}} <a data-action="grantFortunate">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateGrant"}}</a>{{/if}}{{/if}} <a class="gc-review" data-sc2-display="icon" data-action="reviewLimitedUseCounter" data-resource="fortunate">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateReview"}}</a>{{else}} {{localize "SPYCRAFT.Template.ActorAgentMain.FortunateAskGC"}}{{/if}}</p>{{/with}}
  {{#with blackCat}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.BlackCatUses"}} <b class="sc2-uses{{#unless remaining}} spent{{/unless}}">{{remaining}}/{{limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentMain.BlackCatThisScene"}}{{#if @root.isGM}}{{#if counterReview}} <span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}} <a data-action="applyBlackCat">{{localize "SPYCRAFT.Template.ActorAgentMain.BlackCatApply"}}</a>{{/if}}{{/if}} <a class="gc-review" data-sc2-display="icon" data-action="reviewLimitedUseCounter" data-resource="blackCat">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateReview"}}</a>{{else}} {{localize "SPYCRAFT.Template.ActorAgentMain.BlackCatAskGC"}}{{/if}}</p>{{/with}}
  {{#with gunslinger}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.GunslingerUses"}} <b class="sc2-uses{{#unless remaining}} spent{{/unless}}">{{remaining}}/{{limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerThisSession"}}{{#if remaining}} <a data-action="useGunslingersEye">{{localize "SPYCRAFT.Template.ActorAgentMain.GunslingerSizeUp"}}</a>{{/if}}{{#if @root.isGM}} <a class="gc-review" data-sc2-display="icon" data-action="reviewLimitedUseCounter" data-resource="gunslingersEye">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateReview"}}</a>{{/if}}</p>{{/with}}
  {{#with berserker}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerUses"}} <b class="sc2-uses{{#unless remaining}} spent{{/unless}}">{{remaining}}/{{limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerThisSession"}}{{#if @root.system.berserkerRageState.active}} · {{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerRaging"}} {{@root.system.berserkerRageState.remaining}} <a data-action="endBerserkerRage">{{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerEnd"}}</a>{{else}}{{#if @root.system.berserkerRageState.record}} <a data-action="endBerserkerRage">{{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerOver"}}</a>{{else}}{{#if remaining}} <a data-action="enterBerserkerRage">{{localize "SPYCRAFT.Template.ActorAgentMain.BerserkerEnter"}}</a>{{/if}}{{/if}}{{/if}}{{#if @root.isGM}} <a class="gc-review" data-sc2-display="icon" data-action="reviewLimitedUseCounter" data-resource="berserkerRage">{{localize "SPYCRAFT.Template.ActorAgentMain.FortunateReview"}}</a>{{/if}}</p>{{/with}}
  {{#each system.unrestrictedBonusPools}}<p>{{label}}: {{available}} d{{die}} {{localize "SPYCRAFT.Template.ActorAgentMain.BonusDiceAvailableUntil"}} {{expiryLabel}}{{#if reason}} · {{reason}}{{/if}}</p>{{/each}}
  {{#if system.actionDieDefense}}<p>{{localize "SPYCRAFT.Template.ActorAgentMain.ActionDie2DefenseThroughRound"}} {{system.actionDieDefense.lastRound}}.</p>{{/if}}
</details>
