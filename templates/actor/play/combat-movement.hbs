<details class="combat-tool-group" data-key="combat-movement">
  <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.StancesMovement"}}</span><small>{{localize "SPYCRAFT.Template.ActorAgentMain.YourStanceAndAttackStyles"}}</small></summary>
  <p class="tool-hint">{{localize "SPYCRAFT.Template.ActorAgentMain.TheseControlsUseThisCharacterS"}}</p>
  {{#if combatTools.stance}}<p><button type="button" class="sc2-action" data-action="declareCombatStance">{{localize "SPYCRAFT.Template.ActorAgentMain.CombatStance"}}</button>{{#if system.combatStance}} {{localize "SPYCRAFT.Template.ActorAgentMain.Current"}} {{system.combatStance.key}}{{/if}}</p>{{/if}}
  {{#if combatTools.movement}}<p><button type="button" class="sc2-action" data-action="reviewStanceMovement">{{localize "SPYCRAFT.Template.ActorAgentMain.RecordRoundMovement"}}</button></p>{{/if}}
  {{#if combatTools.twoWeapon}}<p><button type="button" class="sc2-action" data-action="declareTwoWeapon">{{localize "SPYCRAFT.Template.ActorAgentMain.DeclareTwoWeaponCombat"}}</button>{{#if system.twoWeaponStyleState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.Declared"}} {{system.twoWeaponStyleState.extraAttacks}} {{localize "SPYCRAFT.Template.ActorAgentMain.FinalStandardAttacksAttackPenalty"}}{{system.twoWeaponStyleState.penalty}}{{localize "SPYCRAFT.Template.ActorAgentMain.SkillPenalty"}} {{#if system.twoWeaponStyleState.skillPenalty}}−{{system.twoWeaponStyleState.skillPenalty}}{{else}}0{{/if}}{{#if system.twoWeaponStyleState.handgunSkillWaiver}} {{localize "SPYCRAFT.Template.ActorAgentMain.BothGunsBlazingAlsoWaivesThis"}}{{/if}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.twoWeaponStyleState.dueRound}}{{/if}}{{#if system.twoWeaponStyleState.needsReview}} <span class="bad">{{system.twoWeaponStyleState.reason}}</span>{{/if}}{{#if system.twoWeaponStyle}}{{#if isGM}} <button type="button" class="sc2-action" data-action="reviewTwoWeapon">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewRemainingTradeoff"}}</button>{{/if}}{{/if}}</p>{{/if}}
  {{#if combatTools.snakeStrike}}<p><button type="button" class="sc2-action" data-action="declareSnakeStrike">{{localize "SPYCRAFT.Template.ActorAgentMain.SnakeStrike"}}</button></p>{{/if}}
  {{#if combatTools.intense}}<p><button type="button" class="sc2-action" data-action="declareIntenseStance">{{localize "SPYCRAFT.Template.ActorAgentMain.IntenseStance"}}</button>{{#if system.intenseStanceState.holding}} {{localize "SPYCRAFT.Template.ActorAgentMain.IntenseHolding"}}{{/if}}{{#if system.intenseStanceState.bonus}} {{localize "SPYCRAFT.Template.ActorAgentMain.IntenseBonus"}}{{/if}}</p>{{/if}}
  {{#if combatTools.duelingBasics}}<p><button type="button" class="sc2-action" data-action="declareDuelingBasics">{{localize "SPYCRAFT.Template.ActorAgentMain.DuelingBasicsChoose"}}</button></p>{{/if}}
  {{#if combatTools.twoHit}}<p><button type="button" class="sc2-action" data-action="declareTwoHit">{{localize "SPYCRAFT.Template.ActorAgentMain.TwoHitComboWarriorsGrace"}}</button></p>{{/if}}
  {{#if combatTools.followUp}}<p><button type="button" class="sc2-action" data-action="declareFollowUp">{{localize "SPYCRAFT.Template.ActorAgentMain.FollowUpShotHailOfFire"}}</button></p>{{/if}}
  {{#if combatTools.darting}}
  <p><button type="button" class="sc2-action" data-action="declareDarting">{{localize "SPYCRAFT.Template.ActorAgentMain.DartingFlashingWeapon"}}</button>{{#if system.dartingStyleState.active}} {{localize "SPYCRAFT.Template.ActorAgentMain.AttackSkillPenalty"}}{{system.dartingStyleState.penalty}} {{localize "SPYCRAFT.Template.ActorAgentMain.UntilOwnCountInRound"}} {{system.dartingStyleState.dueRound}}{{localize "SPYCRAFT.Template.ActorAgentMain.FinalAttacks2"}} {{dartingFinalAttack.remaining}} /{{system.dartingStyleState.extraAttacks}} <button type="button" class="sc2-action" data-action="takeDartingFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.TakeFinalMeleeHurledAttack"}}</button>{{#if isGM}} <button type="button" class="gc-review sc2-action" data-sc2-display="icon" data-action="reviewLimitedUseCounter" data-resource="dartingFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewAttacksAlreadyResolved"}}</button>{{/if}}{{/if}}{{#if system.dartingStyleState.needsReview}} <span class="bad">{{system.dartingStyleState.reason}}</span>{{/if}}{{#if system.dartingStyle}}{{#if isGM}} <button type="button" class="sc2-action" data-action="reviewDarting">{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewRemainingTradeoff"}}</button>{{/if}}{{/if}}</p>
  {{/if}}
</details>
