<details class="combat-tool-group" data-key="combat-outcomes">
  <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.RecordedOutcomes"}}</span><small>{{localize "SPYCRAFT.Template.ActorAgentMain.ResolveAnAttackAlreadyRolled"}}</small></summary>
  <p class="hint">{{localize "SPYCRAFT.Template.ActorAgentMain.UseTheseToolsAfterAnAttack"}}</p>
  <div class="tool-actions">
    <a data-action="manageTripOutcomes">{{localize "SPYCRAFT.Template.ActorAgentMain.TripOutcomes"}}</a>
    <a data-action="manageFeintOutcomes">{{localize "SPYCRAFT.Template.ActorAgentMain.FeintOutcomes"}}</a>
    <a data-action="manageTakedown">{{localize "SPYCRAFT.Template.ActorAgentMain.TakedownSavesOutcomes"}}</a>
    <a data-action="manageMeleeTradeoff">{{localize "SPYCRAFT.Template.ActorAgentMain.RecordedAttackBenefits"}}</a>
    <a data-action="manageCheapShots">{{localize "SPYCRAFT.Template.ActorAgentMain.CheapShotOutcomesRecovery"}}</a>
    {{#if combatTools.fend}}<a data-action="recordFendMovement">{{localize "SPYCRAFT.Template.ActorAgentMain.FendMovement"}}</a>{{/if}}
    {{#if combatTools.threadNeedle}}<a data-action="manageThreadNeedle">{{localize "SPYCRAFT.Template.ActorAgentMain.ThreadTheNeedleOutcome"}}</a>{{/if}}
    {{#if combatTools.stanceDamage}}<a data-action="manageStanceDamage">{{localize "SPYCRAFT.Template.ActorAgentMain.StanceDamage"}}</a>{{/if}}
    <a data-action="settleGrapple">{{localize "SPYCRAFT.Template.ActorAgentMain.SettleAGrapple"}}</a>
    <a data-action="recordAnticipate">{{localize "SPYCRAFT.Template.ActorAgentMain.AnticipateResult"}}</a>
    <a data-action="standOff">{{localize "SPYCRAFT.Template.ActorAgentMain.StandOff"}}</a>
    <a data-action="tireResult">{{localize "SPYCRAFT.Template.ActorAgentMain.TireResult"}}</a>
    <a data-action="coupDeGraceSave">{{localize "SPYCRAFT.Template.ActorAgentMain.SurviveACoupDeGrace"}}</a>
    <a data-action="cancelReady">{{localize "SPYCRAFT.Template.ActorAgentMain.CancelAReadiedAction"}}</a>
    {{#if combatTools.drivingStance}}<a data-action="manageDrivingStance">{{localize "SPYCRAFT.Template.ActorAgentMain.DrivingStanceOutcome"}}</a>{{/if}}
  </div>
</details>
