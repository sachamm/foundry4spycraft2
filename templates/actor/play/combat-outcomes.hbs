<details class="combat-tool-group" data-key="combat-outcomes">
  <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.RecordedOutcomes"}}</span><small>{{localize "SPYCRAFT.Template.ActorAgentMain.ResolveAnAttackAlreadyRolled"}}</small></summary>
  <p class="hint">{{localize "SPYCRAFT.Template.ActorAgentMain.UseTheseToolsAfterAnAttack"}}</p>
  <div class="tool-actions">
    <button type="button" class="sc2-action" data-action="manageTakedown">{{localize "SPYCRAFT.Template.ActorAgentMain.TakedownSavesOutcomes"}}</button>
    <button type="button" class="sc2-action" data-action="manageMeleeTradeoff">{{localize "SPYCRAFT.Template.ActorAgentMain.RecordedAttackBenefits"}}</button>
    <button type="button" class="sc2-action" data-action="manageCheapShots">{{localize "SPYCRAFT.Template.ActorAgentMain.CheapShotOutcomesRecovery"}}</button>
    {{#if combatTools.fend}}<button type="button" class="sc2-action" data-action="recordFendMovement">{{localize "SPYCRAFT.Template.ActorAgentMain.FendMovement"}}</button>{{/if}}
    {{#if combatTools.threadNeedle}}<button type="button" class="sc2-action" data-action="manageThreadNeedle">{{localize "SPYCRAFT.Template.ActorAgentMain.ThreadTheNeedleOutcome"}}</button>{{/if}}
    {{#if combatTools.stanceDamage}}<button type="button" class="sc2-action" data-action="manageStanceDamage">{{localize "SPYCRAFT.Template.ActorAgentMain.StanceDamage"}}</button>{{/if}}
    {{> "systems/spycraft2/templates/actor/parts/combat-outcome-buttons.hbs"}}
    {{#if combatTools.drivingStance}}<button type="button" class="sc2-action" data-action="manageDrivingStance">{{localize "SPYCRAFT.Template.ActorAgentMain.DrivingStanceOutcome"}}</button>{{/if}}
  </div>
</details>
