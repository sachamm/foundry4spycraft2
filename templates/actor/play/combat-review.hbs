<details class="combat-tool-group" data-key="combat-review" {{#if combatReviewNeeded}}open{{/if}}>
  <summary><span>{{localize "SPYCRAFT.Template.ActorAgentMain.GCReviewRecovery"}}</span><small>{{#if combatReviewNeeded}}{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewNeeded"}}{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.InterruptedActionsAndSavedResources"}}{{/if}}</small></summary>
  <p class="tool-hint">{{localize "SPYCRAFT.Template.ActorAgentMain.ForInterruptedActionsCheckTheSaved"}}</p>
  {{#if usagePeriodReview.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.Interrupted"}} {{usagePeriodReview.period}} {{localize "SPYCRAFT.Template.ActorAgentMain.StartNeedsGCReview"}} {{#if isGM}}<button type="button" class="sc2-action" data-action="reviewUsagePeriod">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewStartingDiceAndCounters"}}</button>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewThe"}}{{/if}}</p>{{/if}}
  {{#if actor.flags.spycraft2.missionXPReview.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.InterruptedMissionXPNeedsGCReview"}} {{#if isGM}}<button type="button" class="sc2-action" data-action="reviewMissionXP">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewMissionXPAndReward"}}</button>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewMission"}}{{/if}}</p>{{/if}}
  {{#if actor.flags.spycraft2.actionDieAwardReview.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.InterruptedAwardNeedsGCReview"}} {{#if isGM}}<button type="button" class="sc2-action" data-action="reviewActionDieAward">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewAwardAndBalances"}}</button>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewThe2"}}{{/if}}</p>{{/if}}
  {{#if system.actionDiceSettlementReview.needsReview}}<p class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.InterruptedActionDieUseNeedsGC"}} {{#if isGM}}<button type="button" class="sc2-action" data-action="reviewActionDiceSettlement">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewHealthAndActionDice"}}</button>{{else}}{{localize "SPYCRAFT.Template.ActorAgentMain.AskTheGCToReviewHealth"}}{{/if}}</p>{{/if}}
  <div class="tool-actions">
    <button type="button" class="sc2-action" data-action="reviewCounterTrip">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewInterruptedCounterTrip"}}</button>
    <button type="button" class="sc2-action" data-action="reviewTripFinalAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewInterruptedTripFinalAttack"}}</button>
    <button type="button" class="sc2-action" data-action="reviewFeintBonuses">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewInterruptedFeintBenefit"}}</button>
    {{#if combatTools.striking}}<button type="button" class="sc2-action" data-action="reviewStrikingAttack">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewStrikingReaction"}}</button>{{/if}}
    {{#if combatTools.powerStance}}<button type="button" class="sc2-action" data-action="reviewPowerStanceInitiative">{{localize "SPYCRAFT.Template.ActorAgentMain.ReviewPowerCount"}}</button>{{/if}}
  </div>
</details>
