  <div class="play-dashboard play-only">
    {{#if startedCharacterCombat}}<div class="round-tracker" role="group" aria-label="{{localize 'SPYCRAFT.Round.Title'}}">
      <span class="sc2-caption" data-tooltip="{{localize 'SPYCRAFT.Round.Hint'}}">{{localize "SPYCRAFT.Round.Title"}}</span>
      {{#each roundActions}}<button type="button" class="round-pip{{#if spent}} spent{{/if}}" data-sc2-display="text" data-action="toggleHalfAction" data-index="{{index}}" aria-pressed="{{spent}}">{{localize "SPYCRAFT.Round.Half"}}</button>{{/each}}
    </div>{{/if}}
    <div class="pinned-tools tool-actions" aria-label="{{localize 'SPYCRAFT.Pins.Title'}}" hidden></div>
    <div class="ability-strip" aria-label="{{localize 'SPYCRAFT.Attributes'}}">
      <div class="stat-grid">
        {{#each abilities}}<button type="button" class="stat sc2-stat-action" data-action="rollAbility" data-ability="{{key}}" aria-label="{{localize 'SPYCRAFT.Action.RollNamed' name=label}}"{{#if temporaryBonus}} data-tooltip="{{localize 'SPYCRAFT.Action.TemporaryAdjustment' value=(signed temporaryBonus)}}"{{/if}}><span>{{label}}</span><b>{{signed mod}}</b><small>{{value}}</small></button>{{/each}}
      </div>
    </div>
    <div class="dashboard-weapons">      <h3>{{localize "SPYCRAFT.Weapons"}}</h3>
      <ul class="item-list compact">
        {{#each weapons}}{{> "systems/spycraft2/templates/actor/parts/weapon-row.hbs"}}
        {{else}}<li class="muted">{{localize "SPYCRAFT.NoWeapons"}}</li>{{/each}}
      </ul>
</div>
    <div class="dashboard-skills">
      <h3>{{localize "SPYCRAFT.Play.TrainedSkills"}}</h3>
      {{#if playSkills.length}}<div
        class="tool-actions">{{#each playSkills}}<button type="button"
        class="sc2-roll sc2-action"
        data-action="rollSkill"
        data-skill="{{key}}"
        aria-label="{{rollLabel}}">{{name}} <b>{{totalsLabel}}</b></button>{{/each}}</div>{{else}}<p
        class="sc2-empty muted">{{localize "SPYCRAFT.Play.NoTrainedSkills"}}</p>{{/if}}
    </div>
    {{#if limitedUses.length}}<div class="dashboard-uses" aria-label="{{localize 'SPYCRAFT.Play.AbilitiesInPlay'}}">
      <h3>{{localize "SPYCRAFT.Play.AbilitiesInPlay"}}</h3>
      <ul
        class="plain uses-strip">{{#each limitedUses}}<li>{{> "systems/spycraft2/templates/actor/parts/use-counter.hbs"}}{{#if (sc2eq workflow "manual")}} <button type="button"
        class="sc2-action"
        data-action="useLimitedAbility"
        data-resource="{{id}}"
        data-name="{{name}}"{{#unless remaining}} disabled
        data-tooltip="{{localize 'SPYCRAFT.Uses.Spent' period=period}}"{{/unless}}>{{localize "SPYCRAFT.Template.ActorAgentClasses.Use"}}</button>{{/if}}</li>{{/each}}</ul>
    </div>{{/if}}
    <div class="quick-actions" role="group" aria-label="{{localize 'SPYCRAFT.Play.YourTurn'}}">
      <h3>{{localize "SPYCRAFT.Play.YourTurn"}}</h3>
      <p
        class="tool-actions"><button type="button"
        class="sc2-action"
        data-action="takeTotalDefense">{{localize "SPYCRAFT.Template.ActorAgentMain.TakeTotalDefense"}}</button> <button type="button"
        class="sc2-action"
        data-action="checkCombatMovement">{{localize "SPYCRAFT.Template.ActorAgentMain.CheckCombatMovement"}}</button> <button type="button"
        class="sc2-action"
        data-action="checkNumericalAdvantage">{{localize "SPYCRAFT.Template.ActorAgentMain.CheckNumericalAdvantage"}}</button>{{#if startedCharacterCombat}} <button type="button"
        class="{{#if ownTurn}}sc2-primary-action {{/if}}sc2-action"
        data-action="endTurn"{{#unless ownTurn}} disabled
        data-tooltip="{{localize 'SPYCRAFT.Play.EndTurnNotYours'}}"{{/unless}}>{{localize "SPYCRAFT.Play.EndTurn"}}</button>{{/if}}</p>
      {{#if activeEffects.length}}<ul
        class="plain sc2-active-effects"
        aria-label="{{localize 'SPYCRAFT.Play.ActiveEffects'}}">{{#each activeEffects}}<li
        class="sc2-chip">{{this}}</li>{{/each}}</ul>{{/if}}
    </div>
  </div>
