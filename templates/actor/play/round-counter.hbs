{{!-- A per-round use counter in combat, inside {{#with counter}}. Hash: label, action, actionLabel, resource, review, startHint (translation keys, the take action and the counter id). --}}
<p>{{#if @root.startedCharacterCombat}}{{localize label}} <b class="sc2-uses{{#unless remaining}} spent{{/unless}}">{{remaining}}/{{limit}}</b> {{localize "SPYCRAFT.Template.ActorAgentMain.ThisRound"}} {{#if counterReview}}<span class="bad">{{localize "SPYCRAFT.Template.ActorAgentMain.SavedCountNeedsGCReview"}}</span>{{else}}{{#if remaining}}<button type="button" class="sc2-action" data-action="{{action}}">{{localize actionLabel}}</button>{{/if}}{{/if}}{{#if @root.isGM}} <button type="button" class="gc-review sc2-action" data-sc2-display="icon" data-action="reviewLimitedUseCounter" data-resource="{{resource}}">{{localize review}}</button>{{/if}}{{else}}{{localize startHint}}{{/if}}</p>
