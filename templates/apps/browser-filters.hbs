<div class="browser-filters">
<div class="dossier-band" aria-hidden="true">
  <span class="file-label">{{localize "SPYCRAFT.Retro.Archive"}}</span>
  <span class="file-stamp">{{localize "SPYCRAFT.Retro.Classified"}}</span>
</div>
  {{#if missingPack}}<p class="bad">{{localize "SPYCRAFT.Browser.MissingPack"}}</p>{{/if}}
  <div class="filters">
    <input type="search" name="search" value="{{filters.search}}" placeholder="{{localize 'SPYCRAFT.Browser.Search'}}" aria-label="{{localize 'SPYCRAFT.Action.SearchCatalog'}}" />
    <select name="group" aria-label="{{localize 'SPYCRAFT.Action.CatalogGroup'}}">{{selectOptions groups selected=filters.group blank=(localize "SPYCRAFT.Browser.All")}}</select>
    {{#if showAcquisitionSources}}<label>{{localize "SPYCRAFT.Template.AppsBrowser.FeatSource"}} <select name="acquisitionSource">{{selectOptions acquisitionSources selected=filters.acquisitionSource}}</select></label>{{/if}}
    {{#if dated}}<select name="caliber" aria-label="{{localize 'SPYCRAFT.Browser.CaliberFilter'}}">{{selectOptions calibers selected=filters.caliber blank=(localize "SPYCRAFT.Browser.AnyCaliber")}}</select>{{/if}}
    {{#if restrictable}}<select name="restricted" aria-label="{{localize 'SPYCRAFT.Browser.RestrictedFilter'}}">{{selectOptions restrictedOptions selected=filters.restricted blank=(localize "SPYCRAFT.Browser.RestrictedShown")}}</select>{{/if}}
    {{#if dated}}<label><input type="checkbox" name="showFuture" {{checked filters.showFuture}} /> {{localize "SPYCRAFT.Browser.ShowFuture"}}</label>{{/if}}
    {{#if hasPrereqs}}<label><input type="checkbox" name="qualifiedOnly" {{checked filters.qualifiedOnly}} /> {{localize "SPYCRAFT.Browser.QualifiedOnly"}}</label>{{/if}}
  </div>
</div>
