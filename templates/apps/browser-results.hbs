<div class="browser-results">
{{#if era}}<p class="browser-era hint">{{era}}</p>{{/if}}
<div class="browser-panes">
<ul class="browser-list">
  {{#each rows}}
    <li data-uuid="{{uuid}}" class="{{#unless qualified}}unqualified{{/unless}} {{#if owned}}owned{{/if}} {{#if selected}}selected{{/if}} {{#if future}}future{{/if}}">
      <div class="row-main">
        <button type="button" data-action="select" class="name sc2-action sc2-text-action" data-sc2-display="text" aria-current="{{#if selected}}true{{else}}false{{/if}}">{{name}}</button>
        {{#unless qualified}}<span class="tag unqualified-tag">{{localize "SPYCRAFT.Browser.NotQualified"}}</span>{{/unless}}
        {{#if future}}<span class="tag future-tag">{{localize "SPYCRAFT.Browser.NotYet"}}</span>{{/if}}
        <span class="muted">{{groupLabel}}{{#if extra}} · {{extra}}{{/if}}</span>
        {{#if prereq}}<div class="prereq {{#unless qualified}}bad{{/unless}}" data-tooltip="{{unmet}}">{{prereq}}{{#if notChecked}} <span class="tag">{{localize "SPYCRAFT.Feat.NotChecked"}}</span>{{/if}}</div>{{/if}}
      </div>
      {{#if ../actor}}<button type="button" data-sc2-display="icon" data-action="add" aria-label="{{localize 'SPYCRAFT.Browser.AddEntry' name=name}}" {{#if owned}}class="owned"{{/if}} {{#if locked}}disabled data-tooltip="{{localize 'SPYCRAFT.Browser.OwnedHint'}}"{{/if}}>{{#if owned}}<i class="fa-solid fa-check" aria-hidden="true"></i>{{else}}<i class="fa-solid fa-plus" aria-hidden="true"></i>{{/if}}</button>{{/if}}
    </li>
  {{else}}<li class="muted">{{localize "SPYCRAFT.Browser.Empty"}}</li>{{/each}}
</ul>
<aside class="browser-preview" aria-live="polite" {{#if preview}}data-uuid="{{preview.uuid}}"{{/if}}>
  {{#if preview}}
    <header class="preview-head">{{#if preview.img}}<img src="{{preview.img}}" alt="" />{{/if}}<div><strong class="preview-name">{{preview.name}}</strong><span class="muted">{{preview.groupLabel}}{{#if preview.extra}} · {{preview.extra}}{{/if}}</span></div></header>
    {{#if preview.future}}<p class="hint">{{localize "SPYCRAFT.Browser.NotYetHint"}}</p>{{/if}}
    {{#unless preview.qualified}}<p><span class="sc2-stamp">{{localize "SPYCRAFT.Browser.NotQualified"}}</span></p>{{/unless}}
    {{#if preview.prereq}}<p class="prereq {{#unless preview.qualified}}bad{{/unless}}">{{preview.prereq}}</p>{{/if}}
    <div class="preview-text sc2-prose">{{{preview.description}}}</div>
    <p class="preview-actions">
      {{#if actor}}<button type="button" class="sc2-primary-action" data-sc2-display="text" data-action="add" {{#if preview.locked}}disabled data-tooltip="{{localize 'SPYCRAFT.Browser.OwnedHint'}}"{{/if}}>{{localize 'SPYCRAFT.Browser.AddEntry' name=preview.name}}</button>{{/if}}
      <button type="button" data-action="open">{{localize "SPYCRAFT.Browser.OpenSheet"}}</button>
    </p>
  {{else}}<p class="sc2-empty">{{localize "SPYCRAFT.Browser.PreviewHint"}}</p>{{/if}}
</aside>
</div>
</div>
