<div class="browser">
<div class="dossier-band" aria-hidden="true">
  <img class="agency-seal" src="systems/spycraft2/assets/retro/agency-seal.svg" alt="" />
  <span class="file-label">{{localize "SPYCRAFT.Retro.Archive"}}</span>
  <span class="file-stamp">{{localize "SPYCRAFT.Retro.Classified"}}</span>
</div>
  {{#if missingPack}}<p class="bad">{{localize "SPYCRAFT.Browser.MissingPack"}}</p>{{/if}}
  <div class="filters">
    <input type="search" name="search" value="{{filters.search}}" placeholder="{{localize 'SPYCRAFT.Browser.Search'}}" aria-label="{{localize 'SPYCRAFT.Action.SearchCatalog'}}" />
    <select name="group" aria-label="{{localize 'SPYCRAFT.Action.CatalogGroup'}}">{{selectOptions groups selected=filters.group blank=(localize "SPYCRAFT.Browser.All")}}</select>
    {{#if showAcquisitionSources}}<label>{{localize "SPYCRAFT.Template.AppsBrowser.FeatSource"}} <select name="acquisitionSource">{{selectOptions acquisitionSources selected=filters.acquisitionSource}}</select></label>{{/if}}
    {{#if hasPrereqs}}<label><input type="checkbox" name="qualifiedOnly" {{checked filters.qualifiedOnly}} /> {{localize "SPYCRAFT.Browser.QualifiedOnly"}}</label>{{/if}}
  </div>
  <div class="browser-panes">
  <ul class="browser-list">
    {{#each rows}}
      <li data-uuid="{{uuid}}" class="{{#unless qualified}}unqualified{{/unless}} {{#if owned}}owned{{/if}} {{#if selected}}selected{{/if}}">
        <div class="row-main">
          <button type="button" data-action="select" class="name sc2-action sc2-text-action" data-sc2-display="text" aria-current="{{#if selected}}true{{else}}false{{/if}}">{{name}}</button>
          {{#unless qualified}}<span class="tag unqualified-tag">{{localize "SPYCRAFT.Browser.NotQualified"}}</span>{{/unless}}
          <span class="muted">{{groupLabel}}{{#if extra}} · {{extra}}{{/if}}</span>
          {{#if prereq}}<div class="prereq {{#unless qualified}}bad{{/unless}}" data-tooltip="{{unmet}}">{{prereq}}{{#if notChecked}} <span class="tag">{{localize "SPYCRAFT.Feat.NotChecked"}}</span>{{/if}}</div>{{/if}}
        </div>
        {{#if ../actor}}<button type="button" data-sc2-display="icon" data-action="add" aria-label="{{localize 'SPYCRAFT.Browser.AddEntry' name=name}}" {{#if owned}}class="owned"{{/if}} {{#if locked}}disabled data-tooltip="SPYCRAFT.Browser.OwnedHint"{{/if}}>{{#if owned}}<i class="fa-solid fa-check"></i>{{else}}<i class="fa-solid fa-plus"></i>{{/if}}</button>{{/if}}
      </li>
    {{else}}<li class="muted">{{localize "SPYCRAFT.Browser.Empty"}}</li>{{/each}}
  </ul>
  <aside class="browser-preview" aria-live="polite" {{#if preview}}data-uuid="{{preview.uuid}}"{{/if}}>
    {{#if preview}}
      <header class="preview-head">{{#if preview.img}}<img src="{{preview.img}}" alt="" />{{/if}}<div><strong class="preview-name">{{preview.name}}</strong><span class="muted">{{preview.groupLabel}}{{#if preview.extra}} · {{preview.extra}}{{/if}}</span></div></header>
      {{#unless preview.qualified}}<p><span class="sc2-stamp">{{localize "SPYCRAFT.Browser.NotQualified"}}</span></p>{{/unless}}
      {{#if preview.prereq}}<p class="prereq {{#unless preview.qualified}}bad{{/unless}}">{{preview.prereq}}</p>{{/if}}
      <div class="preview-text">{{{preview.description}}}</div>
      <p class="preview-actions">
        {{#if actor}}<button type="button" class="sc2-primary-action" data-sc2-display="text" data-action="add" {{#if preview.locked}}disabled data-tooltip="SPYCRAFT.Browser.OwnedHint"{{/if}}>{{localize 'SPYCRAFT.Browser.AddEntry' name=preview.name}}</button>{{/if}}
        <button type="button" data-action="open">{{localize "SPYCRAFT.Browser.OpenSheet"}}</button>
      </p>
    {{else}}<p class="sc2-empty">{{localize "SPYCRAFT.Browser.PreviewHint"}}</p>{{/if}}
  </aside>
  </div>
</div>
