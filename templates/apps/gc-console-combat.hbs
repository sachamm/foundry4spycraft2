  <details class="gc-section" data-section="combat" data-view-hidden="{{hiddenSections.combat}}" data-state="{{sections.combat.state}}" {{#if sections.combat.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.Combat"}}</span>{{#if combat}}<span class="gc-note">{{localize "SPYCRAFT.Template.AppsGcConsole.Round"}} {{combat.round}}</span>{{/if}}</summary>
    {{#if combat}}{{#if combat.surprise}}<p>{{localize "SPYCRAFT.Template.AppsGcConsole.SurpriseRound"}} {{combat.surprise.winners}} {{localize "SPYCRAFT.Template.AppsGcConsole.Act"}}</p>{{/if}}
    {{#if combat.acting}}{{#with combat.acting}}
    <section class="gc-acting" aria-label="{{localize 'SPYCRAFT.Console.Acting'}}">
      <h3><button type="button" class="gc-row-button" data-action="openCombatant" data-id="{{id}}" data-tooltip="{{localize 'SPYCRAFT.Console.OpenCombatantHint'}}">{{name}}</button></h3>
      <div class="gc-facts">
        {{#if defense}}<div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Console.Defense"}}</span><b class="sc2-value">{{defense}}</b></div>{{/if}}
        <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Console.Health"}}</span><span class="sc2-value">{{health}}</span></div>
        <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Console.TurnLeft"}}</span><span class="sc2-value">{{halfActions}}</span></div>
        {{#if conditions}}<div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Console.Conditions"}}</span><span class="sc2-value">{{conditions}}</span></div>{{/if}}
      </div>
      {{#if weapons.length}}<p class="controls">{{#each weapons}}<button type="button" data-action="actingAttack" data-id="{{id}}" data-tooltip="{{localize 'SPYCRAFT.Console.AttackHint'}}">{{localize "SPYCRAFT.Console.AttackWith" weapon=name}}</button>{{/each}}</p>{{/if}}
      <p class="controls">{{#unless defeated}}<button type="button" data-action="actingSpend" data-kind="half">{{localize "SPYCRAFT.Console.SpendHalf"}}</button><button type="button" data-action="actingSpend" data-kind="full">{{localize "SPYCRAFT.Console.SpendFull"}}</button><button type="button" data-action="actingDelay">{{localize "SPYCRAFT.Console.Delay"}}</button><button type="button" data-action="actingReady">{{localize "SPYCRAFT.Console.Ready"}}</button>{{#if standard}}<button type="button" data-action="actingDamageSave">{{localize "SPYCRAFT.Console.DamageSave"}}</button>{{/if}}{{/unless}}<button type="button" data-action="cardNextStep" data-tooltip="{{localize 'SPYCRAFT.Console.CardNextStepHint'}}">{{localize "SPYCRAFT.Console.CardNextStep"}}</button></p>
    </section>
    {{/with}}{{/if}}
    <p class="controls gc-turn-controls"><button type="button" data-action="previousTurn" {{#unless combat.started}}disabled{{/unless}}>{{localize "SPYCRAFT.Template.AppsGcConsole.PreviousTurn"}}</button><button type="button" class="gc-primary" data-action="nextTurn">{{#if combat.started}}{{localize "SPYCRAFT.Template.AppsGcConsole.NextTurn"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.BeginCombat"}}{{/if}}</button></p>
    {{#if combat.mobs.length}}<p class="controls">{{#each combat.mobs}}<button type="button" data-action="mobAttack" data-key="{{key}}" {{#unless ../combat.started}}disabled{{/unless}}>{{label}}</button>{{/each}}</p>{{/if}}
    <ul class="gc-combat-rows">{{#each combat.combatants}}<li{{#if current}} class="gc-current-turn" aria-current="true"{{/if}}{{#if defeated}} data-defeated="true"{{/if}}><button type="button" class="gc-row-button" data-action="openCombatant" data-id="{{id}}"><span class="gc-row-name">{{name}}</span> <span class="gc-row-count">{{count}}</span>{{#if notes}} <span class="gc-note">{{notes}}</span>{{/if}}</button></li>{{/each}}</ul>
    {{#if combat.unrolled}}<p class="gc-note">{{localize "SPYCRAFT.Console.Unrolled" count=combat.unrolled}}</p>{{/if}}{{else}}<p class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoActiveCombat"}}</p>{{/if}}
    <p class="controls"><button type="button" data-action="surprise">{{localize "SPYCRAFT.Template.AppsGcConsole.SurpriseRound2"}}</button><button type="button" data-action="groupInitiative" data-single="false">{{localize "SPYCRAFT.Template.AppsGcConsole.RollNPCInitiativeByType"}}</button><button type="button" data-action="groupInitiative" data-single="true">{{localize "SPYCRAFT.Template.AppsGcConsole.OneRollForAllNPCs"}}</button><button type="button" data-action="fluidEvent">{{localize "SPYCRAFT.Template.AppsGcConsole.FluidInitiativeEvent"}}</button><button type="button" data-action="combatReference">{{localize "SPYCRAFT.Template.AppsGcConsole.CombatReferences"}}</button></p>
  </details>
