<section class="spycraft2 gc-console-body">
  <h2>{{localize "SPYCRAFT.Template.AppsGcConsole.Mission"}}{{#if mission.name}}: {{mission.name}}{{/if}} {{#if mission.active}}<span class="tag">{{localize "SPYCRAFT.Template.AppsGcConsole.Active"}}</span>{{else}}<span class="tag muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NotStarted"}}</span>{{/if}}</h2>
  <p>{{localize "SPYCRAFT.Template.AppsGcConsole.ThreatLevel"}} <b>{{mission.threatLevel}}</b> ({{mission.threatNote}}{{localize "SPYCRAFT.Template.AppsGcConsole.Caliber"}} <b>{{mission.caliberLabel}}</b> {{localize "SPYCRAFT.Template.AppsGcConsole.StandingRewardReputation"}} {{mission.standing.reputation}} {{localize "SPYCRAFT.Template.AppsGcConsole.NetWorth"}}{{mission.standing.netWorth}}{{#if mission.bonusDice}} · +{{mission.bonusDice}} {{localize "SPYCRAFT.Template.AppsGcConsole.StartingActionDicePerPlayerP"}}{{/if}}</p>
  <p>{{localize "SPYCRAFT.Template.AppsGcConsole.Team"}} {{#each mission.team}}{{name}} (L{{level}}){{#unless @last}}, {{/unless}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.NoAgents"}}{{/each}}</p>
  <p class="controls">
    <button type="button" data-action="editMission">{{localize "SPYCRAFT.Template.AppsGcConsole.EditMission"}}</button>
    {{#if mission.active}}<button type="button" data-action="recalculateTL">{{localize "SPYCRAFT.Template.AppsGcConsole.RecalculateThreatLevel"}}</button><button type="button" data-action="endMission">{{localize "SPYCRAFT.Template.AppsGcConsole.EndMission"}}</button>{{else}}<button type="button" data-action="startMission">{{localize "SPYCRAFT.Template.AppsGcConsole.StartMission"}}</button>{{/if}}
    <button type="button" data-action="clearMission">{{localize "SPYCRAFT.Template.AppsGcConsole.ClearRecord"}}</button>
    {{#if mission.canRaiseCaliber}}<button type="button" data-action="caliberIncrease">{{localize "SPYCRAFT.Template.AppsGcConsole.Caliber1GCGains2Dice"}}</button>{{/if}}
    <button type="button" data-action="sessionDice">{{localize "SPYCRAFT.Template.AppsGcConsole.ApplyStartingDiceAdjustments"}}</button>
  </p>

  <h3>{{localize "SPYCRAFT.Template.AppsGcConsole.Objectives"}} <button type="button" data-action="addObjective">{{localize "SPYCRAFT.Template.AppsGcConsole.Add"}}</button></h3>
  <ul>{{#each mission.objectives}}<li>{{#if complete}}✔{{else}}○{{/if}} {{name}} {{localize "SPYCRAFT.Template.AppsGcConsole.Grade"}} {{grade}} ({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP"}}{{#if critical}} · <b>{{localize "SPYCRAFT.Template.AppsGcConsole.Critical"}}</b>{{/if}}
    — <a data-action="entry" data-list="objectives" data-key="{{id}}" data-change="complete">{{#if complete}}{{localize "SPYCRAFT.Template.AppsGcConsole.Undo"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.Complete"}}{{/if}}</a> · <a data-action="entry" data-list="objectives" data-key="{{id}}" data-change="critical">{{localize "SPYCRAFT.Template.AppsGcConsole.Critical"}}</a> · <a data-action="entry" data-list="objectives" data-key="{{id}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</a></li>{{else}}<li class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoneYet"}}</li>{{/each}}</ul>

  <h3>{{localize "SPYCRAFT.Template.AppsGcConsole.Antagonists"}} <button type="button" data-action="addAntagonist">{{localize "SPYCRAFT.Template.AppsGcConsole.Add"}}</button></h3>
  <ul>{{#each mission.antagonists}}<li>{{#if encountered}}✔{{else}}○{{/if}} {{name}} — {{#if full}}{{localize "SPYCRAFT.Template.AppsGcConsole.FullSpecial300XP"}} {{scenes}} {{localize "SPYCRAFT.Template.AppsGcConsole.SceneS"}}{{else}}{{type}}, {{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP2"}}{{/if}}
    — <a data-action="entry" data-list="antagonists" data-key="{{id}}" data-change="encountered">{{#if encountered}}{{localize "SPYCRAFT.Template.AppsGcConsole.NotFaced"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.FacedAsAThreat"}}{{/if}}</a> · <a data-action="entry" data-list="antagonists" data-key="{{id}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</a></li>{{else}}<li class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoneYet"}}</li>{{/each}}</ul>

  <h3>{{localize "SPYCRAFT.Template.AppsGcConsole.Complications"}} <button type="button" data-action="addComplication">{{localize "SPYCRAFT.Template.AppsGcConsole.Add"}}</button></h3>
  <ul>
    <li>{{localize "SPYCRAFT.Template.AppsGcConsole.ScriptedDramaticScenes"}} {{mission.dramaticScenes}}{{#if mission.timeLimit}} {{localize "SPYCRAFT.Template.AppsGcConsole.TimeLimit"}}{{/if}}{{#if mission.bundleCommonItems}} · {{mission.bundleCommonItems}} {{localize "SPYCRAFT.Template.AppsGcConsole.CommonItemsInTheBundle"}}{{/if}}</li>
    {{#each mission.qualities}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.CampaignQuality"}} {{name}} {{#if added}}{{localize "SPYCRAFT.Template.AppsGcConsole.AddedInPlayNoXP"}}{{else}}({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP"}}{{/if}} <a data-action="entry" data-list="qualities" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</a></li>{{/each}}
    {{#each mission.security}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.Security"}} {{name}} ({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP2"}}{{#if ignored}}{{localize "SPYCRAFT.Template.AppsGcConsole.IgnoredHalf"}}{{/if}}) — <a data-action="entry" data-list="security" data-key="{{key}}" data-change="ignored">{{localize "SPYCRAFT.Template.AppsGcConsole.Ignored"}}</a> · <a data-action="entry" data-list="security" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</a></li>{{/each}}
    {{#each mission.gearRestrictions}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.GearRestriction"}} {{name}} — <a data-action="entry" data-list="gearRestrictions" data-key="{{key}}" data-change="ignored">{{localize "SPYCRAFT.Template.AppsGcConsole.Ignored"}}</a> · <a data-action="entry" data-list="gearRestrictions" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</a></li>{{/each}}
    {{#each mission.exposure}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.Exposure"}} {{name}} — <a data-action="entry" data-list="exposure" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</a></li>{{/each}}
    {{#each mission.bundle}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.Bundle"}} {{name}} {{localize "SPYCRAFT.Template.AppsGcConsole.Caliber2"}} {{caliber}}) — <a data-action="entry" data-list="bundle" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</a></li>{{/each}}
    {{#each mission.otherComplications}}<li>{{name}} ({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP2"}}{{#if ignored}}{{localize "SPYCRAFT.Template.AppsGcConsole.IgnoredHalf"}}{{/if}}) — <a data-action="entry" data-list="otherComplications" data-key="{{key}}" data-change="ignored">{{localize "SPYCRAFT.Template.AppsGcConsole.Ignored"}}</a> · <a data-action="entry" data-list="otherComplications" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</a></li>{{/each}}
  </ul>
  <p>{{localize "SPYCRAFT.Template.AppsGcConsole.BaseXPEarnedSoFar"}} <b>{{xp.earned}}</b> {{localize "SPYCRAFT.Template.AppsGcConsole.Of"}} {{xp.planned}} {{localize "SPYCRAFT.Template.AppsGcConsole.Scripted"}}{{#if xp.perScene}} · {{xp.perScene}} {{localize "SPYCRAFT.Template.AppsGcConsole.PerScenePlayed"}}{{mission.scenesPlayed}}){{/if}}.
    {{#each xp.warnings}}<span class="bad">{{this}}</span> {{/each}}</p>
  <p class="controls"><button type="button" data-action="sceneAdvance">{{localize "SPYCRAFT.Template.AppsGcConsole.CountAScenePlayed"}}</button><button type="button" data-action="missionReport" data-planned="false">{{localize "SPYCRAFT.Template.AppsGcConsole.XPReport"}}</button><button type="button" data-action="missionReport" data-planned="true">{{localize "SPYCRAFT.Template.AppsGcConsole.PlannedXP"}}</button><button type="button" data-action="recordInfraction">{{localize "SPYCRAFT.Template.AppsGcConsole.RecordExposureInfraction"}}</button><button type="button" data-action="awardStanding">{{localize "SPYCRAFT.Template.AppsGcConsole.AwardReputationNetWorth"}}</button></p>
  {{#if mission.infractions.length}}<p>{{localize "SPYCRAFT.Template.AppsGcConsole.Infractions"}} {{#each mission.infractions}}{{actorName}} — {{name}} ({{penalty}} {{currency}}){{#unless @last}}; {{/unless}}{{/each}}</p>{{/if}}

  <h2>{{localize "SPYCRAFT.Template.AppsGcConsole.SceneAndGCActionDice"}}</h2>
  <p>{{localize "SPYCRAFT.Template.AppsGcConsole.GCDice"}} {{#if dice.current}}<b>{{dice.value}}</b>{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.NotInitializedThisSession"}}{{/if}} {{localize "SPYCRAFT.Template.AppsGcConsole.StartingPool"}} {{dice.expected}}{{localize "SPYCRAFT.Template.AppsGcConsole.PlayersPresent2CaliberScene"}} <b>{{#if scene.dramatic}}{{localize "SPYCRAFT.Template.AppsGcConsole.Dramatic"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.Standard"}}{{/if}}</b>.</p>
  <p class="controls"><button type="button" data-action="gcDice">{{localize "SPYCRAFT.Template.AppsGcConsole.PoolHintsAndAwards"}}</button><button type="button" data-action="spendDice">{{localize "SPYCRAFT.Template.AppsGcConsole.SpendDice"}}</button>
    {{#if scene.dramatic}}<button type="button" data-action="dramaticOff">{{localize "SPYCRAFT.Template.AppsGcConsole.ReturnToAStandardScene"}}</button><button type="button" data-action="doubleInitiative">{{localize "SPYCRAFT.Template.AppsGcConsole.DoubleOpponentsInitiative"}}</button>{{else}}<button type="button" data-action="dramaticOn">{{localize "SPYCRAFT.Template.AppsGcConsole.ScriptedDramaticSceneNoCost"}}</button>{{/if}}</p>

  <h2>{{localize "SPYCRAFT.Template.AppsGcConsole.Combat"}}</h2>
  {{#if combat}}<p>{{localize "SPYCRAFT.Template.AppsGcConsole.Round"}} {{combat.round}}{{#if combat.surprise}} {{localize "SPYCRAFT.Template.AppsGcConsole.SurpriseRound"}} {{combat.surprise.winners}} {{localize "SPYCRAFT.Template.AppsGcConsole.Act"}}{{/if}}</p>
  <ul>{{#each combat.combatants}}<li>{{name}} {{localize "SPYCRAFT.Template.AppsGcConsole.Count"}} {{count}}{{#if pending}} ({{pending}} {{localize "SPYCRAFT.Template.AppsGcConsole.Pending"}}{{/if}}{{#if mustPress}} {{localize "SPYCRAFT.Template.AppsGcConsole.MustPress"}}{{/if}}</li>{{/each}}</ul>{{else}}<p class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoActiveCombat"}}</p>{{/if}}
  <p class="controls"><button type="button" data-action="surprise">{{localize "SPYCRAFT.Template.AppsGcConsole.SurpriseRound2"}}</button><button type="button" data-action="groupInitiative" data-single="false">{{localize "SPYCRAFT.Template.AppsGcConsole.RollNPCInitiativeByType"}}</button><button type="button" data-action="groupInitiative" data-single="true">{{localize "SPYCRAFT.Template.AppsGcConsole.OneRollForAllNPCs"}}</button><button type="button" data-action="fluidEvent">{{localize "SPYCRAFT.Template.AppsGcConsole.FluidInitiativeEvent"}}</button></p>

  <h2>{{localize "SPYCRAFT.Template.AppsGcConsole.DramaticConflicts"}} <button type="button" data-action="startConflict">{{localize "SPYCRAFT.Template.AppsGcConsole.Start"}}</button></h2>
  <ul>{{#each conflicts}}<li><b>{{name}}</b> ({{type}}{{localize "SPYCRAFT.Template.AppsGcConsole.Round2"}} {{round}}{{localize "SPYCRAFT.Template.AppsGcConsole.Lead"}} <b>{{lead}}</b>, {{predator}} {{localize "SPYCRAFT.Template.AppsGcConsole.Vs"}} {{prey}} · {{#if winner}}{{localize "SPYCRAFT.Template.AppsGcConsole.Ended"}} {{winner}} {{localize "SPYCRAFT.Template.AppsGcConsole.Wins"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.Step"}} {{step}}{{/if}}
    — {{#unless winner}}<a data-action="advanceConflict" data-id="{{id}}">{{localize "SPYCRAFT.Template.AppsGcConsole.NextStep"}}</a> · {{/unless}}<a data-action="manageConflict" data-id="{{id}}">{{localize "SPYCRAFT.Template.AppsGcConsole.Manage"}}</a></li>{{else}}<li class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoneRunning"}}</li>{{/each}}</ul>

  <h2>{{localize "SPYCRAFT.Template.AppsGcConsole.CampaignQualities"}} <button type="button" data-action="seasonQualities">{{localize "SPYCRAFT.Template.AppsGcConsole.SeasonQualities"}}</button></h2>
  <ul>{{#each season}}<li title="{{summary}}">{{name}} ({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP3"}} {{summary}}</li>{{else}}<li class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoSeasonLongQualities"}}</li>{{/each}}</ul>
  {{#if effects.length}}<p>{{localize "SPYCRAFT.Template.AppsGcConsole.CombinedNumericEffects"}} {{#each effects}}{{key}} {{value}}{{#unless @last}}; {{/unless}}{{/each}}</p>{{/if}}
  {{#each effectConflicts}}<p class="bad">{{key}} {{localize "SPYCRAFT.Template.AppsGcConsole.IsSetDifferentlyBy"}} {{qualities}}{{localize "SPYCRAFT.Template.AppsGcConsole.GCRulingNeeded"}}</p>{{/each}}

  <h2>{{localize "SPYCRAFT.Template.AppsGcConsole.Reference"}}</h2>
  <p class="controls"><button type="button" data-action="securityDevice">{{localize "SPYCRAFT.Template.AppsGcConsole.SecurityDevice"}}</button><button type="button" data-action="hazards">{{localize "SPYCRAFT.Template.AppsGcConsole.HazardsNatureSFury"}}</button><button type="button" data-action="events">{{localize "SPYCRAFT.Template.AppsGcConsole.Events"}}</button><button type="button" data-action="possessions">{{localize "SPYCRAFT.Template.AppsGcConsole.RandomPossessions"}}</button></p>
</section>
