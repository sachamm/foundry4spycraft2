<section class="spycraft2 gc-console-body">
  <div class="gc-now" role="status">
    <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Console.Time"}}</span><b class="sc2-value">{{clock.now}}</b></div>
    <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Console.Scene"}}</span><b class="sc2-value">{{#if scene.dramatic}}{{localize "SPYCRAFT.Template.AppsGcConsole.Dramatic"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.Standard"}}{{/if}}</b></div>
    <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Console.Dice"}}</span><b class="sc2-value">{{#if dice.current}}{{dice.value}}{{else}}—{{/if}}</b></div>
    <div class="sc2-field"><span class="sc2-caption">{{localize "SPYCRAFT.Console.Round"}}</span><b class="sc2-value">{{#if combat}}{{combat.round}}{{else}}—{{/if}}</b></div>
  </div>
  <p class="controls gc-session-steps">
    <button type="button" data-action="beginSession" {{#unless dice.current}}class="gc-primary"{{/unless}} data-tooltip="{{localize 'SPYCRAFT.Console.BeginSessionHint'}}">{{localize "SPYCRAFT.Console.BeginSession"}}</button>
    <button type="button" data-action="nextScene" data-tooltip="{{localize 'SPYCRAFT.Console.NextSceneHint'}}">{{localize "SPYCRAFT.Console.NextScene"}}</button>
  </p>
  <details class="gc-section" data-section="clock" data-state="{{sections.clock.state}}" {{#if sections.clock.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{clock.title}}</span><span class="gc-note">{{clock.now}}</span></summary>
    <p class="controls gc-clock-steps">{{#each clock.steps}}<button type="button" data-action="clockStep" data-seconds="{{seconds}}">{{label}}</button>{{/each}}<button type="button" data-action="clockAdvance">{{clock.advance}}</button><button type="button" data-action="clockDate">{{clock.setDate}}</button><button type="button" data-action="clockOpen">{{clock.open}}</button></p>
  </details>
  <details class="gc-section" data-section="mission" data-state="{{sections.mission.state}}" {{#if sections.mission.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.Mission"}}{{#if mission.name}}: {{mission.name}}{{/if}} {{#if mission.active}}<span class="tag">{{localize "SPYCRAFT.Template.AppsGcConsole.Active"}}</span>{{else}}<span class="tag muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NotStarted"}}</span>{{/if}}</span></summary>
    <p>{{localize "SPYCRAFT.Template.AppsGcConsole.ThreatLevel"}} <b>{{mission.threatLevel}}</b> ({{mission.threatNote}}{{localize "SPYCRAFT.Template.AppsGcConsole.Caliber"}} <b>{{mission.caliberLabel}}</b> {{localize "SPYCRAFT.Template.AppsGcConsole.StandingRewardReputation"}} {{mission.standing.reputation}} {{localize "SPYCRAFT.Template.AppsGcConsole.NetWorth"}}{{mission.standing.netWorth}}{{#if mission.bonusDice}} · +{{mission.bonusDice}} {{localize "SPYCRAFT.Template.AppsGcConsole.StartingActionDicePerPlayerP"}}{{/if}}</p>
    <p>{{localize "SPYCRAFT.Template.AppsGcConsole.Team"}} {{#each mission.team}}{{name}} (L{{level}}){{#unless @last}}, {{/unless}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.NoAgents"}}{{/each}}</p>
    <p class="controls">
      <button type="button" data-action="editMission" {{#if mission.active}}class="gc-primary"{{/if}}>{{localize "SPYCRAFT.Template.AppsGcConsole.EditMission"}}</button>
      {{#if mission.active}}<button type="button" data-action="recalculateTL">{{localize "SPYCRAFT.Template.AppsGcConsole.RecalculateThreatLevel"}}</button><button type="button" data-action="endMission">{{localize "SPYCRAFT.Template.AppsGcConsole.EndMission"}}</button>{{else}}<button type="button" class="gc-primary" data-action="startMission">{{localize "SPYCRAFT.Template.AppsGcConsole.StartMission"}}</button>{{/if}}
      <button type="button" data-action="clearMission">{{localize "SPYCRAFT.Template.AppsGcConsole.ClearRecord"}}</button>
      {{#if mission.canRaiseCaliber}}<button type="button" data-action="caliberIncrease">{{localize "SPYCRAFT.Template.AppsGcConsole.Caliber1GCGains2Dice"}}</button>{{/if}}
      <button type="button" data-action="sessionDice">{{localize "SPYCRAFT.Template.AppsGcConsole.ApplyStartingDiceAdjustments"}}</button>
    </p>
    <p>{{localize "SPYCRAFT.Template.AppsGcConsole.BaseXPEarnedSoFar"}} <b>{{xp.earned}}</b> {{localize "SPYCRAFT.Template.AppsGcConsole.Of"}} {{xp.planned}} {{localize "SPYCRAFT.Template.AppsGcConsole.Scripted"}}{{#if xp.perScene}} · {{xp.perScene}} {{localize "SPYCRAFT.Template.AppsGcConsole.PerScenePlayed"}}{{mission.scenesPlayed}}){{/if}}.
      {{#each xp.warnings}}<span class="bad">{{this}}</span> {{/each}}</p>
    <p class="controls"><button type="button" data-action="sceneAdvance">{{localize "SPYCRAFT.Template.AppsGcConsole.CountAScenePlayed"}}</button><button type="button" data-action="missionReport" data-planned="false">{{localize "SPYCRAFT.Template.AppsGcConsole.XPReport"}}</button><button type="button" data-action="missionReport" data-planned="true">{{localize "SPYCRAFT.Template.AppsGcConsole.PlannedXP"}}</button><button type="button" data-action="recordInfraction">{{localize "SPYCRAFT.Template.AppsGcConsole.RecordExposureInfraction"}}</button><button type="button" data-action="awardStanding">{{localize "SPYCRAFT.Template.AppsGcConsole.AwardReputationNetWorth"}}</button></p>
    {{#if mission.infractions.length}}<p>{{localize "SPYCRAFT.Template.AppsGcConsole.Infractions"}} {{#each mission.infractions}}{{actorName}} — {{name}} ({{penalty}} {{currency}}){{#unless @last}}; {{/unless}}{{/each}}</p>{{/if}}
  </details>
  <details class="gc-section" data-section="objectives" data-state="{{sections.objectives.state}}" {{#if sections.objectives.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.Objectives"}}</span><span class="gc-note">{{counts.objectives}}</span></summary>
    <p class="controls"><button type="button" class="gc-primary" data-action="addObjective">{{localize "SPYCRAFT.Template.AppsGcConsole.Add"}}</button></p>
    <ul data-sc2-display="icon">{{#each mission.objectives}}<li>{{#if complete}}✔{{else}}○{{/if}} {{name}} {{localize "SPYCRAFT.Template.AppsGcConsole.Grade"}} {{grade}} ({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP"}}{{#if critical}} · <b>{{localize "SPYCRAFT.Template.AppsGcConsole.Critical"}}</b>{{/if}}
    — <button type="button" class="sc2-action" data-action="entry" data-list="objectives" data-key="{{id}}" data-change="complete">{{#if complete}}{{localize "SPYCRAFT.Template.AppsGcConsole.Undo"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.Complete"}}{{/if}}</button> <button type="button" class="sc2-action" data-action="entry" data-list="objectives" data-key="{{id}}" data-change="critical">{{localize "SPYCRAFT.Template.AppsGcConsole.Critical"}}</button> <button type="button" class="sc2-action" data-action="entry" data-list="objectives" data-key="{{id}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</button></li>{{else}}<li class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoneYet"}}</li>{{/each}}</ul>
  </details>
  <details class="gc-section" data-section="antagonists" data-state="{{sections.antagonists.state}}" {{#if sections.antagonists.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.Antagonists"}}</span><span class="gc-note">{{counts.antagonists}}</span></summary>
    <p class="controls"><button type="button" class="gc-primary" data-action="addNpcToScene">{{localize "SPYCRAFT.Template.AppsGcConsole.AddNpcToScene"}}</button> <button type="button" class="sc2-action" data-action="addAntagonist" data-tooltip="{{localize 'SPYCRAFT.Template.AppsGcConsole.RecordForXPHint'}}">{{localize "SPYCRAFT.Template.AppsGcConsole.RecordForXP"}}</button></p>
    <ul data-sc2-display="icon">{{#each mission.antagonists}}<li>{{#if encountered}}✔{{else}}○{{/if}} {{name}} — {{#if full}}{{localize "SPYCRAFT.Template.AppsGcConsole.FullSpecial300XP"}} {{scenes}} {{localize "SPYCRAFT.Template.AppsGcConsole.SceneS"}}{{else}}{{type}}, {{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP2"}}{{/if}}
    — <button type="button" class="sc2-action" data-action="entry" data-list="antagonists" data-key="{{id}}" data-change="encountered">{{#if encountered}}{{localize "SPYCRAFT.Template.AppsGcConsole.NotFaced"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.FacedAsAThreat"}}{{/if}}</button> <button type="button" class="sc2-action" data-action="entry" data-list="antagonists" data-key="{{id}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</button></li>{{else}}<li class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoneYet"}}</li>{{/each}}</ul>
  </details>
  <details class="gc-section" data-section="complications" data-state="{{sections.complications.state}}" {{#if sections.complications.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.Complications"}}</span></summary>
    <p class="controls"><button type="button" class="gc-primary" data-action="addComplication">{{localize "SPYCRAFT.Template.AppsGcConsole.Add"}}</button></p>
    <ul data-sc2-display="icon">
    <li>{{localize "SPYCRAFT.Template.AppsGcConsole.ScriptedDramaticScenes"}} {{mission.dramaticScenes}}{{#if mission.timeLimit}} {{localize "SPYCRAFT.Template.AppsGcConsole.TimeLimit"}}{{/if}}{{#if mission.bundleCommonItems}} · {{mission.bundleCommonItems}} {{localize "SPYCRAFT.Template.AppsGcConsole.CommonItemsInTheBundle"}}{{/if}}</li>
    {{#each mission.qualities}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.CampaignQuality"}} {{name}} {{#if added}}{{localize "SPYCRAFT.Template.AppsGcConsole.AddedInPlayNoXP"}}{{else}}({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP"}}{{/if}} <button type="button" class="sc2-action" data-action="entry" data-list="qualities" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</button></li>{{/each}}
    {{#each mission.security}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.Security"}} {{name}} ({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP2"}}{{#if ignored}}{{localize "SPYCRAFT.Template.AppsGcConsole.IgnoredHalf"}}{{/if}}) — <button type="button" class="sc2-action" data-action="entry" data-list="security" data-key="{{key}}" data-change="ignored">{{localize "SPYCRAFT.Template.AppsGcConsole.Ignored"}}</button> <button type="button" class="sc2-action" data-action="entry" data-list="security" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</button></li>{{/each}}
    {{#each mission.gearRestrictions}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.GearRestriction"}} {{name}} — <button type="button" class="sc2-action" data-action="entry" data-list="gearRestrictions" data-key="{{key}}" data-change="ignored">{{localize "SPYCRAFT.Template.AppsGcConsole.Ignored"}}</button> <button type="button" class="sc2-action" data-action="entry" data-list="gearRestrictions" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</button></li>{{/each}}
    {{#each mission.exposure}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.Exposure"}} {{name}} — <button type="button" class="sc2-action" data-action="entry" data-list="exposure" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</button></li>{{/each}}
    {{#each mission.bundle}}<li>{{localize "SPYCRAFT.Template.AppsGcConsole.Bundle"}} {{name}} {{localize "SPYCRAFT.Template.AppsGcConsole.Caliber2"}} {{caliber}}) — <button type="button" class="sc2-action" data-action="entry" data-list="bundle" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</button></li>{{/each}}
    {{#each mission.otherComplications}}<li>{{name}} ({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP2"}}{{#if ignored}}{{localize "SPYCRAFT.Template.AppsGcConsole.IgnoredHalf"}}{{/if}}) — <button type="button" class="sc2-action" data-action="entry" data-list="otherComplications" data-key="{{key}}" data-change="ignored">{{localize "SPYCRAFT.Template.AppsGcConsole.Ignored"}}</button> <button type="button" class="sc2-action" data-action="entry" data-list="otherComplications" data-key="{{key}}" data-change="remove">{{localize "SPYCRAFT.Template.AppsGcConsole.Remove"}}</button></li>{{/each}}
    </ul>
  </details>
  <details class="gc-section" data-section="dice" data-state="{{sections.dice.state}}" {{#if sections.dice.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.SceneAndGCActionDice"}}</span><span class="gc-note">{{#if dice.current}}{{dice.value}}{{/if}}</span></summary>
    <p>{{localize "SPYCRAFT.Template.AppsGcConsole.GCDice"}} {{#if dice.current}}<b>{{dice.value}}</b>{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.NotInitializedThisSession"}}{{/if}} {{localize "SPYCRAFT.Template.AppsGcConsole.StartingPool"}} {{dice.expected}}{{localize "SPYCRAFT.Template.AppsGcConsole.PlayersPresent2CaliberScene"}} <b>{{#if scene.dramatic}}{{localize "SPYCRAFT.Template.AppsGcConsole.Dramatic"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.Standard"}}{{/if}}</b>.</p>
    <p class="controls"><button type="button" data-action="gcDice">{{#if dice.current}}{{localize "SPYCRAFT.Template.AppsGcConsole.PoolHintsAndAwards"}}{{else}}{{localize "SPYCRAFT.Console.SetUpPool"}}{{/if}}</button><button type="button" class="gc-primary" data-action="spendDice">{{localize "SPYCRAFT.Template.AppsGcConsole.SpendDice"}}</button>
    {{#if scene.dramatic}}<button type="button" data-action="dramaticOff">{{localize "SPYCRAFT.Template.AppsGcConsole.ReturnToAStandardScene"}}</button><button type="button" data-action="doubleInitiative">{{localize "SPYCRAFT.Template.AppsGcConsole.DoubleOpponentsInitiative"}}</button>{{else}}<button type="button" data-action="dramaticOn">{{localize "SPYCRAFT.Template.AppsGcConsole.ScriptedDramaticSceneNoCost"}}</button>{{/if}}</p>
  </details>
  <details class="gc-section" data-section="combat" data-state="{{sections.combat.state}}" {{#if sections.combat.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.Combat"}}</span>{{#if combat}}<span class="gc-note">{{localize "SPYCRAFT.Template.AppsGcConsole.Round"}} {{combat.round}}</span>{{/if}}</summary>
    {{#if combat}}<p>{{localize "SPYCRAFT.Template.AppsGcConsole.Round"}} {{combat.round}}{{#if combat.surprise}} {{localize "SPYCRAFT.Template.AppsGcConsole.SurpriseRound"}} {{combat.surprise.winners}} {{localize "SPYCRAFT.Template.AppsGcConsole.Act"}}{{/if}}</p>
    <p class="controls gc-turn-controls"><button type="button" data-action="previousTurn" {{#unless combat.started}}disabled{{/unless}}>{{localize "SPYCRAFT.Template.AppsGcConsole.PreviousTurn"}}</button><button type="button" class="gc-primary" data-action="nextTurn">{{#if combat.started}}{{localize "SPYCRAFT.Template.AppsGcConsole.NextTurn"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.BeginCombat"}}{{/if}}</button></p>
    <ul data-sc2-display="icon">{{#each combat.combatants}}<li{{#if current}} class="gc-current-turn" aria-current="true"{{/if}}{{#if defeated}} data-defeated="true"{{/if}}>{{name}} {{localize "SPYCRAFT.Template.AppsGcConsole.Count"}} {{count}}{{#if pending}} ({{pending}} {{localize "SPYCRAFT.Template.AppsGcConsole.Pending"}}{{/if}}{{#if mustPress}} {{localize "SPYCRAFT.Template.AppsGcConsole.MustPress"}}{{/if}}</li>{{/each}}</ul>{{else}}<p class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoActiveCombat"}}</p>{{/if}}
    <p class="controls"><button type="button" data-action="surprise">{{localize "SPYCRAFT.Template.AppsGcConsole.SurpriseRound2"}}</button><button type="button" class="gc-primary" data-action="groupInitiative" data-single="false">{{localize "SPYCRAFT.Template.AppsGcConsole.RollNPCInitiativeByType"}}</button><button type="button" data-action="groupInitiative" data-single="true">{{localize "SPYCRAFT.Template.AppsGcConsole.OneRollForAllNPCs"}}</button><button type="button" data-action="fluidEvent">{{localize "SPYCRAFT.Template.AppsGcConsole.FluidInitiativeEvent"}}</button><button type="button" data-action="combatReference">{{localize "SPYCRAFT.Template.AppsGcConsole.CombatReferences"}}</button></p>
  </details>
  <details class="gc-section" data-section="conflicts" data-state="{{sections.conflicts.state}}" {{#if sections.conflicts.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.DramaticConflicts"}}</span>{{#if counts.conflicts}}<span class="gc-note">{{counts.conflicts}}</span>{{/if}}</summary>
    <p class="controls"><button type="button" class="gc-primary" data-action="startConflict">{{localize "SPYCRAFT.Template.AppsGcConsole.Start"}}</button></p>
    <ul data-sc2-display="icon">{{#each conflicts}}<li><b>{{name}}</b> ({{type}}{{localize "SPYCRAFT.Template.AppsGcConsole.Round2"}} {{round}}{{localize "SPYCRAFT.Template.AppsGcConsole.Lead"}} <b>{{lead}}</b>, {{predator}} {{localize "SPYCRAFT.Template.AppsGcConsole.Vs"}} {{prey}} · {{#if winner}}{{localize "SPYCRAFT.Template.AppsGcConsole.Ended"}} {{winner}} {{localize "SPYCRAFT.Template.AppsGcConsole.Wins"}}{{else}}{{localize "SPYCRAFT.Template.AppsGcConsole.Step"}} {{step}}{{/if}}
    — {{#unless winner}}<button type="button" class="sc2-action" data-action="advanceConflict" data-id="{{id}}">{{localize "SPYCRAFT.Template.AppsGcConsole.NextStep"}}</button> · {{/unless}}<button type="button" class="sc2-action" data-action="manageConflict" data-id="{{id}}">{{localize "SPYCRAFT.Template.AppsGcConsole.Manage"}}</button></li>{{else}}<li class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoneRunning"}}</li>{{/each}}</ul>
  </details>
  <details class="gc-section" data-section="campaign" data-state="{{sections.campaign.state}}" {{#if sections.campaign.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.CampaignQualities"}}</span></summary>
    <p class="controls"><button type="button" class="gc-primary" data-action="seasonQualities">{{localize "SPYCRAFT.Template.AppsGcConsole.SeasonQualities"}}</button></p>
    <ul data-sc2-display="icon">{{#each season}}<li title="{{summary}}">{{name}} ({{xp}} {{localize "SPYCRAFT.Template.AppsGcConsole.XP3"}} {{summary}}</li>{{else}}<li class="muted">{{localize "SPYCRAFT.Template.AppsGcConsole.NoSeasonLongQualities"}}</li>{{/each}}</ul>
    {{#if effects.length}}<p>{{localize "SPYCRAFT.Template.AppsGcConsole.CombinedNumericEffects"}} {{#each effects}}{{key}} {{value}}{{#unless @last}}; {{/unless}}{{/each}}</p>{{/if}}
    {{#each effectConflicts}}<p class="bad">{{key}} {{localize "SPYCRAFT.Template.AppsGcConsole.IsSetDifferentlyBy"}} {{qualities}}{{localize "SPYCRAFT.Template.AppsGcConsole.GCRulingNeeded"}}</p>{{/each}}
  </details>
  <details class="gc-section" data-section="reference" data-state="{{sections.reference.state}}" {{#if sections.reference.open}}open{{/if}}>
    <summary><span class="gc-section-title">{{localize "SPYCRAFT.Template.AppsGcConsole.Reference"}}</span></summary>
    <p class="controls"><button type="button" data-action="securityDevice">{{localize "SPYCRAFT.Template.AppsGcConsole.SecurityDevice"}}</button><button type="button" data-action="hazards">{{localize "SPYCRAFT.Template.AppsGcConsole.HazardsNatureSFury"}}</button><button type="button" data-action="events">{{localize "SPYCRAFT.Template.AppsGcConsole.Events"}}</button><button type="button" data-action="possessions">{{localize "SPYCRAFT.Template.AppsGcConsole.RandomPossessions"}}</button></p>
  </details>
</section>
