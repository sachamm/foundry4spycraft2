<section class="item-details">
  <p class="muted">{{localize "SPYCRAFT.Template.ItemItemArmor.DRMeleeUnarmedAndNonGrenade"}}</p>
  {{#if armorTraining}}<p>{{localize "SPYCRAFT.Template.ItemItemArmor.ArmorTrainingWhenWornDefenseModifier"}} {{armorTraining.system.defensePenalty}}{{localize "SPYCRAFT.Template.ItemItemArmor.ACP"}} {{armorTraining.system.armorCheck}}{{localize "SPYCRAFT.Template.ItemItemArmor.SpeedModifier"}} {{armorTraining.system.speedPenalty}} {{localize "SPYCRAFT.Template.ItemItemArmor.FtNoticeSearch"}} {{armorTraining.system.notice}}{{localize "SPYCRAFT.Template.ItemItemArmor.AdditionalDRMeleeWeapons"}}{{armorTraining.benefits.meleeWeaponDR}}{{localize "SPYCRAFT.Template.ItemItemArmor.RangedWeapons"}}{{armorTraining.benefits.rangedWeaponDR}}{{localize "SPYCRAFT.Template.ItemItemArmor.MeleeRangedAttacks"}}{{armorTraining.benefits.meleeAttackDR}}{{localize "SPYCRAFT.Template.ItemItemArmor.MasteryDefense"}}{{armorTraining.benefits.defense}}{{localize "SPYCRAFT.Template.ItemItemArmor.SourceFieldsBelowRetainTheEquipment"}}</p>{{/if}}
  <p class="muted">{{localize "SPYCRAFT.Template.ItemItemArmor.NoticeSearchDCAppliesWhenProperly"}}</p>
  <div class="form-fields-grid">
    {{> "systems/spycraft2/templates/item/parts/possession-pick.hbs"}}
    <label>{{localize "SPYCRAFT.Template.ItemItemArmor.ArmorType"}} <input name="system.armorType" value="{{system.armorType}}" placeholder="{{localize 'SPYCRAFT.Template.ItemItemArmor.PMFOrMiscellaneous'}}" /></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemArmor.Slot"}} <input name="system.armorSlot" value="{{system.armorSlot}}" placeholder="{{localize 'SPYCRAFT.Template.ItemItemArmor.BodyHelmetShieldOrUniqueType'}}" /></label>
    <label><input type="checkbox" name="system.sealed" {{checked system.sealed}} /> {{localize "SPYCRAFT.Template.ItemItemArmor.SealedIncludesHelmet"}}</label>
    <label><input type="checkbox" name="system.visionPenalty" {{checked system.visionPenalty}} /> {{localize "SPYCRAFT.Template.ItemItemArmor.ACPAppliesToVisionInstead"}}</label>
    <label>{{localize "SPYCRAFT.Template.ItemItemArmor.DR"}} <input type="number" name="system.damageReduction" value="{{system.damageReduction}}" class="w-2" /> / <input type="number" name="system.damageReductionSubdual" value="{{system.damageReductionSubdual}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.ArmorField.Defense"}} <input type="number" name="system.defensePenalty" value="{{system.defensePenalty}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.ArmorField.Check"}} <input type="number" name="system.armorCheck" value="{{system.armorCheck}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Speed"}} <input type="number" name="system.speedPenalty" value="{{system.speedPenalty}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.ArmorField.Notice"}} <input type="text" name="system.notice" value="{{system.notice}}" class="w-4" /></label>
    <label class="wide">{{localize "SPYCRAFT.ArmorField.Resistances"}} <input type="text" name="system.resistances" value="{{system.resistances}}" placeholder="{{localize 'SPYCRAFT.Template.ItemItemArmor.AD4CD4CNAll'}}" /></label>
    <label>{{localize "SPYCRAFT.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Caliber"}} <select name="system.caliber" data-dtype="Number">{{selectOptions calibers selected=system.caliber}}</select></label>
    <label>{{localize "SPYCRAFT.Weight"}} <input type="number" step="any" name="system.weight" value="{{system.weight}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemArmor.CategoryForCHAPickValidation"}} <input name="system.gearCategory" value="{{system.gearCategory}}" placeholder="{{localize 'SPYCRAFT.Template.ItemItemArmor.EGRSTV'}}" /></label>
    {{#if system.pick}}<label>{{localize "SPYCRAFT.Template.ItemItemArmor.MissionPicksPaid"}} <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" class="w-2" /></label>{{/if}}
    {{#if system.armorMissionGrant}}<p>{{localize "SPYCRAFT.Template.ItemItemArmor.ArmorUseMissionArmorMission"}} {{system.armorMissionGrant.epoch}}{{localize "SPYCRAFT.Template.ItemItemArmor.NoOrdinaryMissionPickIsCharged"}}</p>{{/if}}
    {{#if system.missionCaliberGrant}}<p>{{localize "SPYCRAFT.Template.ItemItemArmor.MissionCaliberException"}} {{#if system.missionCaliberGrant.name}}{{system.missionCaliberGrant.name}}{{else}}{{localize "SPYCRAFT.Template.ItemItemArmor.RecordedHigherCaliberPick"}}{{/if}} {{localize "SPYCRAFT.Template.ItemItemArmor.Mission"}} {{system.missionCaliberGrant.epoch}}{{localize "SPYCRAFT.Template.ItemItemArmor.ItsOrdinaryMissionPickRemainsCharged"}}</p>{{/if}}
    <label>{{localize "SPYCRAFT.Template.ItemItemArmor.PersonalGearSource"}} <select name="system.possessionSource"><option value="" {{#unless system.possessionSource}}selected{{/unless}}>{{localize "SPYCRAFT.Template.ItemItemArmor.UnclassifiedNotAPossession"}}</option><option value="wealth" {{#if (sc2eq system.possessionSource "wealth")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemArmor.WealthPossessionsAllowance"}}</option><option value="gcGrant" {{#if (sc2eq system.possessionSource "gcGrant")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemArmor.AdditionalGCGrantedPossession"}}</option><option value="favoredGear" {{#if (sc2eq system.possessionSource "favoredGear")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemArmor.FavoredGearPossession"}}</option><option value="bugBasics" {{#if (sc2eq system.possessionSource "bugBasics")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemArmor.BugBasicsPossession"}}</option><option value="diseaseBasics" {{#if (sc2eq system.possessionSource "diseaseBasics")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemArmor.DiseaseBasicsPossession"}}</option><option value="poisonBasics" {{#if (sc2eq system.possessionSource "poisonBasics")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemArmor.PoisonBasicsPossession"}}</option><option value="superiorDocumentation" {{#if (sc2eq system.possessionSource "superiorDocumentation")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemArmor.SuperiorDocumentationPossession"}}</option></select></label>
    {{#if (sc2eq system.possessionSource "favoredGear")}}<label>{{localize "SPYCRAFT.Template.ItemItemArmor.SignatureGearLevel"}} <select name="system.signatureGear" data-dtype="Number"><option value="0" {{#unless system.signatureGear}}selected{{/unless}}>{{localize "SPYCRAFT.Template.ItemItemArmor.SignatureGearNone"}}</option><option value="1" {{#if (sc2eq system.signatureGear 1)}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemArmor.SignatureGearOne"}}</option><option value="2" {{#if (sc2eq system.signatureGear 2)}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemArmor.SignatureGearTwo"}}</option></select></label>{{/if}}
    {{#if system.possessionSource}}<label><input type="checkbox" name="system.possessionApproved" {{checked system.possessionApproved}} /> {{localize "SPYCRAFT.Template.ItemItemArmor.TheGCApprovedThisPossession"}}</label><label><input type="checkbox" name="system.cleanAndPolishedReady" {{checked system.cleanAndPolishedReady}} /> {{localize "SPYCRAFT.Template.ItemItemArmor.CleanAndPolishedIsMaintainedNo"}}</label>{{/if}}
    {{#if (sc2eq system.possessionSource "wealth")}}{{#unless system.pick}}<label>{{localize "SPYCRAFT.Template.ItemItemArmor.PossessionsPicksPaid"}} <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" /></label>{{/unless}}{{/if}}
    <label>{{localize "SPYCRAFT.Pick"}} <select name="system.pick">{{selectOptions pickOptions selected=system.pick}}</select></label>
    <label><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> {{localize "SPYCRAFT.Equipped"}}</label>
    <label><input type="checkbox" name="system.carried" {{checked system.carried}} /> {{localize "SPYCRAFT.Template.ItemItemArmor.Carried"}}</label>
    <label><input type="checkbox" name="system.reserve" {{checked system.reserve}} /> {{localize "SPYCRAFT.Reserve"}}</label>
    <label><input type="checkbox" name="system.common" {{checked system.common}} /> {{localize "SPYCRAFT.Template.ItemItemArmor.CommonItem"}}</label>
  </div>
  <h3>{{localize "SPYCRAFT.Description"}}</h3>
  {{> "systems/spycraft2/templates/parts/editor.hbs" field="system.description" value=system.description enriched=enrichedDescription}}
</section>
