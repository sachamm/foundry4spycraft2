<section class="item-details">
  <div class="form-fields-grid">
    <label>{{localize "SPYCRAFT.Feat.Tree"}} <select name="system.tree">{{selectOptions featTrees selected=system.tree blank="—"}}</select></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemFeat.Kind"}} <select name="system.featKind">{{selectOptions featKinds selected=system.featKind}}</select></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemFeat.ChoiceTarget"}} {{#if choiceOptions}}<select name="system.choice">{{selectOptions choiceOptions selected=system.choice blank="—"}}</select>{{else}}<input type="text" name="system.choice" value="{{system.choice}}" />{{/if}}</label>
    {{#if candidateBasis}}<p>{{localize "SPYCRAFT.Template.ItemItemFeat.CandidateOriginalFirstLevelScoresBefore"}} {{candidateBasis.scores.str}}{{localize "SPYCRAFT.Template.ItemItemFeat.DEX"}} {{candidateBasis.scores.dex}}{{localize "SPYCRAFT.Template.ItemItemFeat.CON"}} {{candidateBasis.scores.con}}{{localize "SPYCRAFT.Template.ItemItemFeat.INT"}} {{candidateBasis.scores.int}}{{localize "SPYCRAFT.Template.ItemItemFeat.WIS"}} {{candidateBasis.scores.wis}}{{localize "SPYCRAFT.Template.ItemItemFeat.CHA"}} {{candidateBasis.scores.cha}}{{localize "SPYCRAFT.Template.ItemItemFeat.RecordedPair"}} {{candidateBasis.choice}}.</p>{{/if}}
    {{#if candidateReview}}<p class="bad">{{candidateReview}}</p>{{/if}}{{#if canReviewCandidate}}<p><a data-action="reviewCandidate">{{localize "SPYCRAFT.Template.ItemItemFeat.GCReviewOriginalCandidateAttributesAnd"}}</a></p>{{/if}}
    {{#if contactFeatTheme}}<p>{{localize "SPYCRAFT.Template.ItemItemFeat.ChoiceTargetIdentifiesTheContactReceiving"}} {{contactFeatTheme}}{{localize "SPYCRAFT.Template.ItemItemFeat.UseAUniqueNameFromTraining"}}</p><label>{{localize "SPYCRAFT.Template.ItemItemFeat.Grant"}} <select name="system.contactGrantMode"><option value="associate" {{#if (sc2eq system.contactGrantMode "associate")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemFeat.NewAssociate2Grades"}}</option><option value="improve" {{#if (sc2eq system.contactGrantMode "improve")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemFeat.ImproveAnExistingContactBy1"}}</option></select></label><label>{{localize "SPYCRAFT.Template.ItemItemFeat.PrimaryContactSTheme"}} <input name="system.contactTheme" type="text" maxlength="200" value="{{system.contactTheme}}" /></label><label><input name="system.contactThemeConfirmed" type="checkbox" {{checked system.contactThemeConfirmed}} /> {{localize "SPYCRAFT.Template.ItemItemFeat.GCConfirmsTheChosenNewAssociate"}}</label>{{/if}}
    {{#if historicalReview}}<label><input type="checkbox" name="system.historicalPrerequisitesConfirmed" {{checked system.historicalPrerequisitesConfirmed}} /> {{localize "SPYCRAFT.Template.ItemItemFeat.GCConfirmedPrerequisiteEligibilityAtThe"}}</label>{{/if}}
    <label>{{localize "SPYCRAFT.Template.ItemItemFeat.BonusFeatSource"}} <select name="system.acquisitionSource">{{selectOptions acquisitionSources selected=system.acquisitionSource}}</select></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemFeat.CareerLevelAcquired"}} <input type="number" name="system.acquiredAtLevel" value="{{system.acquiredAtLevel}}" min="0" max="20" /></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemFeat.Restrictions"}} <input type="text" name="system.restrictions" value="{{system.restrictions}}" /></label>
    {{#if system.prerequisitesNotChecked}}<label><input type="checkbox" name="system.manualPrerequisitesConfirmed" {{checked system.manualPrerequisitesConfirmed}} /> {{localize "SPYCRAFT.Template.ItemItemFeat.GCConfirmedThePrerequisitesRequiringManual"}}</label>{{/if}}
    <label><input type="checkbox" name="system.granted" {{checked system.granted}} /> {{localize "SPYCRAFT.Feat.Granted"}}{{#if system.grantSource}} ({{system.grantSource}}){{/if}}</label>
  </div>
  <p><b>{{localize "SPYCRAFT.Feat.Prerequisites"}}:</b> {{prereqText}}
    {{#if system.prerequisitesNotChecked}}<span class="tag">{{localize "SPYCRAFT.Feat.NotChecked"}}</span>{{/if}}
    {{#if status}}{{#unless status.ok}}<span class="bad">({{#each status.unmet}}{{this}}{{#unless @last}}; {{/unless}}{{/each}})</span>{{/unless}}{{/if}}</p>
  <details><summary class="muted">{{localize "SPYCRAFT.Feat.EditPrereqs"}}</summary>
    <textarea name="prereqJSON" rows="6" class="mono">{{prereqJSON}}</textarea></details>
  {{#if trainingSkills}}<details><summary>{{localize "SPYCRAFT.Template.ItemItemFeat.TrainingSpend5PointsAtOne"}}</summary>
    <p>{{localize "SPYCRAFT.Template.ItemItemFeat.RecordThesePointsHereDoNot"}}</p>
    {{#each trainingSkills}}<label>{{name}} <input type="number" min="0" max="5" name="system.trainingSkills.{{key}}" value="{{points}}" class="w-2" /></label>{{/each}}
  </details>{{/if}}
  <fieldset class="feat-reminder">
    <legend>{{localize "SPYCRAFT.Template.ItemItemFeat.ReminderLegend"}}</legend>
    <p class="hint">{{localize "SPYCRAFT.Template.ItemItemFeat.ReminderHint"}}</p>
    <label>{{localize "SPYCRAFT.Template.ItemItemFeat.ReminderRolls"}} <input type="text" name="system.reminder.rolls" value="{{system.reminder.rolls}}" placeholder="attack, skill:sneak, save:will" /></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemFeat.ReminderText"}} <input type="text" name="system.reminder.text" value="{{system.reminder.text}}" /></label>
  </fieldset>
  <h3>{{localize "SPYCRAFT.Description"}}</h3>
  {{#if editable}}<prose-mirror name="system.description" value="{{system.description}}">{{{enrichedDescription}}}</prose-mirror>{{else}}{{{enrichedDescription}}}{{/if}}
  {{> "systems/spycraft2/templates/item/parts/bonuses.hbs"}}
</section>
