<section class="item-details">
  <div class="form-fields-grid">
    <label>{{localize "SPYCRAFT.Feat.Tree"}} <select name="system.tree">{{selectOptions featTrees selected=system.tree blank="—"}}</select></label>
    <label>Kind <select name="system.featKind">{{selectOptions featKinds selected=system.featKind}}</select></label>
    <label>Choice / target {{#if choiceOptions}}<select name="system.choice">{{selectOptions choiceOptions selected=system.choice blank="—"}}</select>{{else}}<input type="text" name="system.choice" value="{{system.choice}}" />{{/if}}</label>
    {{#if candidateBasis}}<p>Candidate: original first-level scores before this feat: STR {{candidateBasis.scores.str}}, DEX {{candidateBasis.scores.dex}}, CON {{candidateBasis.scores.con}}, INT {{candidateBasis.scores.int}}, WIS {{candidateBasis.scores.wis}}, CHA {{candidateBasis.scores.cha}}. Recorded pair: {{candidateBasis.choice}}.</p>{{/if}}
    {{#if candidateReview}}<p class="bad">{{candidateReview}}</p>{{/if}}{{#if canReviewCandidate}}<p><a data-action="reviewCandidate">GC review original Candidate attributes and choice</a></p>{{/if}}
    {{#if contactFeatTheme}}<p>Choice / target identifies the contact receiving this feat’s grant. Allowed theme: {{contactFeatTheme}}. Use a unique name from Training. The Contact-check benefits apply only to the person selected for this grant.</p><label>Grant <select name="system.contactGrantMode"><option value="associate" {{#if (sc2eq system.contactGrantMode "associate")}}selected{{/if}}>New associate (2 grades)</option><option value="improve" {{#if (sc2eq system.contactGrantMode "improve")}}selected{{/if}}>Improve an existing contact by 1 grade (Favored Contacts, p.144)</option></select></label><label>Primary contact’s theme <input name="system.contactTheme" type="text" maxlength="200" value="{{system.contactTheme}}" /></label><label><input name="system.contactThemeConfirmed" type="checkbox" {{checked system.contactThemeConfirmed}} /> GC confirms the chosen new-associate / existing-contact improvement and matching theme (reconfirm after changing the binding)</label>{{/if}}
    {{#if historicalReview}}<label><input type="checkbox" name="system.historicalPrerequisitesConfirmed" {{checked system.historicalPrerequisitesConfirmed}} /> GC confirmed prerequisite eligibility at the recorded acquisition level</label>{{/if}}
    <label>Bonus feat source <select name="system.acquisitionSource">{{selectOptions acquisitionSources selected=system.acquisitionSource}}</select></label>
    <label>Career level acquired <input type="number" name="system.acquiredAtLevel" value="{{system.acquiredAtLevel}}" min="0" max="20" /></label>
    <label>Restrictions <input type="text" name="system.restrictions" value="{{system.restrictions}}" /></label>
    {{#if system.prerequisitesNotChecked}}<label><input type="checkbox" name="system.manualPrerequisitesConfirmed" {{checked system.manualPrerequisitesConfirmed}} /> GC confirmed the prerequisites requiring manual validation</label>{{/if}}
    <label><input type="checkbox" name="system.granted" {{checked system.granted}} /> {{localize "SPYCRAFT.Feat.Granted"}}{{#if system.grantSource}} ({{system.grantSource}}){{/if}}</label>
  </div>
  <p><b>{{localize "SPYCRAFT.Feat.Prerequisites"}}:</b> {{prereqText}}
    {{#if system.prerequisitesNotChecked}}<span class="tag">{{localize "SPYCRAFT.Feat.NotChecked"}}</span>{{/if}}
    {{#if status}}{{#unless status.ok}}<span class="bad">({{#each status.unmet}}{{this}}{{#unless @last}}; {{/unless}}{{/each}})</span>{{/unless}}{{/if}}</p>
  <details><summary class="muted">{{localize "SPYCRAFT.Feat.EditPrereqs"}}</summary>
    <textarea name="prereqJSON" rows="6" class="mono">{{prereqJSON}}</textarea></details>
  {{#if trainingSkills}}<details><summary>Training: spend 5 points at one rank per point (p.201)</summary>
    <p>Record these points here; do not also spend them in a class level's pool. Acquisition-level maximum ranks still apply.</p>
    {{#each trainingSkills}}<label>{{name}} <input type="number" min="0" max="5" name="system.trainingSkills.{{key}}" value="{{points}}" class="w-2" /></label>{{/each}}
  </details>{{/if}}
  <h3>{{localize "SPYCRAFT.Description"}}</h3>
  {{#if editable}}<prose-mirror name="system.description" value="{{system.description}}">{{{enrichedDescription}}}</prose-mirror>{{else}}{{{enrichedDescription}}}{{/if}}
  {{> "systems/spycraft2/templates/item/parts/bonuses.hbs"}}
</section>
