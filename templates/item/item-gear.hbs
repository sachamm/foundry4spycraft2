<section class="item-details">
  <div class="form-fields-grid">
    {{> "systems/spycraft2/templates/item/parts/possession-pick.hbs"}}
    <label>{{localize "SPYCRAFT.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Caliber"}} <select name="system.caliber" data-dtype="Number">{{selectOptions calibers selected=system.caliber}}</select></label>
    {{#if system.kitGrade}}<p>{{system.kitType}} {{localize "SPYCRAFT.Template.ItemItemGear.Grade"}} {{system.kitGrade}} · {{system.kitSize}}</p>{{#if system.kitNonPortable}}<label>{{localize "SPYCRAFT.Template.ItemItemGear.NonPortableKitLocation"}} <input name="system.kitLocation" value="{{system.kitLocation}}" required /></label>{{/if}}{{/if}}
    {{#unless system.kitNonPortable}}<label>{{localize "SPYCRAFT.Weight"}} <input type="number" step="any" name="system.weight" value="{{system.weight}}" class="w-2" /></label>{{/unless}}
    <label>{{localize "SPYCRAFT.Template.ItemItemGear.CategoryForCHAPickValidation"}} <input name="system.gearCategory" value="{{system.gearCategory}}" placeholder="{{localize 'SPYCRAFT.Template.ItemItemGear.EGRSTV'}}" /></label>
    {{#if system.pick}}<label>{{localize "SPYCRAFT.Template.ItemItemGear.MissionPicksPaid"}} <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" class="w-2" /></label>{{/if}}
    {{#if system.missionCaliberGrant}}<p>{{localize "SPYCRAFT.Template.ItemItemGear.MissionCaliberException"}} {{#if system.missionCaliberGrant.name}}{{system.missionCaliberGrant.name}}{{else}}{{localize "SPYCRAFT.Template.ItemItemGear.RecordedHigherCaliberPick"}}{{/if}} {{localize "SPYCRAFT.Template.ItemItemGear.Mission"}} {{system.missionCaliberGrant.epoch}}{{localize "SPYCRAFT.Template.ItemItemGear.ItsOrdinaryMissionPickRemainsCharged"}}</p>{{/if}}
    {{#if system.classGearGrant}}<p>{{localize "SPYCRAFT.Template.ItemItemGear.ImprovisedCommonItemMission"}} {{system.classGearGrant.epoch}}{{localize "SPYCRAFT.Template.ItemItemGear.OneMissionUseWasSpentNo"}}</p>{{/if}}
    <label>{{localize "SPYCRAFT.Template.ItemItemGear.PersonalGearSource"}} <select name="system.possessionSource"><option value="" {{#unless system.possessionSource}}selected{{/unless}}>{{localize "SPYCRAFT.Template.ItemItemGear.UnclassifiedNotAPossession"}}</option><option value="wealth" {{#if (sc2eq system.possessionSource "wealth")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemGear.WealthPossessionsAllowance"}}</option><option value="gcGrant" {{#if (sc2eq system.possessionSource "gcGrant")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemGear.AdditionalGCGrantedPossession"}}</option><option value="favoredGear" {{#if (sc2eq system.possessionSource "favoredGear")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemGear.FavoredGearPossession"}}</option><option value="bugBasics" {{#if (sc2eq system.possessionSource "bugBasics")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemGear.BugBasicsPossession"}}</option><option value="diseaseBasics" {{#if (sc2eq system.possessionSource "diseaseBasics")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemGear.DiseaseBasicsPossession"}}</option><option value="poisonBasics" {{#if (sc2eq system.possessionSource "poisonBasics")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemGear.PoisonBasicsPossession"}}</option><option value="superiorDocumentation" {{#if (sc2eq system.possessionSource "superiorDocumentation")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemGear.SuperiorDocumentationPossession"}}</option></select></label>
    {{#if (sc2eq system.possessionSource "favoredGear")}}<label>{{localize "SPYCRAFT.Template.ItemItemGear.SignatureGearLevel"}} <select name="system.signatureGear" data-dtype="Number"><option value="0" {{#unless system.signatureGear}}selected{{/unless}}>{{localize "SPYCRAFT.Template.ItemItemGear.SignatureGearNone"}}</option><option value="1" {{#if (sc2eq system.signatureGear 1)}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemGear.SignatureGearOne"}}</option><option value="2" {{#if (sc2eq system.signatureGear 2)}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemGear.SignatureGearTwo"}}</option></select></label>{{/if}}
    {{#if system.possessionSource}}<label><input type="checkbox" name="system.possessionApproved" {{checked system.possessionApproved}} /> {{localize "SPYCRAFT.Template.ItemItemGear.TheGCApprovedThisPossession"}}</label><label><input type="checkbox" name="system.cleanAndPolishedReady" {{checked system.cleanAndPolishedReady}} /> {{localize "SPYCRAFT.Template.ItemItemGear.CleanAndPolishedIsMaintainedNo"}}</label>{{/if}}
    {{#if (sc2eq system.possessionSource "wealth")}}{{#unless system.pick}}<label>{{localize "SPYCRAFT.Template.ItemItemGear.PossessionsPicksPaid"}} <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" /></label>{{/unless}}{{/if}}
    <label>{{localize "SPYCRAFT.Pick"}} <select name="system.pick">{{selectOptions pickOptions selected=system.pick}}</select></label>
    <label><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> {{localize "SPYCRAFT.Equipped"}}</label>
    {{#unless system.kitNonPortable}}<label><input type="checkbox" name="system.carried" {{checked system.carried}} /> {{localize "SPYCRAFT.Template.ItemItemGear.Carried"}}</label>{{/unless}}
    <label><input type="checkbox" name="system.reserve" {{checked system.reserve}} /> {{localize "SPYCRAFT.Reserve"}}</label>
    <label><input type="checkbox" name="system.common" {{checked system.common}} /> {{localize "SPYCRAFT.Template.ItemItemGear.CommonItem"}}</label>
  </div>
  <details class="reference-panel" {{#if hasGearStats}}open{{/if}}>
    <summary>{{localize "SPYCRAFT.Template.ItemItemGear.TableValues"}}{{#if system.sourceTable}} — {{system.sourceTable}}{{/if}}</summary>
    {{#if system.optionOf}}<p class="muted">{{localize "SPYCRAFT.Template.ItemItemGear.OptionFor"}} {{system.optionOf}}.</p>{{/if}}
  {{#if standing}}<p class="muted">{{localize "SPYCRAFT.Template.ItemItemGear.RequestCost"}} {{standing.cost.reputation}} {{localize "SPYCRAFT.Template.ItemItemGear.ReputationOr"}} {{standing.netWorthLabel}} {{localize "SPYCRAFT.Template.ItemItemGear.NetWorth"}}{{#if standing.charge}} · <strong>{{localize "SPYCRAFT.Template.ItemItemGear.Paid"}}</strong> ({{standing.charge.amount}} {{standing.charge.currency}}){{/if}}{{#if standing.canCharge}} · <button type="button" class="sc2-action sc2-text-action" data-action="chargeStanding"><i class="fa-solid fa-coins" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ItemItemGear.PayTheCost"}}</button>{{/if}}{{#if standing.canRefund}} · <button type="button" class="sc2-action sc2-text-action" data-action="refundStanding"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ItemItemGear.Refund"}}</button>{{/if}}</p>{{/if}}
  {{#if system.footnotes.length}}<ul class="footnotes muted">{{#each system.footnotes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  {{#if system.bundled}}<p class="muted">{{localize "SPYCRAFT.Template.ItemItemGear.ComesWith"}} {{system.bundled}}</p>{{/if}}
  {{#if system.perTeamMember}}<p class="muted">{{localize "SPYCRAFT.Template.ItemItemGear.IssuedToEveryTeamMember"}}{{#if canIssueTeam}} · <button type="button" class="sc2-action sc2-text-action" data-action="issueToTeam"><i class="fa-solid fa-users" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ItemItemGear.IssueToTheTeam"}}</button>{{/if}}</p>{{/if}}
    <div class="form-fields-grid">
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.PowerRating"}} <input name="system.powerRating" value="{{system.powerRating}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.ResultCap"}} <input name="system.resultCap" value="{{system.resultCap}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.Range"}} <input name="system.effectRange" value="{{system.effectRange}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.SizeHands"}} <input name="system.sizeHands" value="{{system.sizeHands}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.Battery"}} <input name="system.battery" value="{{system.battery}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.DamageSave"}} <input name="system.damageSave" type="number" value="{{system.damageSave}}" class="w-2" /></label>
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.Complexity"}} <input name="system.complexity" value="{{system.complexity}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.Year"}} <input name="system.year" value="{{system.year}}" /></label>
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.StreetValue"}} <input name="system.streetValue" value="{{system.streetValue}}" /></label>
      <label><input type="checkbox" name="system.restricted" {{checked system.restricted}} /> {{localize "SPYCRAFT.Template.ItemItemGear.RestrictedSale"}}</label>
      <label>{{localize "SPYCRAFT.Template.ItemItemGear.ReputationNetWorthCost"}} <input name="system.standingCost" value="{{system.standingCost}}" /></label>
      <label><input type="checkbox" name="system.standingOnly" {{checked system.standingOnly}} /> {{localize "SPYCRAFT.Template.ItemItemGear.ReputationNetWorthOnly"}}</label>
    </div>
    {{#if system.stats.length}}<table class="items"><tbody>{{#each system.stats}}<tr><th>{{label}}</th><td>{{value}}</td></tr>{{/each}}</tbody></table>{{/if}}
    {{#if hasDamageSave}}<p>
      <button type="button" class="sc2-action sc2-text-action" data-action="damageSave"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ItemItemGear.DamageSave"}}</button>
      {{localize "SPYCRAFT.Template.ItemItemGear.FailedSaves"}} <input name="system.failedSaves" type="number" min="0" value="{{system.failedSaves}}" class="w-2" />
      · <strong class="{{#unless (sc2eq breakState.state 'intact')}}bad{{/unless}}">{{breakState.state}}</strong>
      {{#if repair}}· <button type="button" class="sc2-action sc2-text-action" data-action="repair"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ItemItemGear.Repair"}}</button> <span class="muted">({{repair.skillKey}} {{localize "SPYCRAFT.Template.ItemItemGear.VsDC"}} {{repair.dc}})</span>{{/if}}
    </p>{{/if}}
    {{#if battery}}<p>
      {{localize "SPYCRAFT.Template.ItemItemGear.Battery2"}} <strong class="{{#if battery.dry}}bad{{/if}}">{{#if battery.dry}}{{localize "SPYCRAFT.Template.ItemItemGear.Dry"}}{{else}}{{battery.remainingLabel}} {{localize "SPYCRAFT.Template.ItemItemGear.Of"}} {{battery.capacity}} {{battery.unit}} {{localize "SPYCRAFT.Template.ItemItemGear.Left"}}{{/if}}</strong>{{#if battery.depleted}}{{#unless battery.dry}} <span class="bad">{{localize "SPYCRAFT.Template.ItemItemGear.PastBatteryLife"}}{{battery.depletedUses}} {{localize "SPYCRAFT.Template.ItemItemGear.UsesSince"}}</span>{{/unless}}{{/if}}
      · <button type="button" class="sc2-action sc2-text-action" data-action="useBattery"><i class="fa-solid fa-battery-half" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ItemItemGear.Use"}}</button> · <button type="button" class="sc2-action sc2-text-action" data-action="recharge"><i class="fa-solid fa-plug" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ItemItemGear.Recharge"}}</button>
    </p>{{/if}}
    {{#if hasSignal}}<p><button type="button" class="sc2-action sc2-text-action" data-action="signal"><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ItemItemGear.SignalReceptionDC"}}</button> <span class="muted">{{localize "SPYCRAFT.Template.ItemItemGear.PR"}} {{system.powerRating}}, {{system.effectRange}} {{localize "SPYCRAFT.Template.ItemItemGear.Increments"}}</span></p>{{/if}}
  </details>
  {{#if gadget.canHouse}}<details class="reference-panel gadget-drop" {{#if gadget.mechanisms.length}}open{{/if}}>
    <summary>{{localize "SPYCRAFT.Template.ItemItemGear.Gadget"}}{{#if gadget.mechanisms.length}} — {{gadget.count}} {{localize "SPYCRAFT.Template.ItemItemGear.Of"}} {{gadget.max}} {{localize "SPYCRAFT.Template.ItemItemGear.Mechanisms"}}{{/if}}</summary>
    <p><label>{{localize "SPYCRAFT.Template.ItemItemGear.HousingSize"}} <select name="system.gadget.housingSize">{{selectOptions housingOptions selected=system.gadget.housingSize}}</select></label>
      {{#if gadget.valid}}{{localize "SPYCRAFT.Template.ItemItemGear.UpTo"}} {{gadget.max}} {{localize "SPYCRAFT.Template.ItemItemGear.Mechanism"}}{{#unless (sc2eq gadget.max 1)}}s{{/unless}} {{localize "SPYCRAFT.Template.ItemItemGear.KnowledgeDC"}} {{gadget.knowledgeDC}} {{localize "SPYCRAFT.Template.ItemItemGear.DamageSave2"}} {{signed gadget.damageSave}}{{#if gadget.complexity}} {{localize "SPYCRAFT.Template.ItemItemGear.Complexity2"}} {{gadget.complexity}}{{/if}}{{/if}}</p>
    {{#if gadget.mechanisms.length}}<table class="items"><tbody>{{#each gadget.mechanisms}}<tr><td>{{name}}{{#if skill}} ({{skill}}){{/if}}</td><td>{{localize "SPYCRAFT.Template.ItemItemGear.PR2"}} {{powerRating}}</td><td>{{complexity}}</td>
      <td>{{#if skillCheck}}<button type="button" class="sc2-action sc2-text-action" data-action="gadgetSkill" data-index="{{index}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i> {{localize "SPYCRAFT.Template.ItemItemGear.Roll"}}</button>{{/if}}</td>
      <td><button type="button" class="sc2-action sc2-text-action" data-action="removeMechanism" data-index="{{index}}" aria-label="{{localize 'SPYCRAFT.Action.RemoveNamed' name=name}}" data-tooltip="{{localize 'SPYCRAFT.Action.RemoveNamed' name=name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></td></tr>{{/each}}</tbody></table>{{/if}}
    <p class="muted">{{localize "SPYCRAFT.Template.ItemItemGear.DropGadgetMechanismsGearPackGadgets"}}</p>
  </details>{{/if}}
  <h3>{{localize "SPYCRAFT.Description"}}</h3>
  {{> "systems/spycraft2/templates/parts/editor.hbs" field="system.description" value=system.description enriched=enrichedDescription}}
</section>
