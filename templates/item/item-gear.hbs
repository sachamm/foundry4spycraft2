<section class="item-details">
  <div class="form-fields-grid">
    <label>{{localize "SPYCRAFT.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Caliber"}} <select name="system.caliber" data-dtype="Number">{{selectOptions calibers selected=system.caliber}}</select></label>
    {{#if system.kitGrade}}<p>{{system.kitType}} · Grade {{system.kitGrade}} · {{system.kitSize}}</p>{{#if system.kitNonPortable}}<label>Non-portable kit location <input name="system.kitLocation" value="{{system.kitLocation}}" required /></label>{{/if}}{{/if}}
    {{#unless system.kitNonPortable}}<label>{{localize "SPYCRAFT.Weight"}} <input type="number" step="any" name="system.weight" value="{{system.weight}}" class="w-2" /></label>{{/unless}}
    <label>Category (for CHA pick validation) <input name="system.gearCategory" value="{{system.gearCategory}}" placeholder="E/G/R/S/T/V/W" /></label>
    {{#if system.pick}}<label>Mission picks paid <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" class="w-2" /></label>{{/if}}
    {{#if system.missionCaliberGrant}}<p>Mission-Caliber exception: {{#if system.missionCaliberGrant.name}}{{system.missionCaliberGrant.name}}{{else}}Recorded higher-Caliber pick{{/if}} · mission {{system.missionCaliberGrant.epoch}}. Its ordinary mission pick remains charged.</p>{{/if}}
    {{#if system.classGearGrant}}<p>Improvised Common Item · mission {{system.classGearGrant.epoch}}. One mission use was spent; no ordinary Common Item or reserve was charged.</p>{{/if}}
    <label>Personal gear source <select name="system.possessionSource"><option value="" {{#unless system.possessionSource}}selected{{/unless}}>Unclassified / not a Possession</option><option value="wealth" {{#if (sc2eq system.possessionSource "wealth")}}selected{{/if}}>Wealth Possessions allowance</option><option value="gcGrant" {{#if (sc2eq system.possessionSource "gcGrant")}}selected{{/if}}>Additional GC-granted Possession</option></select></label>
    {{#if system.possessionSource}}<label><input type="checkbox" name="system.possessionApproved" {{checked system.possessionApproved}} /> The GC approved this Possession</label><label><input type="checkbox" name="system.cleanAndPolishedReady" {{checked system.cleanAndPolishedReady}} /> Clean and Polished is maintained: no absence from my person over 24 hours since the last hour of cleaning/readjustment</label>{{/if}}
    {{#if (sc2eq system.possessionSource "wealth")}}{{#unless system.pick}}<label>Possessions picks paid <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" /></label>{{/unless}}{{/if}}
    <label>{{localize "SPYCRAFT.Pick"}} <select name="system.pick">{{selectOptions pickOptions selected=system.pick}}</select></label>
    <label><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> {{localize "SPYCRAFT.Equipped"}}</label>
    {{#unless system.kitNonPortable}}<label><input type="checkbox" name="system.carried" {{checked system.carried}} /> Carried</label>{{/unless}}
    <label><input type="checkbox" name="system.reserve" {{checked system.reserve}} /> {{localize "SPYCRAFT.Reserve"}}</label>
    <label><input type="checkbox" name="system.common" {{checked system.common}} /> Common Item</label>
  </div>
  <details class="reference-panel" {{#if hasGearStats}}open{{/if}}>
    <summary>Table values{{#if system.sourceTable}} — {{system.sourceTable}}{{/if}}</summary>
    {{#if system.optionOf}}<p class="muted">Option for {{system.optionOf}}.</p>{{/if}}
  {{#if standing}}<p class="muted">Request cost: {{standing.cost.reputation}} Reputation or {{standing.netWorthLabel}} Net Worth{{#if standing.charge}} · <strong>paid</strong> ({{standing.charge.amount}} {{standing.charge.currency}}){{/if}}{{#if standing.canCharge}} · <a data-action="chargeStanding"><i class="fa-solid fa-coins"></i> Pay the cost</a>{{/if}}{{#if standing.canRefund}} · <a data-action="refundStanding"><i class="fa-solid fa-rotate-left"></i> Refund</a>{{/if}}</p>{{/if}}
  {{#if system.footnotes.length}}<ul class="footnotes muted">{{#each system.footnotes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  {{#if system.bundled}}<p class="muted">Comes with: {{system.bundled}}</p>{{/if}}
  {{#if system.perTeamMember}}<p class="muted">Issued to every team member{{#if canIssueTeam}} · <a data-action="issueToTeam"><i class="fa-solid fa-users"></i> Issue to the team</a>{{/if}}</p>{{/if}}
    <div class="form-fields-grid">
      <label>Power Rating <input name="system.powerRating" value="{{system.powerRating}}" /></label>
      <label>Result cap <input name="system.resultCap" value="{{system.resultCap}}" /></label>
      <label>Range <input name="system.effectRange" value="{{system.effectRange}}" /></label>
      <label>Size/Hands <input name="system.sizeHands" value="{{system.sizeHands}}" /></label>
      <label>Battery <input name="system.battery" value="{{system.battery}}" /></label>
      <label>Damage save <input name="system.damageSave" type="number" value="{{system.damageSave}}" class="w-2" /></label>
      <label>Complexity <input name="system.complexity" value="{{system.complexity}}" /></label>
      <label>Year <input name="system.year" value="{{system.year}}" /></label>
      <label>Street value <input name="system.streetValue" value="{{system.streetValue}}" /></label>
      <label><input type="checkbox" name="system.restricted" {{checked system.restricted}} /> Restricted sale</label>
      <label>Reputation/Net Worth cost <input name="system.standingCost" value="{{system.standingCost}}" /></label>
      <label><input type="checkbox" name="system.standingOnly" {{checked system.standingOnly}} /> Reputation/Net Worth only</label>
    </div>
    {{#if system.stats.length}}<table class="items"><tbody>{{#each system.stats}}<tr><th>{{label}}</th><td>{{value}}</td></tr>{{/each}}</tbody></table>{{/if}}
    {{#if hasDamageSave}}<p>
      <a data-action="damageSave"><i class="fa-solid fa-shield-halved"></i> Damage save</a>
      · failed saves <input name="system.failedSaves" type="number" min="0" value="{{system.failedSaves}}" class="w-2" />
      · <strong class="{{#unless (sc2eq breakState.state 'intact')}}bad{{/unless}}">{{breakState.state}}</strong>
      {{#if repair}}· <a data-action="repair"><i class="fa-solid fa-screwdriver-wrench"></i> Repair</a> <span class="muted">({{repair.skillKey}} vs DC {{repair.dc}})</span>{{/if}}
    </p>{{/if}}
    {{#if battery}}<p>
      Battery: <strong class="{{#if battery.dry}}bad{{/if}}">{{#if battery.dry}}dry{{else}}{{battery.remainingLabel}} of {{battery.capacity}} {{battery.unit}} left{{/if}}</strong>{{#if battery.depleted}}{{#unless battery.dry}} <span class="bad">past battery life ({{battery.depletedUses}} uses since)</span>{{/unless}}{{/if}}
      · <a data-action="useBattery"><i class="fa-solid fa-battery-half"></i> Use</a> · <a data-action="recharge"><i class="fa-solid fa-plug"></i> Recharge</a>
    </p>{{/if}}
    {{#if hasSignal}}<p><a data-action="signal"><i class="fa-solid fa-tower-broadcast"></i> Signal reception DC</a> <span class="muted">(PR {{system.powerRating}}, {{system.effectRange}} increments)</span></p>{{/if}}
  </details>
  {{#if gadget.canHouse}}<details class="reference-panel gadget-drop" {{#if gadget.mechanisms.length}}open{{/if}}>
    <summary>Gadget{{#if gadget.mechanisms.length}} — {{gadget.count}} of {{gadget.max}} mechanisms{{/if}}</summary>
    <p><label>Housing Size <select name="system.gadget.housingSize">{{selectOptions housingOptions selected=system.gadget.housingSize}}</select></label>
      {{#if gadget.valid}}· up to {{gadget.max}} mechanism{{#unless (sc2eq gadget.max 1)}}s{{/unless}} · Knowledge DC {{gadget.knowledgeDC}} · Damage save {{signed gadget.damageSave}}{{#if gadget.complexity}} · Complexity {{gadget.complexity}}{{/if}}{{/if}}</p>
    {{#if gadget.mechanisms.length}}<table class="items"><tbody>{{#each gadget.mechanisms}}<tr><td>{{name}}{{#if skill}} ({{skill}}){{/if}}</td><td>PR {{powerRating}}</td><td>{{complexity}}</td>
      <td>{{#if skillCheck}}<a data-action="gadgetSkill" data-index="{{index}}"><i class="fa-solid fa-dice-d20"></i> Roll</a>{{/if}}</td>
      <td><a data-action="removeMechanism" data-index="{{index}}" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></a></td></tr>{{/each}}</tbody></table>{{/if}}
    <p class="muted">Drop gadget mechanisms (Gear pack, Gadgets) here; each costs one Gadget pick. The GC approves every gadget.</p>
  </details>{{/if}}
  <h3>{{localize "SPYCRAFT.Description"}}</h3>
  {{#if editable}}<prose-mirror name="system.description" value="{{system.description}}">{{{enrichedDescription}}}</prose-mirror>{{else}}{{{enrichedDescription}}}{{/if}}
</section>
