<header class="sheet-header">
  <img class="portrait" src="{{item.img}}" data-edit="img" data-action="editImage" alt="{{item.name}}" />
  <div class="header-main">
    <input class="name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'Name'}}" />
    <div class="summary muted">{{localize (concat "TYPES.Item." item.type)}}
      <label>{{localize "SPYCRAFT.Source"}} <input type="text" name="system.source" value="{{system.source}}" /></label>
      <a data-action="toChat" data-tooltip="SPYCRAFT.ToChat"><i class="fa-solid fa-comment"></i></a></div>
  </div>
</header>
