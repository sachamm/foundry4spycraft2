<div class="sheet-top">
<div class="dossier-band" aria-hidden="true">
  <span class="file-label">{{localize "SPYCRAFT.Retro.EquipmentFile"}}</span>
  <span class="file-stamp">{{localize "SPYCRAFT.Retro.Classified"}}</span>
</div>
<header class="sheet-header">
  <img class="portrait" src="{{item.img}}" data-edit="img" data-action="editImage" alt="{{item.name}}" />
  <div class="header-main">
    <input class="name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'Name'}}" aria-label="{{localize 'Name'}}" />
    <div class="summary muted">{{localize (concat "TYPES.Item." item.type)}}
      <label>{{localize "SPYCRAFT.Source"}} <input type="text" name="system.source" value="{{system.source}}" /></label>
      <button type="button" class="sc2-action" data-action="toChat" data-sc2-display="icon" aria-label="{{localize 'SPYCRAFT.ToChat'}}" data-tooltip="{{localize 'SPYCRAFT.ToChat'}}"><i class="fa-solid fa-comment" aria-hidden="true"></i></button></div>
  </div>
</header>
{{#if summary.length}}<div class="item-summary">{{#each summary}}<div class="sc2-field"><span class="sc2-caption">{{caption}}</span><b class="sc2-value">{{value}}</b></div>{{/each}}</div>{{/if}}
</div>
