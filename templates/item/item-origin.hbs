<section class="item-details">
  <div class="form-fields-grid">
    <label>{{localize "SPYCRAFT.Origin.Type"}} <select name="system.originType">{{selectOptions originTypes selected=system.originType}}</select></label>
    <label>{{localize "SPYCRAFT.Origin.Grants"}} <input type="text" name="grantsText" value="{{grantsText}}" /></label>
  </div>
  <h3>{{localize "SPYCRAFT.Description"}}</h3>
  {{> "systems/spycraft2/templates/parts/editor.hbs" field="system.description" value=system.description enriched=enrichedDescription}}
  {{> "systems/spycraft2/templates/item/parts/bonuses.hbs"}}
</section>
