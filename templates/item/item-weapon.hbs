<section class="item-details">
  <div class="form-fields-grid">
    <label>{{localize "SPYCRAFT.Proficiency"}} <select name="system.proficiency">{{selectOptions proficiencies selected=system.proficiency}}</select></label>
    <label><input type="checkbox" name="system.improvised" {{checked system.improvised}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.ImprovisedWeapon"}}</label>
    <label><input type="checkbox" name="system.destroyed" {{checked system.destroyed}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.Destroyed"}}</label>
    <label>{{localize "SPYCRAFT.Template.ItemItemWeapon.GCReviewedMeleeFamily"}} <select name="system.meleeFamily">{{selectOptions meleeFamilies selected=system.meleeFamily}}</select></label>
    <p class="wide">{{localize "SPYCRAFT.Template.ItemItemWeapon.ConfirmTheActualWeaponFamilyWith"}}</p>
    <label>{{localize "SPYCRAFT.Template.ItemItemWeapon.Grip"}} <select name="system.useHands" data-dtype="Number">{{selectOptions gripOptions selected=system.useHands}}</select></label>
    <label><input type="checkbox" name="system.grantFinesse" {{checked system.grantFinesse}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.GrantFINUsingFinesseBasicsOne"}}</label>
    <label><input type="checkbox" name="system.useFinesse" {{checked system.useFinesse}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.UseFinesseDamageFINQualityAnd"}}</label>
    <label><input type="checkbox" name="system.ammunitionOnly" {{checked system.ammunitionOnly}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.AmmunitionStockpileOnly"}}</label>
    {{#if system.ammunitionOnly}}<p class="wide">{{system.stockpileSize}} {{localize "SPYCRAFT.Template.ItemItemWeapon.ShotsPerStockpile"}} {{system.shotWeight}} {{localize "SPYCRAFT.Template.ItemItemWeapon.LbsPerShotCost"}} {{system.upgradeCost}} {{localize "SPYCRAFT.Template.ItemItemWeapon.UpgradesOr"}} {{system.commonItemCost}} {{localize "SPYCRAFT.Template.ItemItemWeapon.CommonItemsNoIndependentAttackOr"}}</p><label>{{localize "SPYCRAFT.Template.ItemItemWeapon.AmmunitionKind"}} <select name="system.ammunitionKind"><option value="arrow" {{#if (sc2eq system.ammunitionKind "arrow")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.Arrows"}}</option><option value="bolt" {{#if (sc2eq system.ammunitionKind "bolt")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.Bolts"}}</option></select></label>{{/if}}
    {{#if usesProjectiles}}<label class="wide">{{localize "SPYCRAFT.Template.ItemItemWeapon.LoadedProjectileStockpile"}} <select name="system.loadedAmmoId">{{selectOptions ammunitionOptions selected=system.loadedAmmoId}}</select></label>{{/if}}
    {{#if system.ammunitionOnly}}<label><input type="checkbox" name="system.explosiveAmmunition" {{checked system.explosiveAmmunition}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.ExplosiveDamageNoStrengthBonus"}}</label>{{/if}}
    <label><input type="checkbox" name="system.noStrengthDamage" {{checked system.noStrengthDamage}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.NoStrengthModifierToDamageDart"}}</label>
    <label>{{localize "SPYCRAFT.Damage"}} <input type="text" name="system.damage" value="{{system.damage}}" /></label>
    <label>{{localize "SPYCRAFT.Weapon.Error"}} <input type="number" name="system.error" value="{{system.error}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Weapon.Threat"}} <input type="number" name="system.threat" value="{{system.threat}}" class="w-2" /></label>
    {{#unless system.ammunitionOnly}}<label>{{localize "SPYCRAFT.Template.ItemItemWeapon.AdditionalUpgradesBlankUnspecified"}} <input type="number" min="0" step="1" name="system.upgradeAllowance" value="{{system.upgradeAllowance}}" /></label>{{/unless}}
    <label>{{localize "SPYCRAFT.Weapon.Ammo"}} <input type="text" name="system.ammo" value="{{system.ammo}}" /></label>
    {{#if ammunitionConfiguration.applicable}}<div class="wide">{{#if ammunitionConfiguration.options.length}}<label>{{localize "SPYCRAFT.Template.ItemItemWeapon.SuppliedAmmunitionConfiguration"}} <select name="system.ammoCodeChoice">{{selectOptions ammunitionCodeOptions selected=ammunitionConfiguration.selectedCode blank="Choose one supplied code"}}</select></label>{{/if}}{{#if ammunitionConfiguration.selected}}<p>{{localize "SPYCRAFT.Template.ItemItemWeapon.PrintedStockpile"}} {{ammunitionConfiguration.selected.shots}} {{localize "SPYCRAFT.Template.ItemItemWeapon.Shots"}}{{ammunitionConfiguration.selected.loads}} × {{ammunitionConfiguration.selected.capacity}} {{localize "SPYCRAFT.Template.ItemItemWeapon.RoundsAmmunitionInventoryIsTrackedSeparately"}}</p>{{/if}}{{#if ammunitionConfiguration.reason}}<p class="bad">{{ammunitionConfiguration.reason}}</p>{{/if}}</div>{{/if}}
    <label>{{localize "SPYCRAFT.Template.ItemItemWeapon.ProjectileCaliberModel"}} <input name="system.ammoChamber" value="{{system.ammoChamber}}" placeholder="{{localize 'SPYCRAFT.Template.ItemItemWeapon.37mmCarlGustavRPG7BS'}}" /></label>
    {{#if canPlanAmmunition}}<p class="wide"><a data-action="planAmmunition">{{localize "SPYCRAFT.Template.ItemItemWeapon.CalculateAmmunitionStockpileCostAndWeight"}}</a></p>{{/if}}
    {{#if (sc2eq system.weaponCategory "mortar")}}<label><input name="system.disassembled" type="checkbox" {{checked system.disassembled}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.DisassembledCannotFire"}}</label>{{#if system.assemblyHalfActions}}<p class="wide">{{localize "SPYCRAFT.Template.ItemItemWeapon.AssemblyAndDisassemblyEachRequire"}} {{system.assemblyHalfActions}} {{localize "SPYCRAFT.Template.ItemItemWeapon.HalfActionsRecordTheCompletedOperation"}}</p>{{/if}}{{/if}}
    <label>{{localize "SPYCRAFT.Template.ItemItemWeapon.WeaponCategory"}} <select name="system.weaponCategory">{{selectOptions firearmCategories selected=system.weaponCategory}}</select></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemWeapon.FiringMountRequirement"}} <select name="system.mountRequirement"><option value="" {{#unless system.mountRequirement}}selected{{/unless}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.None"}}</option><option value="underbarrel" {{#if (sc2eq system.mountRequirement "underbarrel")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.CompatibleRifleUnderbarrel"}}</option><option value="optionalUnderbarrel" {{#if (sc2eq system.mountRequirement "optionalUnderbarrel")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.StandaloneUnderbarrelVersions"}}</option><option value="tripodOrVehicle" {{#if (sc2eq system.mountRequirement "tripodOrVehicle")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.IntegralTripodVehicle"}}</option></select></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemWeapon.CurrentFireMode"}} <select name="system.fireMode">{{selectOptions fireModeOptions selected=system.fireMode}}</select></label>
    {{#if hasCollapsibleStock}}<label><input type="checkbox" name="system.stockExtended" {{checked system.stockExtended}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.StockExtendedCLSRecoil2Observers"}}</label>{{/if}}
    <label>{{localize "SPYCRAFT.Weapon.Recoil"}} <input type="number" name="system.recoil" value="{{system.recoil}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Range"}} <input type="number" step="any" name="system.range" value="{{system.range}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemWeapon.BaseMaximumRangeIncrements0Category"}} <input type="number" min="0" name="system.maxRangeIncrements" value="{{system.maxRangeIncrements}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Weapon.SizeHands"}} <input type="text" name="system.sizeHands" value="{{system.sizeHands}}" class="w-4" /></label>
    <label>{{localize "SPYCRAFT.Weapon.UntrainedPenalty"}} <input type="number" name="system.untrainedPenalty" value="{{system.untrainedPenalty}}" class="w-2" /></label>
    <label class="wide">{{localize "SPYCRAFT.Weapon.Qualities"}} <input type="text" name="system.qualities" value="{{system.qualities}}" /></label>
    {{#unless system.ammunitionOnly}}<p class="wide">{{localize "SPYCRAFT.Template.ItemItemWeapon.BaseQuantityPerMissionPick"}} {{system.bundleSize}}{{localize "SPYCRAFT.Template.ItemItemWeapon.ConsumingItemsDoesNotRefundThe"}}</p>{{/unless}}
    <label>{{#if system.ammunitionOnly}}{{localize "SPYCRAFT.Template.ItemItemWeapon.Stockpiles"}}{{else}}{{localize "SPYCRAFT.Quantity"}}{{/if}} <input type="number" name="system.quantity" value="{{system.quantity}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Caliber"}} <select name="system.caliber" data-dtype="Number">{{selectOptions calibers selected=system.caliber}}</select></label>
    <label>{{localize "SPYCRAFT.Weight"}} <input type="number" step="any" name="system.weight" value="{{system.weight}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Template.ItemItemWeapon.CategoryForCHAPickValidation"}} <input name="system.gearCategory" value="{{system.gearCategory}}" placeholder="{{localize 'SPYCRAFT.Template.ItemItemWeapon.EGRSTV'}}" /></label>
    {{#if system.pick}}<label>{{localize "SPYCRAFT.Template.ItemItemWeapon.MissionPicksPaid"}} <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" class="w-2" /></label>{{/if}}
    {{#if system.bigStickMissionPick}}<p>{{localize "SPYCRAFT.Template.ItemItemWeapon.BigStickMissionWeaponMission"}} {{system.bigStickMissionPick.epoch}}{{localize "SPYCRAFT.Template.ItemItemWeapon.ItsOrdinaryMissionPickIsStill"}}</p>{{/if}}
    {{#if system.missionCaliberGrant}}<p>{{localize "SPYCRAFT.Template.ItemItemWeapon.MissionCaliberException"}} {{#if system.missionCaliberGrant.name}}{{system.missionCaliberGrant.name}}{{else}}{{localize "SPYCRAFT.Template.ItemItemWeapon.RecordedHigherCaliberPick"}}{{/if}} {{localize "SPYCRAFT.Template.ItemItemWeapon.Mission"}} {{system.missionCaliberGrant.epoch}}{{localize "SPYCRAFT.Template.ItemItemWeapon.ItsOrdinaryMissionPickRemainsCharged"}}</p>{{/if}}
    <label>{{localize "SPYCRAFT.Template.ItemItemWeapon.PersonalGearSource"}} <select name="system.possessionSource"><option value="" {{#unless system.possessionSource}}selected{{/unless}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.UnclassifiedNotAPossession"}}</option><option value="wealth" {{#if (sc2eq system.possessionSource "wealth")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.WealthPossessionsAllowance"}}</option><option value="gcGrant" {{#if (sc2eq system.possessionSource "gcGrant")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.AdditionalGCGrantedPossession"}}</option><option value="favoredGear" {{#if (sc2eq system.possessionSource "favoredGear")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.FavoredGearPossession"}}</option><option value="bugBasics" {{#if (sc2eq system.possessionSource "bugBasics")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.BugBasicsPossession"}}</option><option value="diseaseBasics" {{#if (sc2eq system.possessionSource "diseaseBasics")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.DiseaseBasicsPossession"}}</option><option value="poisonBasics" {{#if (sc2eq system.possessionSource "poisonBasics")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.PoisonBasicsPossession"}}</option><option value="superiorDocumentation" {{#if (sc2eq system.possessionSource "superiorDocumentation")}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.SuperiorDocumentationPossession"}}</option></select></label>
    {{#if (sc2eq system.possessionSource "favoredGear")}}<label>{{localize "SPYCRAFT.Template.ItemItemWeapon.SignatureGearLevel"}} <select name="system.signatureGear" data-dtype="Number"><option value="0" {{#unless system.signatureGear}}selected{{/unless}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.SignatureGearNone"}}</option><option value="1" {{#if (sc2eq system.signatureGear 1)}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.SignatureGearOne"}}</option><option value="2" {{#if (sc2eq system.signatureGear 2)}}selected{{/if}}>{{localize "SPYCRAFT.Template.ItemItemWeapon.SignatureGearTwo"}}</option></select></label>{{/if}}
    {{#if system.possessionSource}}<label><input type="checkbox" name="system.possessionApproved" {{checked system.possessionApproved}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.TheGCApprovedThisPossession"}}</label><label><input type="checkbox" name="system.cleanAndPolishedReady" {{checked system.cleanAndPolishedReady}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.CleanAndPolishedIsMaintainedNo"}}</label>{{/if}}
    {{#if (sc2eq system.possessionSource "wealth")}}{{#unless system.pick}}<label>{{localize "SPYCRAFT.Template.ItemItemWeapon.PossessionsPicksPaid"}} <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" /></label>{{/unless}}{{/if}}
    <label>{{localize "SPYCRAFT.Pick"}} <select name="system.pick">{{selectOptions pickOptions selected=system.pick}}</select></label>
    <label><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> {{localize "SPYCRAFT.Equipped"}}</label>
    <label><input type="checkbox" name="system.carried" {{checked system.carried}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.Carried"}}</label>
    <label><input type="checkbox" name="system.reserve" {{checked system.reserve}} /> {{localize "SPYCRAFT.Reserve"}}</label>
    <label><input type="checkbox" name="system.common" {{checked system.common}} /> {{localize "SPYCRAFT.Template.ItemItemWeapon.CommonItem"}}</label>
  </div>
  <h3>{{localize "SPYCRAFT.Description"}}</h3>
  {{#if editable}}<prose-mirror name="system.description" value="{{system.description}}">{{{enrichedDescription}}}</prose-mirror>{{else}}{{{enrichedDescription}}}{{/if}}
</section>
