<section class="item-details">
  <div class="form-fields-grid">
    <label>{{localize "SPYCRAFT.Proficiency"}} <select name="system.proficiency">{{selectOptions proficiencies selected=system.proficiency}}</select></label>
    <label><input type="checkbox" name="system.improvised" {{checked system.improvised}} /> Improvised weapon</label>
    <label><input type="checkbox" name="system.destroyed" {{checked system.destroyed}} /> Destroyed</label>
    <label>GC-reviewed melee family <select name="system.meleeFamily">{{selectOptions meleeFamilies selected=system.meleeFamily}}</select></label>
    <p class="wide">Confirm the actual weapon family with the GC for readied-weapon feat benefits (pp.176,179–180). The weapon must also be available, equipped, carried and held with a legal grip. Its display name does not assign a family.</p>
    <label>Grip <select name="system.useHands" data-dtype="Number">{{selectOptions gripOptions selected=system.useHands}}</select></label>
    <label><input type="checkbox" name="system.grantFinesse" {{checked system.grantFinesse}} /> Grant FIN using Finesse Basics (one-handed melee weapon)</label>
    <label><input type="checkbox" name="system.useFinesse" {{checked system.useFinesse}} /> Use finesse damage (FIN quality and trained use required)</label>
    <label><input type="checkbox" name="system.ammunitionOnly" {{checked system.ammunitionOnly}} /> Ammunition stockpile only</label>
    {{#if system.ammunitionOnly}}<p class="wide">{{system.stockpileSize}} shots per stockpile · {{system.shotWeight}} lbs. per shot · Cost: {{system.upgradeCost}} upgrades or {{system.commonItemCost}} Common Items. No independent attack or weapon pick.</p><label>Ammunition kind <select name="system.ammunitionKind"><option value="arrow" {{#if (sc2eq system.ammunitionKind "arrow")}}selected{{/if}}>Arrows</option><option value="bolt" {{#if (sc2eq system.ammunitionKind "bolt")}}selected{{/if}}>Bolts</option></select></label>{{/if}}
    {{#if usesProjectiles}}<label class="wide">Loaded projectile stockpile <select name="system.loadedAmmoId">{{selectOptions ammunitionOptions selected=system.loadedAmmoId}}</select></label>{{/if}}
    {{#if system.ammunitionOnly}}<label><input type="checkbox" name="system.explosiveAmmunition" {{checked system.explosiveAmmunition}} /> Explosive damage (no Strength bonus)</label>{{/if}}
    <label><input type="checkbox" name="system.noStrengthDamage" {{checked system.noStrengthDamage}} /> No Strength modifier to damage (Dart / Shuriken)</label>
    <label>{{localize "SPYCRAFT.Damage"}} <input type="text" name="system.damage" value="{{system.damage}}" /></label>
    <label>{{localize "SPYCRAFT.Weapon.Error"}} <input type="number" name="system.error" value="{{system.error}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Weapon.Threat"}} <input type="number" name="system.threat" value="{{system.threat}}" class="w-2" /></label>
    {{#unless system.ammunitionOnly}}<label>Additional upgrades (blank = unspecified) <input type="number" min="0" step="1" name="system.upgradeAllowance" value="{{system.upgradeAllowance}}" /></label>{{/unless}}
    <label>{{localize "SPYCRAFT.Weapon.Ammo"}} <input type="text" name="system.ammo" value="{{system.ammo}}" /></label>
    {{#if ammunitionConfiguration.applicable}}<div class="wide">{{#if ammunitionConfiguration.options.length}}<label>Supplied ammunition configuration <select name="system.ammoCodeChoice">{{selectOptions ammunitionCodeOptions selected=ammunitionConfiguration.selectedCode blank="Choose one supplied code"}}</select></label>{{/if}}{{#if ammunitionConfiguration.selected}}<p>Printed stockpile: {{ammunitionConfiguration.selected.shots}} shots ({{ammunitionConfiguration.selected.loads}} × {{ammunitionConfiguration.selected.capacity}} rounds). Ammunition inventory is tracked separately.</p>{{/if}}{{#if ammunitionConfiguration.reason}}<p class="bad">{{ammunitionConfiguration.reason}}</p>{{/if}}</div>{{/if}}
    <label>Projectile caliber/model <input name="system.ammoChamber" value="{{system.ammoChamber}}" placeholder="37mm / Carl Gustav / RPG-7 / BS-1" /></label>
    {{#if canPlanAmmunition}}<p class="wide"><a data-action="planAmmunition">Calculate ammunition stockpile cost and weight</a></p>{{/if}}
    {{#if (sc2eq system.weaponCategory "mortar")}}<label><input name="system.disassembled" type="checkbox" {{checked system.disassembled}} /> Disassembled (cannot fire)</label>{{#if system.assemblyHalfActions}}<p class="wide">Assembly and disassembly each require {{system.assemblyHalfActions}} half actions. Record the completed operation before changing this state.</p>{{/if}}{{/if}}
    <label>Weapon category <select name="system.weaponCategory">{{selectOptions firearmCategories selected=system.weaponCategory}}</select></label>
    <label>Firing mount requirement <select name="system.mountRequirement"><option value="" {{#unless system.mountRequirement}}selected{{/unless}}>None</option><option value="underbarrel" {{#if (sc2eq system.mountRequirement "underbarrel")}}selected{{/if}}>Compatible rifle underbarrel</option><option value="optionalUnderbarrel" {{#if (sc2eq system.mountRequirement "optionalUnderbarrel")}}selected{{/if}}>Standalone / underbarrel versions</option><option value="tripodOrVehicle" {{#if (sc2eq system.mountRequirement "tripodOrVehicle")}}selected{{/if}}>Integral tripod / vehicle</option></select></label>
    <label>Current fire mode <select name="system.fireMode">{{selectOptions fireModeOptions selected=system.fireMode}}</select></label>
    {{#if hasCollapsibleStock}}<label><input type="checkbox" name="system.stockExtended" {{checked system.stockExtended}} /> Stock extended (CLS): recoil –2; observers +2 Notice/Search</label>{{/if}}
    <label>{{localize "SPYCRAFT.Weapon.Recoil"}} <input type="number" name="system.recoil" value="{{system.recoil}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Range"}} <input type="number" step="any" name="system.range" value="{{system.range}}" class="w-2" /></label>
    <label>Base maximum range increments (0 = category) <input type="number" min="0" name="system.maxRangeIncrements" value="{{system.maxRangeIncrements}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Weapon.SizeHands"}} <input type="text" name="system.sizeHands" value="{{system.sizeHands}}" class="w-4" /></label>
    <label>{{localize "SPYCRAFT.Weapon.UntrainedPenalty"}} <input type="number" name="system.untrainedPenalty" value="{{system.untrainedPenalty}}" class="w-2" /></label>
    <label class="wide">{{localize "SPYCRAFT.Weapon.Qualities"}} <input type="text" name="system.qualities" value="{{system.qualities}}" /></label>
    {{#unless system.ammunitionOnly}}<p class="wide">Base quantity per mission pick: {{system.bundleSize}}. Consuming items does not refund the pick.</p>{{/unless}}
    <label>{{#if system.ammunitionOnly}}Stockpiles{{else}}{{localize "SPYCRAFT.Quantity"}}{{/if}} <input type="number" name="system.quantity" value="{{system.quantity}}" class="w-2" /></label>
    <label>{{localize "SPYCRAFT.Caliber"}} <select name="system.caliber" data-dtype="Number">{{selectOptions calibers selected=system.caliber}}</select></label>
    <label>{{localize "SPYCRAFT.Weight"}} <input type="number" step="any" name="system.weight" value="{{system.weight}}" class="w-2" /></label>
    <label>Category (for CHA pick validation) <input name="system.gearCategory" value="{{system.gearCategory}}" placeholder="E/G/R/S/T/V/W" /></label>
    {{#if system.pick}}<label>Mission picks paid <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" class="w-2" /></label>{{/if}}
    {{#if system.bigStickMissionPick}}<p>Big Stick mission weapon · mission {{system.bigStickMissionPick.epoch}}. Its ordinary mission pick is still charged.</p>{{/if}}
    {{#if system.missionCaliberGrant}}<p>Mission-Caliber exception: {{#if system.missionCaliberGrant.name}}{{system.missionCaliberGrant.name}}{{else}}Recorded higher-Caliber pick{{/if}} · mission {{system.missionCaliberGrant.epoch}}. Its ordinary mission pick remains charged.</p>{{/if}}
    <label>Personal gear source <select name="system.possessionSource"><option value="" {{#unless system.possessionSource}}selected{{/unless}}>Unclassified / not a Possession</option><option value="wealth" {{#if (sc2eq system.possessionSource "wealth")}}selected{{/if}}>Wealth Possessions allowance</option><option value="gcGrant" {{#if (sc2eq system.possessionSource "gcGrant")}}selected{{/if}}>Additional GC-granted Possession</option></select></label>
    {{#if system.possessionSource}}<label><input type="checkbox" name="system.possessionApproved" {{checked system.possessionApproved}} /> The GC approved this Possession</label><label><input type="checkbox" name="system.cleanAndPolishedReady" {{checked system.cleanAndPolishedReady}} /> Clean and Polished is maintained: no absence from my person over 24 hours since the last hour of cleaning/readjustment</label>{{/if}}
    {{#if (sc2eq system.possessionSource "wealth")}}{{#unless system.pick}}<label>Possessions picks paid <input type="number" min="1" name="system.pickCount" value="{{system.pickCount}}" /></label>{{/unless}}{{/if}}
    <label>{{localize "SPYCRAFT.Pick"}} <select name="system.pick">{{selectOptions pickOptions selected=system.pick}}</select></label>
    <label><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> {{localize "SPYCRAFT.Equipped"}}</label>
    <label><input type="checkbox" name="system.carried" {{checked system.carried}} /> Carried</label>
    <label><input type="checkbox" name="system.reserve" {{checked system.reserve}} /> {{localize "SPYCRAFT.Reserve"}}</label>
    <label><input type="checkbox" name="system.common" {{checked system.common}} /> Common Item</label>
  </div>
  <h3>{{localize "SPYCRAFT.Description"}}</h3>
  {{#if editable}}<prose-mirror name="system.description" value="{{system.description}}">{{{enrichedDescription}}}</prose-mirror>{{else}}{{{enrichedDescription}}}{{/if}}
</section>
