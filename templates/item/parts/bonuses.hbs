<h3>{{localize "SPYCRAFT.Bonuses"}} {{#if editable}}<span class="controls"><button type="button" class="sc2-action" data-action="addBonus" aria-label="{{localize 'SPYCRAFT.Action.AddBonus'}}" data-tooltip="{{localize 'SPYCRAFT.Action.AddBonus'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button></span>{{/if}}</h3>
<table class="bonuses">
  <thead><tr><th>{{localize "SPYCRAFT.Bonus.Target"}}</th><th>{{localize "SPYCRAFT.Bonus.Value"}}</th>{{#if showLevel}}<th>{{localize "SPYCRAFT.Level"}}</th>{{/if}}<th></th></tr></thead>
  <tbody>
  {{#each bonuses}}
    <tr>
      <td><input type="text" name="bonuses.{{index}}.target" value="{{target}}" list="{{@root.appId}}-bonus-targets" data-tooltip="{{label}}" /></td>
      <td><input type="text" name="bonuses.{{index}}.value" value="{{value}}" /></td>
      {{#if ../showLevel}}<td><input type="number" name="bonuses.{{index}}.level" value="{{level}}" class="w-2" /></td>{{/if}}
      <td>{{#if ../editable}}<button type="button" class="sc2-action sc2-text-action" data-action="removeBonus" data-index="{{index}}" aria-label="{{localize 'SPYCRAFT.Action.RemoveBonus'}}" data-tooltip="{{localize 'SPYCRAFT.Action.RemoveBonus'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</td>
    </tr>
  {{else}}<tr><td colspan="4" class="muted">{{localize "SPYCRAFT.Bonus.None"}}</td></tr>{{/each}}
  </tbody>
</table>
<datalist id="{{@root.appId}}-bonus-targets">{{#each bonusTargets}}<option value="{{@key}}">{{this}}</option>{{/each}}</datalist>
<p class="hint muted">{{localize "SPYCRAFT.Bonus.Hint"}}</p>
